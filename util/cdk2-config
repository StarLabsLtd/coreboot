#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
set -eu

config=${1:?usage: cdk2-config COREBOOT_CONFIG OUTPUT}
output=${2:?usage: cdk2-config COREBOOT_CONFIG OUTPUT}
tmp="${output}.tmp"

enabled=$(sed -n 's/^CONFIG_PAYLOAD_CDK2_CAPSULE_UPDATE_PROFILE=//p' "$config")
guid=$(sed -n 's/^CONFIG_DRIVERS_EFI_MAIN_FW_GUID="\(.*\)"/\1/p' "$config")
if [ "$enabled" = y ]; then
	[ -n "$guid" ] || {
		echo 'CDK2 capsule profile requires CONFIG_DRIVERS_EFI_MAIN_FW_GUID' >&2
		exit 1
	}
	printf '%s\n' "$guid" | grep -Eq \
		'^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$' || {
		echo 'CDK2 capsule profile requires a canonical firmware GUID' >&2
		exit 1
	}
	lower_guid=$(printf '%s' "$guid" | tr '[:upper:]' '[:lower:]')
	[ "$lower_guid" != 00000000-0000-0000-0000-000000000000 ] || {
		echo 'CDK2 capsule profile requires a non-nil firmware GUID' >&2
		exit 1
	}
	[ "$lower_guid" != ffffffff-ffff-ffff-ffff-ffffffffffff ] || {
		echo 'CDK2 capsule profile requires a non-max firmware GUID' >&2
		exit 1
	}
	[ "$lower_guid" != 00112233-4455-6677-8899-aabbccddeeff ] || {
		echo 'CDK2 capsule profile requires a board-specific firmware GUID' >&2
		exit 1
	}

	{
		echo 'CONFIG_CDK2_PAYLOAD=y'
		echo 'CONFIG_CDK2_COREBOOT_CAPSULE_PROFILE=y'
		printf 'CONFIG_CDK2_CAPSULE_MAIN_FW_GUID="%s"\n' "$guid"
	} > "$tmp"
else
	echo 'CONFIG_CDK2_PAYLOAD=y' > "$tmp"
fi
mv "$tmp" "$output"
