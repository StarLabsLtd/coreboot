# NOTE: Use CONSOLE for SMM debugging
FLASH 8M {
	SI_ALL 2M {
		SI_DESC 0x1000
		SI_ME 0x1ff000
	}
	SI_BIOS 6M {
		EC 0x20000
		RW_MRC_CACHE 0x10000
		# Keep SMMSTORE 64k-aligned for compatibility with 64 KiB block overrides
		SMMSTORE 0x40000
		CONSOLE 0x20000
		FMAP 0x200
		COREBOOT(CBFS) 0x56fe00
	}
}
