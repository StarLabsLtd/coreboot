#
# Manually defined FMD in order to ensure that space is reserved for the EC
# at the top of the BIOS region.
#
FLASH 16M {
	BIOS@0x400000 0xC00000 {
		EC@0x0 0x20000
		RW_MRC_CACHE@0x20000 0x10000
		SMMSTORE@0x30000 0x80000
		CONSOLE@0xB0000 0x20000
		FMAP@0xD0000 0x200
		COREBOOT(CBFS)@0xD1000 0x577000
		COREBOOT_B(CBFS)@0x648000 0x577000
		BOOTBLOCK@0xBC0000 0x40000
	}
}
