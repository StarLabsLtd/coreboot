	string
	default "3rdparty/blobs/mainboard/\$(MAINBOARDDIR)/\$(CONFIG_VARIANT_DIR)/ec.bin" if \
		BOARD_STARLABS_ADL_SERIES || BOARD_STARLABS_CEZANNE_SERIES || \
		BOARD_STARLABS_STARBOOK_SERIES || BOARD_STARLABS_STARFIGHTER_SERIES

if BOARD_STARLABS_ADL_SERIES || BOARD_STARLABS_STARBOOK_SERIES || \
	BOARD_STARLABS_STARFIGHTER_SERIES

config DIMM_SPD_SIZE
	default 1024 if BOARD_STARLABS_STARBOOK_MTL
	default 512

config FMDFILE
	default "src/mainboard/\$(CONFIG_MAINBOARD_DIR)/variants/\$(CONFIG_VARIANT_DIR)/vboot.fmd" if VBOOT
	default "src/mainboard/\$(CONFIG_MAINBOARD_DIR)/variants/\$(CONFIG_VARIANT_DIR)/board.fmd"

config IFD_BIN_PATH
	string
	default "3rdparty/blobs/mainboard/\$(MAINBOARDDIR)/\$(CONFIG_VARIANT_DIR)/flashdescriptor.bin"

config ME_BIN_PATH
	string
	default "3rdparty/blobs/mainboard/\$(MAINBOARDDIR)/\$(CONFIG_VARIANT_DIR)/intel_me.bin"

config POWER_STATE_DEFAULT_ON_AFTER_FAILURE
	default n

config SOC_INTEL_CSE_SEND_EOP_EARLY
	default n

config USE_PM_ACPI_TIMER
	default n

endif

config STARLABS_MEMORY_SETTINGS_VERSION
	bool
	default y if PLATFORM_USES_FSP2_0 && CACHE_MRC_SETTINGS
	select FSP_PLATFORM_MEMORY_SETTINGS_VERSIONS

menu "Star Labs Settings"

config DAVE_MODE
	bool "Enable DAVE mode"
	select SECURITY_FAIL_CLOSED
	help
	  DAVE mode is the secure, locked-down variant.

config BOOTMEDIA_SMM_BWP
	bool
	default y if SOC_INTEL_COMMON_BLOCK_SMM

config BOOTMEDIA_SMM_BWP_RUNTIME_OPTION
	bool
	default y if SOC_INTEL_COMMON_BLOCK_SMM

config USE_LEGACY_8254_TIMER
	default n if VENDOR_STARLABS

config STARLABS_HAS_I8042_INPUT
	bool
	default y if SYSTEM_TYPE_LAPTOP || SYSTEM_TYPE_DETACHABLE


config DRIVERS_EFI_CAPSULE_REGIONS
	default "FW_MAIN_A RW_FWID_A VBLOCK_A FW_MAIN_B RW_FWID_B VBLOCK_B" if VBOOT_SLOTS_RW_AB && STARLABS_VBOOT_RELEASE_POLICY
	default "EC RW_NVRAM FW_MAIN_A RW_FWID_A VBLOCK_A" if VBOOT && STARLABS_VBOOT_RELEASE_POLICY
	default "COREBOOT EC" if BOARD_STARLABS_ADL_HORIZON || \
		BOARD_STARLABS_STARBOOK_RPL_U || BOARD_STARLABS_STARFIGHTER_MTL

config STARLABS_NO_PCAT_8259
	bool
	default y if BOARD_STARLABS_BYTE_ADL || BOARD_STARLABS_BYTE_TWL
	select NO_PCAT_8259

