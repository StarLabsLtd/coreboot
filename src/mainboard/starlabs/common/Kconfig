	bool

config STARLABS_TOUCHPAD
	bool
	depends on DRIVERS_I2C_HID

config STARLABS_TOUCHPAD_RUNTIME
	def_bool STARLABS_TOUCHPAD && STARLABS_SMM_OPTION_HANDLER && \
		SOC_INTEL_COMMON_BLOCK_I2C_SMM && USE_UEFI_VARIABLE_STORE

config STARLABS_TOUCHPAD_CONTROLLER
	string

config STARLABS_TOUCHPAD_PIXART
	def_bool STARLABS_TOUCHPAD_CONTROLLER = "pixart"
	select STARLABS_TOUCHPAD

