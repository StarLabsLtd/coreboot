	bool
	default y if VENDOR_STARLABS

config DRIVERS_EFI_FW_INFO
	def_bool y

config STARLABS_COMMON_POWERCAP
	bool
	default y if SOC_INTEL_COMMON_BLOCK_POWER_LIMIT

