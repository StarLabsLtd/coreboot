	bool
	default y if CPU_INTEL_COMMON

config SOC_INTEL_COMMON_ACPI_TIME_ALARM
	default y if SOC_INTEL_COMMON_BLOCK_SMM_HAS_WADT

config SOC_INTEL_COMMON_ACPI_TIME_ALARM_S5
	default y if SOC_INTEL_COMMON_ACPI_TIME_ALARM

config STARLABS_AUTOMATIC_START
	def_bool y
	depends on DRIVERS_OPTION_CFR
	depends on SOC_INTEL_COMMON_BLOCK_PMC
	depends on EC_STARLABS_ADAPTER_AUTO_POWER_ON

