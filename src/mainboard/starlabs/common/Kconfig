		BMP_LOGO_FILE_NAME = "\$(obj)/starlabs-logo.bmp"

config EDK2_BOOTSPLASH_SOURCE_SCALE
	default 2 if EDK2_BOOTSPLASH_FILE = "3rdparty/blobs/mainboard/starlabs/Logo-HiDPI.bmp"

