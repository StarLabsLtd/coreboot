FLASH	0x2000000 {
	SI_ALL	0x1000000 {
		SI_DESC			0x1000
		SI_ME			0x508000
	}
	SI_BIOS 0x1000000 {
		EC@0x0			0x20000
		RW_MRC_CACHE@0x20000	0x10000
		SMMSTORE@0x30000	0x80000
		CONSOLE@0xB0000		0x20000
#if CONFIG_DAVE_MODE
