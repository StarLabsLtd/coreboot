config DRIVERS_OPTION_CFR_ENABLED
	def_bool n

config DRIVERS_OPTION_CFR
	bool "Support generating a CFR list of options"
	select DRIVERS_EFI_VARIABLE_STORE if PAYLOAD_MM_INTERFACE || (PAYLOAD_EDK2 && SMMSTORE)
	default y if DRIVERS_OPTION_CFR_ENABLED

config HAVE_CFR_RUNTIME_APPLY_SUPPORT
	bool

config DRIVERS_OPTION_CFR_RUNTIME_APPLY
	bool
	depends on ARCH_X86
	depends on DRIVERS_OPTION_CFR
	depends on HAVE_SMI_HANDLER
	depends on HAVE_CFR_RUNTIME_APPLY_SUPPORT
