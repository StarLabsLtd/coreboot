config DRIVERS_OPTION_CFR_ENABLED
	def_bool n

config DRIVERS_OPTION_CFR
	bool "Support generating a CFR list of options"
	select DRIVERS_EFI_VARIABLE_STORE if PAYLOAD_MM_INTERFACE || (PAYLOAD_EDK2 && SMMSTORE)
	default y if DRIVERS_OPTION_CFR_ENABLED

config DRIVERS_OPTION_CFR_RUNTIME_APPLY
	bool
	depends on ARCH_X86
	depends on DRIVERS_OPTION_CFR
	depends on HAVE_SMI_HANDLER
	depends on SOC_INTEL_COMMON_BLOCK_SMM || SOC_AMD_COMMON_BLOCK_SMIHANDLER
	help
	  Expose a fixed coreboot-owned CBMEM mailbox for reading and updating
	  explicitly allowlisted CFR numeric options. Boards must provide a
	  policy that maps stable tokens to CFR objects. The default policy is
	  empty and rejects every request.

config DRIVERS_OPTION_CFR_SMM_SUPPORTED
	def_bool SOC_INTEL_COMMON_BLOCK_SMM
