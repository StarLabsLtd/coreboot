config HAVE_PAYLOAD_MM_INTERFACE
	def_bool n
	help
	  Selected by platforms that have implemented support for payload MM.

config PAYLOAD_MM_INTERFACE
	bool "Support coreboot-mediated payload MM"
	depends on HAVE_SMI_HANDLER
	depends on HAVE_PAYLOAD_MM_INTERFACE
	depends on SOC_INTEL_COMMON_BLOCK_FAST_SPI
	# Needed by `smmstore_lookup_region` helper function to EFIVARS option system.
	select SPI_FLASH_SMM if BOOT_DEVICE_SPI_FLASH_RW_NOMMAP
	default n
	help
	  Implements coreboot-to-payload compatibility layers for sharing SMM. coreboot will
	  continue to initialise and own SMM. Payload can register to be called on SMI too.
	  An example use-case is enabling EDK2 Secure Boot with Authenticated Variables.

	  Select N if unsure.

config PAYLOAD_MM_SMRAM_SIZE
	hex
	depends on PAYLOAD_MM_INTERFACE
	default 0x400000
	help
	  Reserve space for the MM core, variable and FTW drivers, their flash
	  buffers and the authenticated-variable crypto libraries. The platform
	  must also leave room for coreboot's SMM handler and resume cache.

# Initialise size of reused "SMMSTORE" FMAP region for native SPI services
config SMMSTORE_SIZE
	depends on !SMMSTORE && PAYLOAD_MM_INTERFACE
	default 0x40000

config SMMSTORE_BLOCK_SIZE
	int
	depends on !SMMSTORE && PAYLOAD_MM_INTERFACE
	default 65536
