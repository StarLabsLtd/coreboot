config ASS
	bool "Authorised SMM Service (ASS)"
	depends on HAVE_SMI_HANDLER
	depends on SMM_TSEG
	depends on SMMSTORE
	depends on DRIVERS_EFI_VARIABLE_STORE
	depends on !PAYLOAD_EDK2 || EDK2_REPO_CUSTOM
	depends on (SOC_INTEL_COMMON_BLOCK_SMM && SOC_INTEL_COMMON_BLOCK_FAST_SPI && \
		ARCH_SMM_X86_32) || \
		(SOC_AMD_COMMON_BLOCK_SMM && SOC_AMD_PHOENIX_OPENSIL && ARCH_SMM_X86_64 && \
		SOC_AMD_COMMON_BLOCK_PSP_ROM_ARMOR3 && SOC_AMD_COMMON_BLOCK_PSP_DF_LOCK && \
		SOC_AMD_COMMON_BLOCK_PSP_SMM_LOCK && !SOC_AMD_COMMON_LATE_SMM_LOCKING && \
		!HAVE_ACPI_RESUME && !VBOOT_SLOTS_RW_AB && !PSP_AB_RECOVERY)
	depends on !CONSOLE_SPI_FLASH
	select SPI_FLASH_SMM if BOOT_DEVICE_SPI_FLASH_RW_NOMMAP
	help
	  ASS stands for Authorised SMM Service. Run the build-selected EFI
	  variable and capsule service in a fixed SMRAM region. The payload can
	  submit requests through a bounded shared buffer, but cannot supply
	  executable code or choose the service address.
	  Phoenix openSIL and edIIe use the native coreboot service. Other
	  configurations use a build-pinned Standalone MM service.

if ASS

config ASS_NATIVE
	def_bool PAYLOAD_EDIIE || SOC_AMD_PHOENIX_OPENSIL

if !ASS_NATIVE

config ASS_SERVICE_REPOSITORY
	string "Fixed MM service source repository"
	default "https://github.com/StarLabsLtd/edk2"

config ASS_SERVICE_REVISION
	string "Fixed MM service source revision"
	default "a3a0792c9554d8fbe0c25aebd6e83cecff0f127d"

endif

endif

# Keep the decompressed FV out of the S3-cached ramstage image.
config HEAP_SIZE
	default SMM_ASS_SIZE if ASS
