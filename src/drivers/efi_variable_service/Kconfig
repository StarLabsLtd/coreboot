config EFI_VARIABLE_SERVICE
	bool "Fixed EFI authenticated-variable service"
	depends on HAVE_SMI_HANDLER
	depends on SMM_TSEG
	depends on SMMSTORE
	depends on ARCH_SMM_X86_32
	depends on PAYLOAD_EDK2
	depends on EDK2_REPO_CUSTOM
	depends on SOC_INTEL_COMMON_BLOCK_SMM
	depends on SOC_INTEL_COMMON_BLOCK_FAST_SPI
	depends on !DRIVERS_EFI_UPDATE_CAPSULES || SMMSTORE_BLOCK_SIZE = 65536
	depends on !CONSOLE_SPI_FLASH
	select BOOTMEDIA_SMM_BWP
	select SPI_FLASH_SMM if BOOT_DEVICE_SPI_FLASH_RW_NOMMAP
	help
	  Load a build-selected authenticated-variable service into a fixed
	  SMRAM region. The payload can submit requests through a bounded shared
	  buffer, but cannot supply executable code or choose the service address.
	  The selected EDK2 repository must provide
	  fixed Standalone MM service description.
