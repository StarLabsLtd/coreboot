	default "3rdparty/blobs/mainboard/\$(MAINBOARDDIR)/low_battery_alt.bmp"

endif # PLATFORM_HAS_SECONDARY_BOOT_INDICATOR_LOGO
endif # PLATFORM_HAS_LOW_BATTERY_INDICATOR

