config MISSING_BOARD_RESET
	bool
	help
	  Selected by boards that don't provide a do_board_reset()
	  implementation. This activates a stub that logs the missing
	  board reset and halts execution.

config PAYLOAD_RESOURCE_HANDOFF
	bool "Publish assigned PCI resources to the payload"
	default n
	depends on PCI && ECAM_MMCONF_SUPPORT
	help
	  Serialize PCI root topology and exact coreboot-assigned resources for
	  payloads that consume the resource handoff. Revision 3 remains the safe
	  default; boards with a trustworthy PCI tree and boot-controller policy
	  may opt in to revision 4 topology and boot-intent sections. Before the
	  record is published, bus mastering is disabled and verified for every
	  serialized function. A platform must explicitly provide trustworthy
	  revision-4 topology and boot-controller policy before that revision is
	  published.

config PAYLOAD_DMA_HANDOFF
	bool
	depends on PAYLOAD_RESOURCE_HANDOFF
	help
	  Publish a versioned reference to a bounded, platform-prepared DMA
	  protection description. The record is rejected unless a platform
	  revision-4 resource handoff was successfully published and the supplied
	  protection state is complete. This preparatory interface does not enroll
	  controllers, expose a payload IOMMU protocol, or enable bus mastering.

config CAPSULE_UPDATE_CONTRACT
	bool
	default n
	help
	  Build the capsule handoff validator and private verified bounded-region
	  writer prerequisite. This does not build a producer, publish a coreboot
	  table record or register a payload-callable flash broker.

config PAYLOAD_MM_AUTHVAR_CONTRACT
	bool
	default n
	depends on BOOT_DEVICE_SUPPORTS_WRITES && HAVE_SMI_HANDLER
	help
	  Build the dormant coreboot/Payload-MM authenticated-variable boundary.
	  This validates platform-owned SMM, communication-buffer and variable-store
	  geometry, but does not install an MM dispatcher, publish a service or grant
	  raw flash access. The compiled SMM object also contains unselected typed
	  SystemFmp state parsing, protected staging and a fixed typed variable-owner
	  port. It provides no identity producer, operation executor, variable backend
	  or persistence claim. A platform must select this together with a matched
	  native payload and provide the missing SMM/SPI ownership hooks.

config CAPSULE_BROKER_CONTRACT
	bool
	default n
	depends on CAPSULE_UPDATE_CONTRACT && PAYLOAD_MM_AUTHVAR_CONTRACT
	help
	  Build the dormant one-shot SMM capsule-broker contract. This adds no
	  producer, table publication, SMI entry or production flash
	  backend or selected payload service. It includes an unselected typed port
	  which uses the protected SystemFmp owner to issue a checkpoint grant only
	  after the owner's atomic backend commits and reads back the exact failure
	  state. It also admits a separate, fixed authenticated-capsule CHECK/SET
	  intent into protected staging and a sealed authentication-provider port;
	  generic state writes cannot imply SET. An unselected synchronous executor
	  keeps dispatch busy across authentication, exact owner-state checkpoint
	  and broker APPLY. A fixed pointer-free transport can call only that staged
	  executor or return sealed read-only image information, but remains
	  unreachable without a platform SMI entry. INFO has no platform policy
	  producer. A future platform must still provide the backend,
	  protected policy producer, DMA-isolated staging and complete close-before-
	  external-code lifecycle.

config CAPSULE_BROKER_FIXED_BUFFERS
	bool
	default n
	depends on CAPSULE_BROKER_CONTRACT
	help
	  Reserve fixed communication and staging memory from coreboot's resource
	  map and provide fixed protected SMM scratch. This establishes allocation,
	  lifetime and non-overlap only. It does not establish DMA isolation,
	  install a broker or publish an endpoint.

config CAPSULE_TPM_ANCHOR_GRANT
	bool
	default n
	depends on TPM2 && PAYLOAD_MM_AUTHVAR_CONTRACT
	help
	  Build the dormant split-transaction ABI for passing one exact TPM-backed
	  rollback-anchor transition from a pre-OS TPM owner into protected SMM
	  storage. It also builds the compatible owner-journal PREPARED sidecar and
	  exact one-shot reconciliation path. This supplies no authorization
	  material, TPM mutation, SMI route or platform selection.

config CAPSULE_TPM_ANCHOR_TRANSITION
	bool
	default n
	depends on CAPSULE_TPM_ANCHOR_GRANT && CAPSULE_UPDATE_CONTRACT && ARCH_X86
	help
	  Build the dormant pre-OS rollback-anchor transition coordinator and its
	  bounded, read-only owner-journal PREPARED proof reader. No platform
	  selects this option and no TPM provider is included. The reader accepts
	  only an immutable current-anchor snapshot and two bounded state devices.
	  A future provider must execute separately authorized replacement-write
	  and write-lock operations, then return authoritative public state and
	  value readback. This adds no SMM grant route or platform selection.

config CAPSULE_TPM_ANCHOR_POLICY_PROVIDER
	bool
	default n
	depends on CAPSULE_TPM_ANCHOR_TRANSITION
	help
	  Build the dormant TPM 2.0 policy provider for the rollback-anchor
	  transition. It checks separate PolicyAuthorize material for the complete
	  replacement write and write lock and returns authoritative readback.
	  The larger stack requirement covers the coordinator, immutable operation
	  snapshot, TPM policy command encoders and platform transport call chain.
	  No platform selects this option, supplies authorization material, installs
	  a grant or publishes an SMI endpoint.

config TPM2_FIFO_PRE_OS_LIFECYCLE
	bool
	default n
	depends on TPM2 && MEMORY_MAPPED_TPM && ARCH_X86
	depends on !CRB_TPM && !AMD_CRB_FTPM && !I2C_TPM && !SPI_TPM
	help
	  Transfer an initialized TPM 2.0 FIFO transport from the legacy TSS to
	  one late-ramstage lifecycle owner. The transfer is one-shot: it revokes
	  the legacy route before installing the owner and never restores it.
	  This supplies no TPM policy, capsule provider, SMM route or endpoint.

config TPM2_PLATFORM_AUTH_CODECS
	bool
	default n
	depends on TPM2_FIFO_PRE_OS_LIFECYCLE
	help
	  Build dormant strict TPM2 platform-authorized NV write, NV write-lock,
	  platform-hierarchy close and startup-clear verification codecs over the
	  exclusive pre-OS lifecycle transport. No platform selects or invokes
	  these codecs. Late mutable firmware remains a weaker TCB than an earlier
	  hardware-enforced root; closing phEnable makes no stronger claim.

config CAPSULE_TPM_ANCHOR_TRUSTED_TRANSITION
	bool
	default n
	depends on CAPSULE_TPM_ANCHOR_TRANSITION && TPM2_PLATFORM_AUTH_CODECS
	help
	  Build the dormant policy-revision-3 platform-authorized rollback-anchor
	  transition. This supplies no platform selection, provider, resume path,
	  SMI route, provisioning or runtime DMA proof. Late mutable firmware
	  remains a weaker TCB than an earlier hardware-enforced root.

config PAYLOAD_MM_CMS_VERIFY
	bool
	default n
	depends on CAPSULE_BROKER_CONTRACT
	help
	  Build the dormant SMM-safe authenticated-capsule verification core. It
	  accepts bounded canonical DER/CMS with RSA/SHA-256 X.509 chains and uses
	  a fixed protected arena which is wiped after every call. It also builds an
	  unselected protected SystemFmp authentication-policy owner and capsule-
	  broker provider. This selects no policy producer, SMI entry or flash
	  backend. A platform must seal its trust roots, image
	  identity, board identity and version floor before installing it.

