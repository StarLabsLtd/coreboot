config MISSING_BOARD_RESET
	bool
	help
	  Selected by boards that don't provide a do_board_reset()
	  implementation. This activates a stub that logs the missing
	  board reset and halts execution.

config BOOTMEM_DRAM_PROVENANCE
	bool
	default n
	help
	  Retain the cacheable memory resources owned by enabled device domains
	  and expose their exact intersections with final bootmem ownership tags.
	  This adds no consumer, boot hook or memory-clear support claim.

config BOOTMEM_ALIGNED_RESERVATIONS
	bool
	default n
	help
	  Allow dormant clients to register a bounded set of exact, aligned DRAM
	  reservations before bootmem initialization. All requests are resolved
	  atomically from final RAM ownership before the OS memory table is written.
	  This option registers no request and installs no platform hook.

config PAYLOAD_MM_AUTHVAR_MOR_LIVE_INVENTORY
	bool
	default n
	select BOOTMEM_DRAM_PROVENANCE
	select PAYLOAD_MM_AUTHVAR_MOR_CLEAR_PLAN
	help
	  Build the dormant allocation-free memory-clear inventory composer.
	  This adds no boot hook, clear operation, endpoint or support claim.

config PAYLOAD_RESOURCE_HANDOFF
	bool "Publish assigned PCI resources to the payload"
	default n
	depends on PCI && ECAM_MMCONF_SUPPORT
	help
	  Serialize PCI root topology and exact coreboot-assigned resources for
	  payloads that consume the resource handoff. Revision 3 remains the safe
	  default; boards with a trustworthy PCI tree and boot-controller policy
	  may opt in to revision 4 topology and boot-intent sections. Before the
	  record is published, bus mastering is disabled and verified for every
	  serialized function. A platform must explicitly provide trustworthy
	  revision-4 topology and boot-controller policy before that revision is
	  published.

config PAYLOAD_DMA_HANDOFF
	bool
	depends on PAYLOAD_RESOURCE_HANDOFF
	help
	  Publish a versioned reference to a bounded, platform-prepared DMA
	  protection description. The record is rejected unless a platform
	  revision-4 resource handoff was successfully published and the supplied
	  protection state is complete. This preparatory interface does not enroll
	  controllers, expose a payload IOMMU protocol, or enable bus mastering.

config CAPSULE_UPDATE_CONTRACT
	bool
	default n
	help
	  Build the capsule handoff validator and private verified bounded-region
	  writer prerequisite. This does not build a producer, publish a coreboot
	  table record or register a payload-callable flash broker.

config PAYLOAD_MM_AUTHVAR_CONTRACT
	bool
	default n
	depends on BOOT_DEVICE_SUPPORTS_WRITES && HAVE_SMI_HANDLER
	help
	  Build the dormant coreboot/Payload-MM authenticated-variable boundary.
	  This validates platform-owned SMM, communication-buffer and variable-store
	  geometry, but does not install an MM dispatcher, publish a service or grant
	  raw flash access. The compiled SMM object also contains unselected typed
	  SystemFmp state parsing, protected staging and a fixed typed variable-owner
	  port. It provides no identity producer, operation executor, variable backend
	  or persistence claim. A platform must select this together with a matched
	  native payload and provide the missing SMM/SPI ownership hooks.

config PAYLOAD_MM_AUTHVAR_STORE_SCANNER
	bool
	default n
	help
	  Build the read-only authenticated-variable store scanner, bounded
	  caller-owned index and allocation-free exact-key lookup. This does not
	  publish a service, install an SMI endpoint or provide any variable-store
	  write path.

config PAYLOAD_MM_AUTHVAR_FTW_DECODER
	bool
	default n
	depends on PAYLOAD_MM_AUTHVAR_STORE_SCANNER
	help
	  Build the read-only EDK2 26.09 FV/FTW geometry decoder and recovery-state
	  planner. It exposes no flash callbacks, mutation path, service or endpoint.

config PAYLOAD_MM_AUTHVAR_STORE_SEMANTICS
	bool
	default n
	depends on PAYLOAD_MM_AUTHVAR_STORE_SCANNER
	help
	  Build the read-only GET, NEXT and QUERY semantic helpers and deterministic
	  append-or-reclaim planner. It does not copy results into shared memory,
	  mutate media, execute an FTW plan, or publish a service endpoint.

config PAYLOAD_MM_AUTHVAR_VOLATILE_VIEW
	bool
	default n
	depends on PAYLOAD_MM_AUTHVAR_STORE_SEMANTICS
	help
	  Build the pure immutable EDK2 26.09 volatile-variable view. It projects
	  five synthetic read-only values ahead of persistent variables without
	  creating store records, accessing media or publishing a service endpoint.

config PAYLOAD_MM_AUTHVAR_DEFAULT_STORE
	bool
	default n
	depends on PAYLOAD_MM_AUTHVAR_FTW_DECODER
	depends on PAYLOAD_MM_AUTHVAR_STORE_SEMANTICS
	help
	  Build the dormant pure EDK2 26.09 SetupMode default-store composer.
	  It creates and classifies protected candidate bytes, but performs no
	  media operation, recovery, service dispatch or endpoint publication.

config PAYLOAD_MM_AUTHVAR_MEDIA_PORT
	bool
	default n
	depends on PAYLOAD_MM_AUTHVAR_CONTRACT && PAYLOAD_MM_AUTHVAR_STORE_SCANNER
	depends on PAYLOAD_MM_AUTHVAR_FTW_DECODER
	depends on PAYLOAD_MM_AUTHVAR_STORE_SEMANTICS
	help
	  Build the dormant SMM-only authenticated-variable media port. It seals a
	  platform backend against the validated SMMSTORE contract and provides
	  bounded reads plus verified NOR program and single-block erase primitives.
	  The supported erase block must fit the 4 KiB protected snapshot capacity.
	  This adds no writer, FTW executor, dispatcher, endpoint or publication.

config PAYLOAD_MM_AUTHVAR_WRITER
	bool
	default n
	depends on PAYLOAD_MM_AUTHVAR_MEDIA_PORT
	help
	  Build the dormant authenticated-variable record and mutation planner. It
	  emits canonical records and ordered state transitions, but performs no
	  media operation. Reclaim and every plan execution remain the responsibility
	  of the later FTW executor.

config PAYLOAD_MM_AUTHVAR_EXECUTOR
	bool
	default n
	depends on PAYLOAD_MM_AUTHVAR_WRITER
	help
	  Build the dormant SMM-only authenticated-variable executor. It owns a
	  sealed protected arena, bounded FTW recovery and exact writer-plan
	  execution without exposing raw media coordinates or a service endpoint.

config PAYLOAD_MM_AUTHVAR_DEFAULT_STORE_RECOVERY
	bool
	default n
	depends on PAYLOAD_MM_AUTHVAR_EXECUTOR
	depends on PAYLOAD_MM_AUTHVAR_DEFAULT_STORE
	help
	  Build the dormant same-lease erased-media bootstrap prerequisite. It
	  monotonically programs the canonical default store before lifecycle freeze
	  and then enters the existing FTW recovery path. It publishes no backend,
	  dispatcher, service or endpoint.

config PAYLOAD_MM_AUTHVAR_FORMAT_PARSER
	bool
	default n
	depends on PAYLOAD_MM_AUTHVAR_EXECUTOR
	help
	  Build the dormant SMM-only Auth2 envelope and EFI signature-list parser.
	  It performs bounded byte-wise decoding only and supplies no cryptography,
	  trust policy, mutation authority, dispatcher or service endpoint.

config PAYLOAD_MM_AUTHVAR_SIGNATURE_DB
	bool
	default n
	depends on PAYLOAD_MM_AUTHVAR_FORMAT_PARSER
	select PAYLOAD_MM_CMS_CORE
	help
	  Build the dormant protected-snapshot Secure Boot signature-database
	  semantic validator and allocation-free append filter. It validates every
	  X.509 certificate with the bounded crypto arena, but grants no trust,
	  authorization, store mutation, provider or endpoint.

config PAYLOAD_MM_AUTHVAR_CERTDB
	bool
	default n
	help
	  Build the dormant allocation-free EDK2 26.09 private authenticated-variable
	  certdb codec. It validates complete packed snapshots and composes bounded
	  add or remove replacements, but performs no cryptography, authorization,
	  store mutation, media operation, provider or endpoint publication.

config PAYLOAD_MM_AUTHVAR_ROUTE
	bool
	default n
	depends on PAYLOAD_MM_AUTHVAR_FORMAT_PARSER
	help
	  Build the dormant allocation-free authenticated-variable authorization
	  router. It classifies protected request snapshots and emits ordered PK,
	  KEK, payload-certificate or certdb authorities and post-success intent,
	  but performs no trust, replay, payload-format or mutation decision.

config PAYLOAD_MM_AUTHVAR_TRUST_STORE
	bool
	default n
	depends on PAYLOAD_MM_AUTHVAR_STORE_SCANNER
	depends on PAYLOAD_MM_AUTHVAR_FORMAT_PARSER
	depends on PAYLOAD_MM_AUTHVAR_SIGNATURE_DB
	depends on PAYLOAD_MM_AUTHVAR_ROUTE
	depends on PAYLOAD_MM_AUTHVAR_TRUST_ANCHOR
	help
	  Build the dormant protected-store PK/KEK trust-policy matcher. It consumes
	  only an immutable scanner-produced index and canonical user-mode route,
	  but performs no Auth2, replay, payload or mutation decision.

config PAYLOAD_MM_AUTHVAR_PRIVATE_BINDING
	bool
	default n
	depends on PAYLOAD_MM_AUTHVAR_CMS_VERIFY
	help
	  Build the dormant EDK2 26.09 private authenticated-variable signer-binding
	  derivation and matcher. It consumes only immutable verified-CMS views and
	  opaque certdb binding bytes, and performs no trust, certdb mutation,
	  variable authorization, media operation or endpoint publication.

config PAYLOAD_MM_AUTHVAR_PRIVATE_TRUST
	bool
	default n
	depends on PAYLOAD_MM_AUTHVAR_STORE_SCANNER
	depends on PAYLOAD_MM_AUTHVAR_CERTDB
	depends on PAYLOAD_MM_AUTHVAR_ROUTE
	depends on PAYLOAD_MM_AUTHVAR_PRIVATE_BINDING
	help
	  Build the dormant EDK2 26.09 private authenticated-variable signer-trust
	  decision. It verifies detached CMS against a strict certdb binding, or
	  derives a new binding, but performs no store mutation, media operation,
	  authorization composition, provider or endpoint publication.

config PAYLOAD_MM_AUTHVAR_AUTHORITY
	bool
	default n
	depends on PAYLOAD_MM_AUTHVAR_EXECUTOR
	depends on PAYLOAD_MM_AUTHVAR_SIGNATURE_DB
	depends on PAYLOAD_MM_AUTHVAR_ROUTE
	help
	  Build the dormant allocation-free Auth2 policy authority. It consumes one
	  immutable protected store snapshot, emits one canonical target mutation
	  and typed derived-state intents, but installs no provider or endpoint and
	  performs no store or media operation. A later atomic multi-variable
	  composer is required before this authority may be selected for service.

config PAYLOAD_MM_AUTHVAR_BUNDLE_PLAN
	bool
	default n
	depends on PAYLOAD_MM_AUTHVAR_AUTHORITY
	select PAYLOAD_MM_AUTHVAR_CERTDB
	select PAYLOAD_MM_AUTHVAR_VOLATILE_VIEW
	help
	  Build the dormant fixed-role atomic bundle planner. It expands one final
	  Auth2 authority outcome into target, persistent certdb,
	  SecureBootEnable and VendorKeysNv mutations plus a packed volatile mode
	  projection. It writes no media, creates no candidate image and installs no
	  provider or endpoint.

config PAYLOAD_MM_AUTHVAR_CANDIDATE
	bool
	default n
	depends on PAYLOAD_MM_AUTHVAR_BUNDLE_PLAN
	help
	  Build the dormant pure authenticated-variable whole-store candidate
	  composer. It independently rescans the source, verifies any paired target
	  and persistent-certdb transition, and emits one canonical, provenance-bound
	  replacement image. It performs no media operation, installs no provider
	  and publishes no endpoint.

config PAYLOAD_MM_AUTHVAR_CANDIDATE_COMMIT
	bool
	default n
	depends on PAYLOAD_MM_AUTHVAR_CANDIDATE
	help
	  Build the dormant same-lease whole-store candidate commit prerequisite.
	  It admits a provenance-bound candidate under the active media generation
	  and token, then uses the existing EDK2-compatible FTW state machine. It
	  installs no backend or provider and publishes no endpoint.

config PAYLOAD_MM_AUTHVAR_COORDINATOR
	bool
	default n
	depends on PAYLOAD_MM_AUTHVAR_CANDIDATE_COMMIT
	select PAYLOAD_MM_AUTHVAR_CONTROLLED_MODE
	help
	  Build the dormant authenticated-variable coordinator. It derives every
	  mode fact from the active protected store and sealed executor lifecycle,
	  then performs authority, fixed-role bundle, whole-store composition and
	  same-lease commit in one linear transaction. It installs no provider and
	  publishes no endpoint.

config PAYLOAD_MM_AUTHVAR_AUTHORITY_PROVIDER
	bool
	default n
	depends on PAYLOAD_MM_AUTHVAR_COORDINATOR
	depends on !PAYLOAD_MM_AUTHVAR_REQUIRE_SELF_SIGNED_PK
	depends on PAYLOAD_MM_AUTHVAR_TRUST_STORE
	depends on PAYLOAD_MM_AUTHVAR_PRIVATE_TRUST
	help
	  Build the dormant concrete authority verifier used by the authenticated-
	  variable coordinator. It selects protected PK/KEK or private signer trust
	  from the canonical route and normalizes private authentication failures,
	  but installs no endpoint and performs no media operation.

config PAYLOAD_MM_AUTHVAR_CONTROLLED_MODE
	bool
	default n
	depends on PAYLOAD_MM_AUTHVAR_BUNDLE_PLAN
	help
	  Build the dormant EDK2 26.09-derived, fail-closed SecureBootEnable and
	  CustomMode policy.
	  It enforces their fixed property and trusted physical-presence gates, but
	  performs no store or media operation and publishes no endpoint.

config PAYLOAD_MM_AUTHVAR_MOR_POLICY
	bool
	default n
	help
	  Build the dormant EDK2 26.09-derived secure memory-overwrite-request
	  policy planner. It publishes no endpoint. Support and lifecycle facts are
	  protected snapshots from trusted coreboot code, never request fields or
	  build arguments.

config PAYLOAD_MM_AUTHVAR_MOR_ENTRY_PROBE
	bool
	default n
	select SMMSTORE_READ_REGION
	help
	  Build the dormant ramstage read-only probe for the canonical entry MOR
	  Control value in a clean EDK2 variable store, with private ramstage copies
	  of the pure FV/FTW decoder and store scanner. A future composition must
	  invoke it only after preparing the platform DMA guard and establishing a
	  trusted cold-boot classification. This does not add a caller, produce a
	  boot generation, clear memory, establish platform support, build an SMM
	  path, install a grant or publish an endpoint.

