if PAYLOAD_CDK2

# The current source-built native image uses the capsule profile. This default
# is payload policy only; it does not select coreboot's SMMSTORE backend.
config CDK2_COREBOOT_CAPSULE_PROFILE
	bool
	default y

source "payloads/external/cdk2/cdk2/Kconfig"

config DAVE_MODE
	select SECURITY_FAIL_CLOSED
	select SMMSTORE_SRK_PIN if SMMSTORE && SOC_INTEL_COMMON_BLOCK_SMM && \
		BOOTMEDIA_SMM_BWP && !BOOTMEDIA_SMM_BWP_RUNTIME_OPTION

config PAYLOAD_FILE
	default "$(obj)/cdk2/native/cdk2-coreboot-image.elf"

endif
