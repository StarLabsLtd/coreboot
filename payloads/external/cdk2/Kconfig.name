## SPDX-License-Identifier: GPL-2.0-only

config PAYLOAD_CDK2
	bool "CDK2"
	depends on ARCH_X86
	select HANDOFF_COREBOOT_TABLES
	select WANT_LINEAR_FRAMEBUFFER
	select SMMSTORE
	help
	  Build CDK2 from its source submodule and add its ELF image as the
	  primary payload. CDK2's entry stub consumes coreboot's standard
	  protected-mode payload-call ABI and performs its own mode transition.
	  The current handoff also requires coreboot-produced SMMSTORE and linear
	  framebuffer table records.
