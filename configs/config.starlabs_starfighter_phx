# VENDOR #
CONFIG_VENDOR_STARLABS=y

# BOARD #
CONFIG_BOARD_STARLABS_STARFIGHTER_AMD=y
CONFIG_EC_STARLABS_ADD_ITE_BIN=y
CONFIG_EC_STARLABS_ITE_BIN_PATH="../amd_binaries/PHX/EC/merlin-release.bin"
CONFIG_LOCALVERSION="26.10"
CONFIG_SBOM=y

# STANDARD #
CONFIG_SMMSTORE=y
CONFIG_ASS=y
CONFIG_SMMSTORE_BLOCK_SIZE=4096
CONFIG_SMM_ASS_SIZE=0x400000
CONFIG_SMM_MODULE_STACK_SIZE=0x4000

# GRAPHICS #
CONFIG_RUN_AMD_PEI_GOP=y
CONFIG_DRIVERS_AMD_PEI_GOP_FILE="../amd_binaries/PHX/GOP/AmdIa32GenericGop.efi"
CONFIG_DRIVERS_AMD_PEI_GOP_ATOM_FILE="../amd_binaries/PHX/GOP/amd_vbios.rom"

### PAYLOAD ###
# STARLABS #
CONFIG_PAYLOAD_EDK2=y
CONFIG_EDK2_REPO_CUSTOM=y
CONFIG_EDK2_BOOT_TIMEOUT=0
CONFIG_EDK2_REPOSITORY="https://github.com/StarLabsLtd/edk2"
CONFIG_EDK2_TAG_OR_REV="a82ab2bd6e3f0813e6da935b29a54e15c9c6eae1"
CONFIG_EDK2_CUSTOM_BUILD_PARAMS="-D SECURE_BOOT_ENABLE=TRUE -D SECURE_BOOT_SIMPLE_UI=TRUE -D TPM_SIMPLE_UI=TRUE -D TPM1_ENABLE=FALSE -D OPAL_PASSWORD_ENABLE=TRUE -D TCG_STORAGE_SIMPLE_UI=TRUE -D PAYLOAD_FB_HIDPI_WIDE_ASPECT_CAP_SUPPORT=TRUE -D CONNECT_ALL_DEVICES=TRUE --pcd gEfiMdeModulePkgTokenSpaceGuid.PcdFastPS2Detection=TRUE --pcd gEfiMdeModulePkgTokenSpaceGuid.PcdPs2KbdExtendedVerification=FALSE -D MEMORY_TEST=NULL -D MEMORY_TYPE_INFORMATION_BIN_BASE=0x0c000000 -D MEMORY_TYPE_INFORMATION_BIN_SIZE=0x00800000 -D MEMORY_TYPE_EFI_ACPI_RECLAIM_MEMORY=0x1f4 --pcd gUefiPayloadPkgTokenSpaceGuid.PcdUseFullCf9ResetSequence=FALSE --pcd gUefiPayloadPkgTokenSpaceGuid.PcdResetShutdownSleepType=5"

# DEBUG #
CONFIG_EDK2_RELEASE=y
CONFIG_EDK2_SERIAL_SUPPORT=n
CONFIG_CONSOLE_SERIAL=n
CONFIG_CONSOLE_SERIAL_RUNTIME=n
CONFIG_DEBUG_SMI=n
CONFIG_DEFAULT_CONSOLE_LOGLEVEL_6=y
CONFIG_POST_IO=n

# AMD FIRMWARE #
CONFIG_ADD_APCB_SOURCES=y
CONFIG_APCB_SOURCES_PATH="../amd_binaries/PHX/APCB/"
CONFIG_AMDFW_CONFIG_FILE="src/mainboard/starlabs/phoenix/fw.cfg"
CONFIG_USE_AMD_BLOBS=y

# CAPSULES #
CONFIG_DRIVERS_EFI_UPDATE_CAPSULES=y
CONFIG_DRIVERS_EFI_MAIN_FW_GUID="28716706-098a-4ad5-8f40-85ae29dfacad"
CONFIG_DRIVERS_EFI_GENERATE_CAPSULE=y
CONFIG_DRIVERS_EFI_CAPSULE_REGIONS="COREBOOT"
