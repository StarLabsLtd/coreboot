# VENDOR #
CONFIG_VENDOR_STARLABS=y

# BOARD #
CONFIG_BOARD_STARLABS_STARFIGHTER_AMD=y
CONFIG_EC_STARLABS_ADD_ITE_BIN=y
CONFIG_LOCALVERSION="26.10"
CONFIG_SBOM=y

# STANDARD #
CONFIG_SMMSTORE=y
# CONFIG_PAYLOAD_MM_INTERFACE is not set

### PAYLOAD ###
# STARLABS #
CONFIG_PAYLOAD_EDK2=y
CONFIG_EDK2_REPO_CUSTOM=y
CONFIG_EDK2_BOOT_TIMEOUT=2
CONFIG_EDK2_SD_MMC_TIMEOUT=1
CONFIG_EDK2_REPOSITORY="https://github.com/StarLabsLtd/edk2"
CONFIG_EDK2_TAG_OR_REV="origin/26.10_amd"
CONFIG_EDK2_CUSTOM_BUILD_PARAMS="-D USE_AMD_GOP=TRUE -D RESET_COLD_USE_FULL_CF9=FALSE -D SECURE_BOOT_ENABLE=TRUE -D SECURE_BOOT_SIMPLE_UI=TRUE -D TPM_SIMPLE_UI=TRUE -D TPM1_ENABLE=FALSE -D OPAL_PASSWORD_ENABLE=TRUE -D TCG_STORAGE_SIMPLE_UI=TRUE -D PAYLOAD_FB_HIDPI_WIDE_ASPECT_CAP_SUPPORT=TRUE -D CONNECT_ALL_DEVICES=TRUE --pcd gEfiMdeModulePkgTokenSpaceGuid.PcdFastPS2Detection=TRUE --pcd gEfiMdeModulePkgTokenSpaceGuid.PcdPs2KbdExtendedVerification=FALSE -D MEMORY_TEST=NULL -D MEMORY_TYPE_INFORMATION_BIN_BASE=0x0c000000 -D MEMORY_TYPE_INFORMATION_BIN_SIZE=0x00800000 -D MEMORY_TYPE_EFI_ACPI_RECLAIM_MEMORY=0x1f4"

# DEBUG #
# CONFIG_EDK2_DEBUG=y
CONFIG_POST_IO=n

# AMD FIRMWARE #
CONFIG_ADD_APCB_SOURCES=y
CONFIG_APCB_SOURCES_PATH="../amd_binaries/PHX/APCB/"
CONFIG_AMDFW_CONFIG_FILE="src/mainboard/starlabs/phoenix/fw.cfg"
CONFIG_USE_AMD_BLOBS=y

# CAPSULES #
CONFIG_DRIVERS_EFI_UPDATE_CAPSULES=y
CONFIG_DRIVERS_EFI_MAIN_FW_GUID="28716706-098a-4ad5-8f40-85ae29dfacad"
CONFIG_DRIVERS_EFI_GENERATE_CAPSULE=y
CONFIG_DRIVERS_EFI_CAPSULE_REGIONS="AMDFW COREBOOT EC"
CONFIG_DRIVERS_EFI_CAPSULE_SIGNER_PRIVATE_CERT="/home/sean/Documents/certificates/starlabs_capsule/StarLabsCapsuleSigner.pem"
CONFIG_DRIVERS_EFI_CAPSULE_OTHER_PUBLIC_CERT="/home/sean/Documents/certificates/starlabs_capsule/StarLabsCapsuleSub.pub.pem"
CONFIG_DRIVERS_EFI_CAPSULE_TRUSTED_PUBLIC_CERT="/home/sean/Documents/certificates/starlabs_capsule/StarLabsCapsuleRoot.pub.pem"
