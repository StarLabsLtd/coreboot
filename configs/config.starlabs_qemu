CONFIG_PAYLOAD_CDK2=y
CONFIG_CDK2_SECURE_BOOT=y
CONFIG_CDK2_BOOT_TIMEOUT=2
CONFIG_CDK2_LINEAR_SETUP_HOTKEY=y
CONFIG_CDK2_NATIVE_USB_KEYBOARD=y

# DEBUG #
# CONFIG_CDK2_DEBUG=y
CONFIG_POST_IO=n
