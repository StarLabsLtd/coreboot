# VENDOR #
CONFIG_VENDOR_STARLABS=y

# BOARD #
CONFIG_BOARD_STARLABS_LITE_GLK=y
CONFIG_HAVE_IFD_BIN=n
CONFIG_HAVE_ME_BIN=n
CONFIG_EC_STARLABS_ADD_ITE_BIN=n
CONFIG_MAINBOARD_SERIAL_NUMBER="I300000"
CONFIG_LOCALVERSION="26.06"

# STANDARD #
CONFIG_SMMSTORE=y
CONFIG_SMMSTORE_V2=y
# CONFIG_BOOTMEDIA_SMM_BWP is not set
# CONFIG_BOOTMEDIA_SMM_BWP_RUNTIME_OPTION is not set
CONFIG_LOCK_MANAGEMENT_ENGINE=n

### PAYLOAD ###
# STARLABS #
CONFIG_PAYLOAD_EDK2=y
CONFIG_EDK2_REPO_CUSTOM=y
CONFIG_EDK2_BOOT_TIMEOUT=2
CONFIG_EDK2_SD_MMC_TIMEOUT=1
CONFIG_EDK2_CPU_TIMER_LIB=y
# CONFIG_EDK2_HAVE_EFI_SHELL is not set
CONFIG_EDK2_REPOSITORY="https://github.com/starlabsltd/edk2"
CONFIG_EDK2_TAG_OR_REV="origin/26.06"
CONFIG_EDK2_CUSTOM_BUILD_PARAMS="-D VARIABLE_SUPPORT=SMMSTORE -D SECURE_BOOT_ENABLE=TRUE -D SECURE_BOOT_SIMPLE_UI=TRUE -D TPM_SIMPLE_UI=TRUE -D TPM1_ENABLE=FALSE -D OPAL_PASSWORD_ENABLE=TRUE -D TCG_STORAGE_SIMPLE_UI=TRUE -D PAYLOAD_FB_HIDPI_SUPPORT=TRUE -D FAST_PS2_DETECTION=TRUE -D PS2_KBD_EXTENDED_VERIFICATION=FALSE -D CPU_MP_SERVICES_ENABLE=FALSE -D CPU_REFRESH_GCD_MEMORY_ATTRIBUTES=FALSE -D MEMORY_TEST=NONE -D USB_LEGACY_HC_ENABLE=FALSE"

# DEBUG #
# CONFIG_EDK2_DEBUG=y
CONFIG_POST_IO=n

### IFWI ###
CONFIG_BOOT_PROFILE_2=y
CONFIG_IFWI_STITCH_IMAGE=y
CONFIG_IFWI_CSE_IMAGE="3rdparty/blobs/mainboard/starlabs/lite/glk/cse_image.bin"
