CONFIG_IFWI_PDT="3rdparty/blobs/mainboard/starlabs/lite/glk/pdt.bin"
CONFIG_IFWI_PRIVATE_KEY="/home/sean/Documents/stitch/private.pem"
CONFIG_IFWI_DESCRIPTOR="/home/sean/Documents/stitch/glk_ami_inputs/descriptor.bin"
CONFIG_IFWI_FITC_CONFIG_PROFILE="glk"
CONFIG_IFWI_FIT_TOOL_VERSION="0x539001a00000004"

### FSP ###
