# VENDOR #
CONFIG_VENDOR_STARLABS=y

# BOARD #
CONFIG_BOARD_STARLABS_LITE_ADL=y
CONFIG_HAVE_IFD_BIN=y
CONFIG_HAVE_ME_BIN=y
CONFIG_EC_STARLABS_ADD_ITE_BIN=y
CONFIG_MAINBOARD_SERIAL_NUMBER="I500000"
CONFIG_LOCALVERSION="26.15"
CONFIG_SBOM=y

# STANDARD #
CONFIG_SMMSTORE=y
# Development recovery profile: leave the descriptor-writable BIOS region
# accessible to flashrom while capsule update support is being validated.
# CONFIG_BOOTMEDIA_SMM_BWP is not set
CONFIG_CDK2_COREBOOT_CAPSULE_PROFILE=y
CONFIG_LOCK_MANAGEMENT_ENGINE=y

### PAYLOAD ###
# STARLABS #
CONFIG_PAYLOAD_CDK2=y
# Keep the normal hardware profile observable without paying the synchronous
# UART cost on every diagnostic character.  The dedicated debug profile can
# still select CDK2_DEBUG and serial when an attached-UART trace is required.
# CONFIG_CDK2_DEBUG is not set
# CONFIG_CDK2_SERIAL is not set
CONFIG_CDK2_LINEAR_BOOT=y
CONFIG_CDK2_RETAINED_FV="../../qemu-validation/cdk2-full/native/retained-native-dxe-core.fv"
CONFIG_CDK2_RETAINED_FV_SHA256="b6e920f4b1047a03a8a0d4a16bd023e897b4a2d6b2661c8cc6a85fff15b2c9b5"
CONFIG_CDK2_SYSTEM_FMP_FFS="../../qemu-validation/lite-adl-capsule-transition/FmpDxe-975cd0e6.ffs"
CONFIG_CDK2_SYSTEM_FMP_FFS_SHA256="730b387c205f718add2962a3bd29717b9bfca3342def83e799146a0176805fe9"
CONFIG_CDK2_SYSTEM_FMP_PE="../../qemu-validation/lite-adl-capsule-transition/FmpDxe-975cd0e6.efi"
CONFIG_CDK2_SYSTEM_FMP_PE_SHA256="ac33f010c72db4fbd08b2372e6d95e59e490889d6cc72adef839c173957d3000"
CONFIG_CDK2_BOOT_TIMEOUT=0
CONFIG_CDK2_USB_SCAN_TIMEOUT=2
CONFIG_CDK2_CONNECT_ALL_DEVICES=y
CONFIG_CDK2_CPU_TIMER=y
CONFIG_CDK2_GOP_HIDPI=y
CONFIG_CDK2_GOP_HIDPI_ASPECT_CAP=y
CONFIG_CDK2_GOP_HIDPI_ASPECT_W=3
CONFIG_CDK2_GOP_HIDPI_ASPECT_H=2
CONFIG_CDK2_PS2_KEYBOARD=y
CONFIG_CDK2_CAPSULE=y
# CONFIG_CDK2_SECURE_BOOT is not set

# RELEASE-SAFE DIAGNOSTICS #
CONFIG_CONSOLE_CBMEM=y
# CONFIG_CONSOLE_SERIAL is not set
CONFIG_DEFAULT_CONSOLE_LOGLEVEL_4=y
# CONFIG_FSP_USES_CB_DEBUG_EVENT_HANDLER is not set
# CONFIG_FSP_ENABLE_SERIAL_DEBUG is not set
# CONFIG_DEBUG_HW_BREAKPOINTS is not set
# CONFIG_DEBUG_NULL_DEREF_BREAKPOINTS is not set
CONFIG_POST_IO=n

# FSP #
CONFIG_ADD_FSP_BINARIES=y
CONFIG_FSP_FULL_FD=y
CONFIG_FSP_HEADER_PATH="../intel_fsp/twl/202502051115/Include/"
CONFIG_FSP_FD_PATH="../intel_fsp/twl/202502051115/Release/Fsp.fd"

# CAPSULES #
CONFIG_DRIVERS_EFI_UPDATE_CAPSULES=y
CONFIG_DRIVERS_EFI_MAIN_FW_GUID="975cd0e6-c540-4e2b-906c-72c0d0d1e40d"
CONFIG_DRIVERS_EFI_MAIN_FW_VERSION=0x001a000f
CONFIG_DRIVERS_EFI_MAIN_FW_LSV=0x001a0008
CONFIG_DRIVERS_EFI_GENERATE_CAPSULE=y
CONFIG_DRIVERS_EFI_CAPSULE_REGIONS="COREBOOT EC"
CONFIG_DRIVERS_EFI_CAPSULE_SIGNER_PRIVATE_CERT="/home/sean/Documents/certificates/starlabs_capsule/StarLabsCapsuleSigner.pem"
CONFIG_DRIVERS_EFI_CAPSULE_OTHER_PUBLIC_CERT="/home/sean/Documents/certificates/starlabs_capsule/StarLabsCapsuleSub.pub.pem"
CONFIG_DRIVERS_EFI_CAPSULE_TRUSTED_PUBLIC_CERT="/home/sean/Documents/certificates/starlabs_capsule/StarLabsCapsuleRoot.pub.pem"
