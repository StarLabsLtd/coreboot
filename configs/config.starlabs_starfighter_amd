# VENDOR #
CONFIG_VENDOR_STARLABS=y

# BOARD #
CONFIG_BOARD_STARLABS_STARFIGHTER_AMD=y
CONFIG_NO_GFX_INIT=y
CONFIG_EDK2_GOP_DRIVER=y
CONFIG_EDK2_AMD_GOP_DRIVER=y
CONFIG_MAINBOARD_SERIAL_NUMBER="F2A0000"
CONFIG_EC_STARLABS_ADD_ITE_BIN=y
CONFIG_LOCALVERSION="26.06"
CONFIG_VGA_BIOS_ID="1002,1900"
CONFIG_VGA_BIOS=y
CONFIG_VGA_BIOS_FILE="3rdparty/blobs/mainboard/starlabs/phoenix/starfighter/vbios.rom"
CONFIG_EC_STARLABS_ADD_ITE_BIN=y
CONFIG_EC_STARLABS_ITE_BIN_PATH="3rdparty/blobs/mainboard/starlabs/phoenix/starfighter/ec.bin"

# STANDARD #
CONFIG_SMMSTORE=y
CONFIG_SMMSTORE_V2=y

### PAYLOAD ###
# STARLABS #
CONFIG_PAYLOAD_EDK2=y
CONFIG_EDK2_REPO_CUSTOM=y
CONFIG_EDK2_BOOT_TIMEOUT=2
CONFIG_EDK2_SD_MMC_TIMEOUT=1
CONFIG_EDK2_REPOSITORY="https://github.com/starlabsltd/edk2"
CONFIG_EDK2_TAG_OR_REV="origin/wip/f2a"
CONFIG_EDK2_CUSTOM_BUILD_PARAMS="-D VARIABLE_SUPPORT=SMMSTORE -D SECURE_BOOT_ENABLE=TRUE -D SECURE_BOOT_SIMPLE_UI=TRUE -D TPM1_ENABLE=FALSE -D TPM2_ENABLE=FALSE --pcd gEfiMdeModulePkgTokenSpaceGuid.PcdVideoHorizontalResolution=1920 --pcd gEfiMdeModulePkgTokenSpaceGuid.PcdVideoVerticalResolution=1200 --pcd gEfiMdeModulePkgTokenSpaceGuid.PcdSetupVideoHorizontalResolution=1920 --pcd gEfiMdeModulePkgTokenSpaceGuid.PcdSetupVideoVerticalResolution=1200"

# DEBUG #
CONFIG_EDK2_DEBUG=y
CONFIG_CONSOLE_SERIAL=y
CONFIG_EDK2_DISABLE_TPM=y
CONFIG_PSP_SERIAL_DEBUG_ENABLE=y

### AMD FW ###
CONFIG_USE_AMD_BLOBS=y
CONFIG_ADD_APCB_SOURCES=y
CONFIG_APCB_SOURCES_PATH="../amd_binaries/PHX/APCB/"
CONFIG_AMDFW_CONFIG_FILE="src/mainboard/\$(CONFIG_MAINBOARD_DIR)/fw.cfg"
