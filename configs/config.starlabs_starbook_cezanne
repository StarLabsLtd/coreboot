# VENDOR #
CONFIG_VENDOR_STARLABS=y

# BOARD #
CONFIG_BOARD_STARLABS_STARBOOK_CEZANNE=y
CONFIG_EC_STARLABS_ADD_ITE_BIN=y
CONFIG_MAINBOARD_SERIAL_NUMBER="B6A0000"
CONFIG_LOCALVERSION="25.11"

# These must be set as such, otherwise boot hangs
CONFIG_POST_IO=y
CONFIG_POST_IO_PORT=0x80


# STANDARD #
CONFIG_SMMSTORE_V2=y

### PAYLOAD ###
# STARLABS #
CONFIG_PAYLOAD_EDK2=y
CONFIG_EDK2_REPO_CUSTOM=y
CONFIG_EDK2_BOOT_TIMEOUT=2
CONFIG_EDK2_SD_MMC_TIMEOUT=1
CONFIG_EDK2_REPOSITORY="https://github.com/starlabsltd/edk2"
CONFIG_EDK2_TAG_OR_REV="origin/uefipayload_vs_tpm"
CONFIG_EDK2_CUSTOM_BUILD_PARAMS="-D VARIABLE_SUPPORT=SMMSTORE -D SECURE_BOOT_ENABLE=TRUE"

# DEBUG #
# CONFIG_EDK2_DEBUG=y

### FSP ###
CONFIG_ADD_FSP_BINARIES=y
CONFIG_FSP_M_FILE="../amd_binaries/CZN/CEZANNE_M.fd"
CONFIG_FSP_S_FILE="../amd_binaries/CZN/CEZANNE_S.fd"
CONFIG_RUN_FSP_GOP=y

CONFIG_ADD_APCB_SOURCES=y
CONFIG_APCB_SOURCES_PATH="../amd_binaries/CZN/APCB/Release"
CONFIG_USE_AMD_BLOBS=y
