# Protected Q35 SPI/BMP native CDK2 menu route.
# Absolute logo and trust-certificate paths are qualified local inputs.

CONFIG_ANY_TOOLCHAIN=y
CONFIG_FMDFILE="src/mainboard/emulation/qemu-q35/native-service-spi-8M.fmd"
CONFIG_BOARD_EMULATION_QEMU_X86_Q35=y
CONFIG_Q35_SMM_INVOCATION_NATIVE_COMPONENT=y
CONFIG_Q35_SMM_INVOCATION_NATIVE_CAUSE_COMPONENT=y
CONFIG_Q35_SMM_INVOCATION_NATIVE_SERVICE_COMPONENT=y
CONFIG_Q35_SMM_INVOCATION_NATIVE_PUBLIC_SERVICE_COMPONENT=y
CONFIG_Q35_SMM_CAPSULE_BROKER_SERVICE=y
CONFIG_Q35_SMM_CAPSULE_BROKER_AUTH_POLICY=y
CONFIG_Q35_SMM_CAPSULE_BROKER_BUFFERS=y
CONFIG_Q35_SMM_CAPSULE_BROKER=y
CONFIG_Q35_VTD_DMA_TEST_BACKEND=y
CONFIG_PAYLOAD_LOCAL_APIC_TIMER_INFO=y
CONFIG_BMP_LOGO=y
CONFIG_BMP_LOGO_FILE_NAME="/home/sean/Documents/coreboot/3rdparty/blobs/mainboard/starlabs/Logo.bmp"
CONFIG_USE_COREBOOT_FOR_BMP_RENDERING=y
CONFIG_DRIVERS_EFI_FW_INFO=y
CONFIG_CPU_QEMU_X86_TSEG_SMM=y
# CONFIG_ON_DEVICE_ROM_LOAD is not set
CONFIG_DRIVERS_EFI_VARIABLE_STORE=y
CONFIG_DRIVERS_EFI_MAIN_FW_VERSION=0x001a0009
CONFIG_DRIVERS_EFI_MAIN_FW_LSV=0x001a0009
CONFIG_DRIVERS_EFI_CAPSULE_RAM_HANDOFF=y
CONFIG_DRIVERS_EFI_CAPSULE_DELIVERY_POLICY=y
CONFIG_DRIVERS_EFI_CAPSULE_ON_DISK_SUPPORT=y
CONFIG_DRIVERS_EFI_CAPSULE_TRUSTED_PUBLIC_CERT="/home/sean/q35-capsule-native-signing.PuAsza/trust.pem"
CONFIG_CONSOLE_SPI_FLASH=y
CONFIG_CONSOLE_SPI_FLASH_LATEST_BOOT=y
CONFIG_PAYLOAD_SPI_FLASH_CONSOLE=y
CONFIG_PAYLOAD_CDK2=y
CONFIG_CDK2_LVGL_RENDERER=y
CONFIG_CDK2_LINEAR_SETUP_HOTKEY=y
# CONFIG_CDK2_NULL_MEMORY_TEST is not set
CONFIG_CDK2_NATIVE_USB_KEYBOARD=y
CONFIG_CDK2_PROTECTED_VARIABLE_RUNTIME=y
# CONFIG_CDK2_NATIVE_SHELL is not set
CONFIG_CDK2_CBMEM_CONSOLE=y
CONFIG_CDK2_SPI_CONSOLE=y
CONFIG_PAYLOAD_RESOURCE_HANDOFF=y
