# VENDOR #
CONFIG_VENDOR_STARLABS=y

# BOARD #
CONFIG_BOARD_STARLABS_LITE_APL=y
CONFIG_HAVE_IFD_BIN=n
CONFIG_HAVE_ME_BIN=n
CONFIG_EC_STARLABS_ADD_ITE_BIN=y
CONFIG_MAINBOARD_SERIAL_NUMBER="I200000"
CONFIG_LOCALVERSION="26.05"

# STANDARD #
CONFIG_SMMSTORE=y
CONFIG_SMMSTORE_V2=y
CONFIG_LOCK_MANAGEMENT_ENGINE=n

### PAYLOAD ###
# STARLABS #
CONFIG_PAYLOAD_EDK2=y
CONFIG_EDK2_REPO_CUSTOM=y
CONFIG_EDK2_BOOT_TIMEOUT=2
CONFIG_EDK2_SD_MMC_TIMEOUT=1
CONFIG_EDK2_REPOSITORY="https://github.com/starlabsltd/edk2"
CONFIG_EDK2_TAG_OR_REV="origin/26.05"
CONFIG_EDK2_CUSTOM_BUILD_PARAMS="-D VARIABLE_SUPPORT=SMMSTORE -D SECURE_BOOT_ENABLE=TRUE -D SECURE_BOOT_SIMPLE_UI=TRUE -D TPM_SIMPLE_UI=TRUE -D TPM1_ENABLE=FALSE -D OPAL_PASSWORD_ENABLE=TRUE -D TCG_STORAGE_SIMPLE_UI=TRUE -D PAYLOAD_FB_HIDPI_SUPPORT=TRUE -D FAST_PS2_DETECTION=TRUE -D PS2_KBD_EXTENDED_VERIFICATION=FALSE"

# DEBUG #
# CONFIG_EDK2_DEBUG=y
CONFIG_POST_IO=n

### IFWI ###
CONFIG_BOOT_PROFILE_2=y
CONFIG_IFWI_STITCH_IMAGE=y
CONFIG_IFWI_BOOTGUARD=y
CONFIG_IFWI_CSE_IMAGE="3rdparty/blobs/mainboard/starlabs/lite/apl/cse_image.bin"
CONFIG_IFWI_PMCP="3rdparty/blobs/mainboard/starlabs/lite/apl/pmcp.bin"
CONFIG_IFWI_PDT="3rdparty/blobs/mainboard/starlabs/lite/apl/pdt.bin"

# CAPSULES #
CONFIG_DRIVERS_EFI_UPDATE_CAPSULES=y
CONFIG_DRIVERS_EFI_CAPSULE_EMBED_FMP_DXE=y
CONFIG_DRIVERS_EFI_MAIN_FW_GUID="5d9d096d-2c62-4bfd-b2ed-a5ce77dcc9e6"
CONFIG_DRIVERS_EFI_GENERATE_CAPSULE=y
CONFIG_DRIVERS_EFI_CAPSULE_REGIONS="COREBOOT EC"
CONFIG_DRIVERS_EFI_CAPSULE_SIGNER_PRIVATE_CERT="/home/sean/Documents/certificates/starlabs_capsule/StarLabsCapsuleSigner.pem"
CONFIG_DRIVERS_EFI_CAPSULE_OTHER_PUBLIC_CERT="/home/sean/Documents/certificates/starlabs_capsule/StarLabsCapsuleSub.pub.pem"
CONFIG_DRIVERS_EFI_CAPSULE_TRUSTED_PUBLIC_CERT="/home/sean/Documents/certificates/starlabs_capsule/StarLabsCapsuleRoot.pub.pem"
