diff --git a/tests/system_fmp_core_ram_refusal.py b/tests/system_fmp_core_ram_refusal.py
new file mode 100644
index 0000000000..d8026c37e0
--- /dev/null
+++ b/tests/system_fmp_core_ram_refusal.py
@@ -0,0 +1,73 @@
+# SPDX-License-Identifier: GPL-2.0-only
+"""HOST-only binding of three deliberately refused normal RAM capsules."""
+
+import argparse
+import sys
+import uuid
+from pathlib import Path
+
+CASES = ("wrong-signer", "signed-byte", "below-floor")
+
+
+def validate_refusal(tools, capsule, target, trust, reference, signer, case, attempt):
+    sys.path.insert(0, str(tools))
+    from validate_capsule import ValidationError, parse_capsule_details, validate, verify_signature
+
+    if case not in CASES or reference is None:
+        raise ValueError("known refusal and authenticated reference required")
+    original = reference.read_bytes()
+    image = target.read_bytes()
+    expected_guid = uuid.UUID("00112233-4455-6677-8899-aabbccddeeff")
+    validate(original, None, expected_guid, 0, 0x001a000a, 0x001a0009,
+             image, ["COREBOOT"], str(trust), True, require_fmap=True)
+    good = parse_capsule_details(original)
+    candidate = capsule.read_bytes()
+    details = parse_capsule_details(candidate)
+    if case == "below-floor":
+        if attempt != 0x001a0008:
+            raise ValueError("below-floor fixture must attempt version8 below actual floor9")
+        validate(candidate, None, expected_guid, 0, attempt, attempt, image,
+                 ["COREBOOT"], str(trust), True, require_fmap=True)
+    else:
+        if attempt != 0x001a000a:
+            raise ValueError("CMS refusal must retain the trusted reference attempt")
+        if case == "signed-byte":
+            changed = original[:-1] + bytes([original[-1] ^ 1])
+            if candidate != changed:
+                raise ValueError("signed-byte fixture is not the exact one-byte corruption")
+            for key in good:
+                if key not in ("authenticated", "payload", "image") and details[key] != good[key]:
+                    raise ValueError("signed-byte corruption changed capsule framing")
+        else:
+            if signer is None:
+                raise ValueError("wrong-signer fixture requires its own public certificate")
+            validate(candidate, None, expected_guid, 0, attempt, 0x001a0009,
+                     image, ["COREBOOT"], str(signer), True, require_fmap=True)
+            for key in ("payload", "monotonic_count", "flags"):
+                if details[key] != good[key]:
+                    raise ValueError("wrong signer changed the trusted reference signed body")
+        try:
+            verify_signature(details, str(trust))
+        except ValidationError as error:
+            if str(error) != "capsule PKCS#7 verification failed":
+                raise
+        else:
+            raise ValueError("CMS refusal unexpectedly verifies under actual producer trust")
+    print(f"Actual capsule tools bound finite {case} refusal; producer public trust unchanged: PASS")
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    for name in ("tools", "capsule", "target", "trust", "reference"):
+        parser.add_argument("--" + name, type=Path, required=True)
+    parser.add_argument("--signer", type=Path)
+    parser.add_argument("--case", choices=CASES, required=True)
+    parser.add_argument("--attempt", type=lambda text: int(text, 0), required=True)
+    arguments = parser.parse_args()
+    validate_refusal(arguments.tools, arguments.capsule, arguments.target,
+                     arguments.trust, arguments.reference, arguments.signer,
+                     arguments.case, arguments.attempt)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/system_fmp_core_ram_refusal_oracle_test.sh b/tests/system_fmp_core_ram_refusal_oracle_test.sh
new file mode 100755
index 0000000000..203d1a1728
--- /dev/null
+++ b/tests/system_fmp_core_ram_refusal_oracle_test.sh
@@ -0,0 +1,102 @@
+#!/bin/sh
+# SPDX-License-Identifier: GPL-2.0-only
+# Finite HOST tests; never starts QEMU or modifies caller firmware/capsules.
+set -eu
+
+test "$#" -eq 5
+root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
+tools="$1/util/efi_capsule"
+fixtures=$2
+reference=$3
+target=$4
+trust=$5
+output=$(mktemp -d "${TMPDIR:-/tmp}/core-ram-refusal-oracle.XXXXXX")
+printf 'Refusal HOST oracle artifacts: %s\n' "$output"
+original="$root/tests/system_fmp_core_ram_native_test.py"
+helper="$root/tests/system_fmp_core_ram_refusal.py"
+sha256sum "$original" "$helper" "$root/tests/system_fmp_core_ram_runner_test.py" \
+	"$0" "$reference" "$target" "$trust" "$fixtures/wrong-signer.pem" \
+	"$fixtures/wrong-signer-a.cap" "$fixtures/signed-byte-corrupt-a.cap" \
+	"$fixtures/signed-below-floor-8.cap" "$tools/validate_capsule.py" \
+	"$tools/crypto_policy.py" > "$output/inputs-before.sha256"
+python3 "$root/tests/system_fmp_core_ram_runner_test.py" > "$output/host.log" 2>&1
+
+preflight()
+{
+	case_name=$1
+	candidate=$2
+	attempted=$3
+	set -- --tools "$tools" --capsule "$candidate" --target "$target" --trust "$trust" \
+		--reference "$reference" --case "$case_name" --attempt "$attempted"
+	if test "$case_name" = wrong-signer; then
+		set -- "$@" --signer "$fixtures/wrong-signer.pem"
+	fi
+	python3 "$helper" "$@"
+}
+
+preflight wrong-signer "$fixtures/wrong-signer-a.cap" 0x001a000a > "$output/wrong-signer.log" 2>&1
+preflight signed-byte "$fixtures/signed-byte-corrupt-a.cap" 0x001a000a > "$output/signed-byte.log" 2>&1
+preflight below-floor "$fixtures/signed-below-floor-8.cap" 0x001a0008 > "$output/below-floor.log" 2>&1
+for case_name in wrong-signer signed-byte below-floor; do
+	if preflight "$case_name" "$reference" 0x001a000a > "$output/$case_name-good-refused.log" 2>&1; then
+		echo "refusal preflight accepted the actual good capsule as $case_name" >&2
+		exit 1
+	else
+		test "$?" -eq 1
+	fi
+	case "$case_name" in
+		wrong-signer) diagnostic='capsule PKCS#7 verification failed' ;;
+		signed-byte) diagnostic='not the exact one-byte corruption' ;;
+		below-floor) diagnostic='must attempt version8' ;;
+	esac
+	grep -q "$diagnostic" "$output/$case_name-good-refused.log"
+done
+
+python3 - "$original" "$output" <<-'PY'
+	import pathlib
+	import sys
+	source, output = map(pathlib.Path, sys.argv[1:])
+	body = source.read_text()
+	cases = (
+	    ('status', 'if current.count(expected) != 1 or current.count(b"CDK2 | CAPSULE_RAM | failed") != 1:',
+	     'if False:  # discarded exact refusal status/count', 'test_refusal_exact_status'),
+	    ('pci', 'if index == 1 and pci >= 0:', 'if False:  # discarded warm PCI refusal',
+	     'test_refusal_pci_refused'),
+	    ('complete', 'if b"CDK2 | CAPSULE_RAM | complete" in current:',
+	     'if False:  # discarded refusal completion guard', 'test_refusal_completion_refused'),
+	    ('reset', 'if len(resets) != 1 or resets[0].get("data", {}).get("guest") is not True:',
+	     'if False:  # discarded actual guest reset guard', 'test_guest_reset_cardinality'),
+	    ('markers', 'if uart.count(("CDK2_CORE_RAM_STAGE_" + marker).encode()) != 1:',
+	     'if False:  # discarded ordinary MAIN cardinality', 'test_refusal_main_markers'),
+	    ('firmware', 'installed[start + size:] != initial[start + size:]',
+	     '(False and False)', 'test_refusal_exact_firmware'),
+	    ('extent', 'len(initial) != 8388608', '(False or False)', 'test_refusal_truncated_media'),
+	)
+	for name, before, after, test in cases:
+	    if body.count(before) != 1:
+	        raise SystemExit(f'{name}: source target count is not one')
+	    changed = body.replace(before, after)
+	    if changed.count(after) != 1 or changed.replace(after, before) != body:
+	        raise SystemExit(f'{name}: whole runner inverse mismatch')
+	    (output / f'{name}.py').write_text(changed)
+	    (output / f'{name}-inverse.py').write_text(changed.replace(after, before))
+	    (output / f'{name}-test.txt').write_text(test)
+PY
+for cause in status pci complete reset markers firmware extent; do
+	cmp "$original" "$output/$cause-inverse.py"
+	test_name=$(cat "$output/$cause-test.txt")
+	if PYTHONPATH="$root/util/qemu/bin${PYTHONPATH:+:$PYTHONPATH}" \
+		CDK2_CORE_RAM_RUNNER_SOURCE="$output/$cause.py" \
+		python3 "$root/tests/system_fmp_core_ram_runner_test.py" "RefusalTest.$test_name" \
+		> "$output/$cause.log" 2>&1; then
+		echo "HOST test missed discarded $cause guard" >&2
+		exit 1
+	else
+		test "$?" -eq 1
+	fi
+	grep -q "FAIL: $test_name" "$output/$cause.log"
+	grep -q 'AssertionError: ValueError not raised' "$output/$cause.log"
+	! grep -Eq 'ERROR:|SyntaxError|ImportError|Traceback.*SystemExit' "$output/$cause.log"
+done
+sha256sum -c "$output/inputs-before.sha256"
+printf '%s\n' 'HOST refusal status/epoch/media/marker guards and actual capsule-tool preflights: PASS'
diff --git a/tests/system_fmp_core_ram_refusal_store.c b/tests/system_fmp_core_ram_refusal_store.c
new file mode 100644
index 0000000000..061cce9845
--- /dev/null
+++ b/tests/system_fmp_core_ram_refusal_store.c
@@ -0,0 +1,130 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+/* Read-only HOST oracle; actual producer decoders, never guest admission. */
+#include <boot/payload_mm_authvar.h>
+#include <boot/payload_mm_authvar_ftw.h>
+#include <boot/payload_mm_authvar_store.h>
+#include <commonlib/helpers.h>
+#include <uuid.h>
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+#define REGION_SIZE (64U * 1024U)
+#define ENTRY_CAPACITY 128U
+
+static const uint16_t state_name[] = { 'F', 'm', 'p', 'S', 't', 'a', 't', 'e', 0 };
+static uint8_t media[REGION_SIZE];
+static uint8_t changed[REGION_SIZE];
+
+static bool matches(const uint8_t *region, const uint8_t *guid,
+	uint32_t *record_offset, uint32_t *data_offset)
+{
+	const uint8_t zero[PAYLOAD_MM_FMP_STATE_WIRE_SIZE] = { 0 };
+	struct payload_mm_authvar_fv_geometry geometry;
+	struct payload_mm_authvar_ftw_plan plan;
+	struct payload_mm_authvar_store_entry entries[ENTRY_CAPACITY];
+	struct payload_mm_authvar_store_index index = {
+		.entries = entries, .entry_capacity = ARRAY_SIZE(entries),
+	};
+	const struct payload_mm_authvar_store_limits limits = {
+		.maximum_store_size = REGION_SIZE, .maximum_name_size = 4096U,
+		.maximum_data_size = REGION_SIZE, .maximum_records = ENTRY_CAPACITY,
+	};
+	const struct payload_mm_authvar_store_entry *entry;
+	const void *data;
+
+	if (!payload_mm_authvar_fv_geometry(&geometry, REGION_SIZE, 4096U))
+		return false;
+	if (payload_mm_authvar_ftw_plan(region, REGION_SIZE, 4096U, &plan) != CB_SUCCESS ||
+	    plan.action != PAYLOAD_MM_AUTHVAR_FTW_CLEAN ||
+	    plan.workspace != PAYLOAD_MM_AUTHVAR_FTW_WORKSPACE_WORKING ||
+	    plan.queue_disposition != PAYLOAD_MM_AUTHVAR_FTW_QUEUE_EMPTY ||
+	    plan.queue_offset != PAYLOAD_MM_AUTHVAR_FTW_WORK_HEADER_SIZE ||
+	    plan.queue_entry_size != 0U)
+		return false;
+	if (payload_mm_authvar_store_scan(&index,
+	    region + PAYLOAD_MM_AUTHVAR_FV_HEADER_SIZE,
+	    geometry.variable_size - PAYLOAD_MM_AUTHVAR_FV_HEADER_SIZE, &limits) != CB_SUCCESS ||
+	    index.dirty_tail_offset != 0U)
+		return false;
+	entry = payload_mm_authvar_store_find(&index, guid, state_name, sizeof(state_name));
+	if (entry == NULL || entry->attributes != PAYLOAD_MM_FMP_STATE_VARIABLE_ATTRIBUTES ||
+	    entry->data_size != sizeof(zero))
+		return false;
+	data = payload_mm_authvar_store_data(&index, entry);
+	if (data == NULL || memcmp(data, zero, sizeof(zero)) != 0)
+		return false;
+	if (record_offset != NULL)
+		*record_offset = PAYLOAD_MM_AUTHVAR_FV_HEADER_SIZE + entry->record_offset;
+	if (data_offset != NULL)
+		*data_offset = PAYLOAD_MM_AUTHVAR_FV_HEADER_SIZE + entry->data_offset;
+	return true;
+}
+
+static void self_test(const uint8_t *guid, uint32_t record_offset, uint32_t data_offset)
+{
+	uint8_t other_guid[UUID_LEN];
+	struct payload_mm_authvar_fv_geometry geometry;
+	bool attributes_refused;
+
+	assert(payload_mm_authvar_fv_geometry(&geometry, REGION_SIZE, 4096U));
+	for (size_t byte = 0U; byte < PAYLOAD_MM_FMP_STATE_WIRE_SIZE; byte++) {
+		bool data_refused;
+
+		memcpy(changed, media, sizeof(changed));
+		changed[data_offset + byte] ^= 1U;
+		data_refused = !matches(changed, guid, NULL, NULL);
+		assert(data_refused);
+	}
+	/*
+	 * Attributes are at byte four in the actual authenticated-variable header.
+	 * Adding RT keeps a valid record but must not alter the owner's attrs3.
+	 */
+	memcpy(changed, media, sizeof(changed));
+	changed[record_offset + 4U] |= 4U;
+	attributes_refused = !matches(changed, guid, NULL, NULL);
+	assert(attributes_refused);
+	for (size_t byte = 0U; byte < sizeof(other_guid); byte++) {
+		bool guid_refused;
+
+		memcpy(other_guid, guid, sizeof(other_guid));
+		other_guid[byte] ^= 1U;
+		guid_refused = !matches(media, other_guid, NULL, NULL);
+		assert(guid_refused);
+	}
+	for (size_t byte = 0U; byte < PAYLOAD_MM_AUTHVAR_FTW_WORK_HEADER_SIZE; byte++) {
+		bool workspace_refused;
+
+		memcpy(changed, media, sizeof(changed));
+		changed[geometry.working_offset + byte] ^= 1U;
+		workspace_refused = !matches(changed, guid, NULL, NULL);
+		assert(workspace_refused);
+	}
+}
+
+int main(int argc, char **argv)
+{
+	uint8_t guid[UUID_LEN];
+	uint32_t record_offset, data_offset;
+	FILE *input;
+	bool complete;
+
+	if ((argc != 3 && argc != 4) ||
+	    (argc == 4 && strcmp(argv[3], "--self-test") != 0) ||
+	    parse_uuid(guid, argv[2]) != 0)
+		return 2;
+	input = fopen(argv[1], "rb");
+	if (input == NULL)
+		return 2;
+	complete = fread(media, 1U, sizeof(media), input) == sizeof(media) &&
+		fgetc(input) == EOF && !ferror(input);
+	if (fclose(input) != 0 || !complete)
+		return 2;
+	if (!matches(media, guid, &record_offset, &data_offset))
+		return 1;
+	if (argc == 4)
+		self_test(guid, record_offset, data_offset);
+	puts("Actual producer store: exact namespace/attrs3/20B zero FmpState and clean FTW: PASS");
+	return 0;
+}
diff --git a/tests/system_fmp_core_ram_refusal_store_test.sh b/tests/system_fmp_core_ram_refusal_store_test.sh
new file mode 100755
index 0000000000..3905fa90f2
--- /dev/null
+++ b/tests/system_fmp_core_ram_refusal_store_test.sh
@@ -0,0 +1,126 @@
+#!/bin/sh
+# SPDX-License-Identifier: GPL-2.0-only
+set -eu
+
+test "$#" -eq 2 || { test "$#" -eq 3 && test "$3" = --self-test; }
+: "${COREBOOT_TREE:?actual producer codec source required}"
+: "${CBFSTOOL:?matching actual producer cbfstool required}"
+root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
+mkdir -p "$2"
+output=$(mktemp -d "$2/refusal-store.XXXXXX")
+printf 'Actual-codec refusal store artifacts: %s\n' "$output"
+compiler=${HOSTCC:-cc}
+original="$root/tests/system_fmp_core_ram_refusal_store.c"
+sources=
+for implementation in fv store record store_semantics writer default_store ftw; do
+	sources="$sources $COREBOOT_TREE/src/lib/payload_mm_authvar_$implementation.c"
+done
+sources="$sources $COREBOOT_TREE/src/lib/uuid.c $COREBOOT_TREE/src/lib/hexstrtobin.c"
+# shellcheck disable=SC2086
+sha256sum "$1" "$CBFSTOOL" "$original" "$0" "$(command -v "$compiler")" $sources \
+	> "$output/inputs-before.sha256"
+"$CBFSTOOL" "$1" read -r SMMSTORE -f "$output/store.bin" > "$output/extract.log" 2>&1
+"$CBFSTOOL" "$1" extract -n config -f "$output/producer.config" > "$output/config.log" 2>&1
+grep -qx 'CONFIG_Q35_SMM_CAPSULE_BROKER=y' "$output/producer.config"
+grep -qx 'CONFIG_PAYLOAD_MM_FMP_OWNER_AUTHVAR_BOOT=y' "$output/producer.config"
+test "$(grep -c '^CONFIG_DRIVERS_EFI_MAIN_FW_GUID=' "$output/producer.config")" -eq 1
+guid=$(sed -n 's/^CONFIG_DRIVERS_EFI_MAIN_FW_GUID="\(.*\)"$/\1/p' "$output/producer.config")
+ulimit -c 0
+export ASAN_OPTIONS=abort_on_error=1:detect_leaks=1
+export UBSAN_OPTIONS=halt_on_error=1:print_stacktrace=1
+
+codec_cc()
+{
+	oracle=$1
+	optimization=$2
+	binary=$3
+	# These aliases close actual coreboot HOST types; none grants authority.
+	# shellcheck disable=SC2086
+	"$compiler" -std=gnu11 -Wall -Wextra -Werror -g -O"$optimization" \
+		-fno-builtin -fno-pie -no-pie -fsanitize=address,undefined \
+		-fno-sanitize-recover=all -fno-omit-frame-pointer -DENV_TEST=1 \
+		-Du8=uint8_t -Du16=uint16_t -Du32=uint32_t -Du64=uint64_t \
+		-Ds32=int32_t -Ds64=int64_t \
+		-include "$COREBOOT_TREE/src/commonlib/bsd/include/commonlib/bsd/compiler.h" \
+		-I"$COREBOOT_TREE/src/commonlib/include" \
+		-I"$COREBOOT_TREE/src/commonlib/bsd/include" \
+		-idirafter "$COREBOOT_TREE/src/include" "$oracle" $sources -o "$binary"
+}
+
+for optimization in 0 2; do
+	codec_cc "$original" "$optimization" "$output/check-o$optimization" \
+		> "$output/build-o$optimization.log" 2>&1
+	"$output/check-o$optimization" "$output/store.bin" "$guid" \
+		> "$output/check-o$optimization.log" 2>&1
+	if test "$#" -eq 3; then
+		"$output/check-o$optimization" "$output/store.bin" "$guid" --self-test \
+			> "$output/self-test-o$optimization.log" 2>&1
+	fi
+done
+
+if test "$#" -eq 3; then
+	perl - "$original" "$output" <<-'PERL'
+		use strict;
+		use warnings;
+		my ($source, $output) = @ARGV;
+		open my $input, '<', $source or die $!;
+		local $/;
+		my $body = <$input>;
+		my @cases = (
+			['data', 'memcmp(data, zero, sizeof(zero)) != 0', 'false /* removed zero-state comparison */'],
+			['attributes', 'entry->attributes != PAYLOAD_MM_FMP_STATE_VARIABLE_ATTRIBUTES', 'false /* removed attrs3 comparison */'],
+			['guid', 'entry = payload_mm_authvar_store_find(&index, guid, state_name, sizeof(state_name));',
+			 "entry = NULL;\n\t(void)guid;\n\tfor (size_t candidate = 0U; candidate < index.entry_count; candidate++) {\n" .
+			 "\t\tentry = payload_mm_authvar_store_find(&index, index.entries[candidate].vendor_guid,\n" .
+			 "\t\t\tstate_name, sizeof(state_name));\n\t\tif (entry != NULL)\n\t\t\tbreak;\n\t}"],
+		);
+		my $ftw = "if (payload_mm_authvar_ftw_plan(region, REGION_SIZE, 4096U, &plan) != CB_SUCCESS ||\n" .
+			"\t    plan.action != PAYLOAD_MM_AUTHVAR_FTW_CLEAN ||\n" .
+			"\t    plan.workspace != PAYLOAD_MM_AUTHVAR_FTW_WORKSPACE_WORKING ||\n" .
+			"\t    plan.queue_disposition != PAYLOAD_MM_AUTHVAR_FTW_QUEUE_EMPTY ||\n" .
+			"\t    plan.queue_offset != PAYLOAD_MM_AUTHVAR_FTW_WORK_HEADER_SIZE ||\n" .
+			"\t    plan.queue_entry_size != 0U)";
+		push @cases, ['ftw', $ftw, 'if (false && (' . substr($ftw, 4, -1) . '))'];
+		for my $case (@cases) {
+			my ($name, $before, $after) = @$case;
+			my $changed = $body;
+			my $count = ($changed =~ s/\Q$before\E/$after/g);
+			die "$name forward count $count\n" unless $count == 1;
+			open my $mutant, '>', "$output/$name-mutant.c" or die $!;
+			print {$mutant} $changed;
+			close $mutant;
+			$count = ($changed =~ s/\Q$after\E/$before/g);
+			die "$name inverse mismatch\n" unless $count == 1 && $changed eq $body;
+			open my $inverse, '>', "$output/$name-inverse.c" or die $!;
+			print {$inverse} $changed;
+			close $inverse;
+		}
+	PERL
+	for cause in data attributes guid ftw; do
+		cmp "$original" "$output/$cause-inverse.c"
+		case "$cause" in
+			ftw) assertion=workspace_refused ;;
+			*) assertion=${cause}_refused ;;
+		esac
+		for optimization in 0 2; do
+			binary="$output/$cause-o$optimization"
+			codec_cc "$output/$cause-mutant.c" "$optimization" "$binary" \
+				> "$output/$cause-build-o$optimization.log" 2>&1
+			"$binary" "$output/store.bin" "$guid" \
+				> "$output/$cause-positive-o$optimization.log" 2>&1
+			if "$binary" "$output/store.bin" "$guid" --self-test \
+				> "$output/$cause-causal-o$optimization.log" 2>&1; then
+				echo "oracle ignored discarded $cause guard" >&2
+				exit 1
+			else
+				status=$?
+			fi
+			test "$status" -eq 134
+			grep -q "Assertion.*$assertion.*failed" "$output/$cause-causal-o$optimization.log"
+			! grep -Eq 'ERROR: AddressSanitizer|LeakSanitizer|UndefinedBehaviorSanitizer|AddressSanitizer:DEADLYSIGNAL|runtime error:' \
+				"$output/$cause-causal-o$optimization.log"
+		done
+	done
+fi
+sha256sum -c "$output/inputs-before.sha256"
+printf '%s\n' 'Actual producer refusal-store HOST oracle: PASS (no guest writes)'
