+static EFI_STATUS CDK2_MS_ABI test_hotkey_poll(void *context)
+{
+	hotkey_polls++;
+	if (EFI_ERROR(hotkey_poll_status))
+		return hotkey_poll_status;
+	if (context != NULL) {
+		key_scan_code = *(const uint16_t *)context;
+		queued_key_reads = 1U;
+	}
+	return EFI_SUCCESS;
+}
+
+static EFI_STATUS read_queued_keyboard(void *context, struct cdk2_split_key *key)
+{
+	struct cdk2_usb_keyboard_key physical;
+	EFI_STATUS status = cdk2_usb_keyboard_read(context, &physical);
+
+	if (!EFI_ERROR(status)) {
+		key->scan_code = physical.scan_code;
+		key->unicode = physical.unicode_char;
+	}
+	return status;
+}
+
+struct queued_console_input {
+	struct simple_text_input protocol;
+	struct cdk2_split_text_in splitter;
+};
+
+static EFI_STATUS CDK2_MS_ABI read_queued_splitter(void *context, struct input_key *key)
+{
+	struct queued_console_input *console = context;
+	struct cdk2_split_key candidate;
+	EFI_STATUS status = cdk2_split_text_in_read(&console->splitter, &candidate);
+
+	key_reads++;
+	if (!EFI_ERROR(status)) {
+		key->scan_code = candidate.scan_code;
+		key->unicode_char = candidate.unicode;
+	}
+	return status;
+}
