 class RunnerTests(unittest.TestCase):
+    def test_packaged_kconfig_exact_values(self):
+        full = ['# generated full config', 'CONFIG_ROUTE=y', 'CONFIG_WIDTH=0x00800000',
+                'CONFIG_PATH="/actual/Core.elf"', '# CONFIG_LEGACY is not set', 'CONFIG_DISABLED=n']
+        packed = ['# savedefconfig + derivable values', 'CONFIG_PATH="/actual/Core.elf"',
+                  'CONFIG_WIDTH=0x00800000', 'CONFIG_ROUTE=y']
+        expected = observer.config_assignments(full)
+        self.assertEqual(observer.config_assignments(packed), expected)
+        for changed in (packed + ['CONFIG_UNKNOWN=y'], packed[:-1],
+                        [line.replace('0x00800000', '0x00400000') for line in packed],
+                        [line.replace('/actual/Core.elf', '/other/Core.elf') for line in packed],
+                        [line.replace('CONFIG_ROUTE=y', 'CONFIG_ROUTE=m') for line in packed]):
+            self.assertNotEqual(observer.config_assignments(changed), expected)
+        for changed in (packed + ['CONFIG_ROUTE=y'], packed + ['CONFIG_ROUTE=n'],
+                        packed + ['# CONFIG_ROUTE is not set'], ['CONFIG_X='],
+                        ['CONFIG_X'], ['# CONFIG_X not set'], ['UNKNOWN=y']):
+            with self.assertRaises(ValueError):
+                observer.config_assignments(changed)
+
     def test_each_epoch_and_old_partial_tail(self):
         for epoch in range(4):
             observer.check_epoch(epoch, body(0) + body(epoch), records(epoch), 1073741824, b"c" * 64)
