+def config_assignments(lines):
+    """Exact Kconfig values despite the producer's documented CBFS ordering.
+
+    Makefile.mk stores savedefconfig followed by all remaining CONFIG values;
+    default disabled booleans/comments need not appear in that serialization.
+    """
+    assignments = {}
+    for line in lines:
+        value = re.fullmatch(r"(CONFIG_[A-Z0-9_]+)=(.+)", line)
+        disabled = re.fullmatch(r"# (CONFIG_[A-Z0-9_]+) is not set", line)
+        if value is not None:
+            name, setting = value.groups()
+        elif disabled is not None:
+            name, setting = disabled[1], "n"
+        elif not line or line.startswith("#") and not line.startswith("# CONFIG_"):
+            continue
+        else:
+            raise ValueError("malformed producer Kconfig entry")
+        if name in assignments:
+            raise ValueError("duplicate/conflicting producer Kconfig entry")
+        assignments[name] = setting
+    return {name: setting for name, setting in assignments.items() if setting != "n"}
+
+
 def check_epoch(index, body, records, physical_limit, capsule):
     """Independent DISK chronology; no RAM-fixture admission/oracle reuse."""
