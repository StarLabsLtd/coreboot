	help
	  Own UEFI services, dispatch firmware drivers, and enter BDS.

config CDK2_NATIVE_TCG2
	bool "Build native TPM2 measured-boot services"
	default y
	depends on CDK2_NATIVE_STAGE && CDK2_TPM2
	depends on CDK2_NATIVE_SECURITY_STUB || CDK2_LINEAR_BOOT
	select CDK2_SOFTWARE_HASH
	help
	  Publish EFI_TCG2_PROTOCOL over the TPM2 interface described by ACPI,
	  route Security2 image measurements, and import coreboot event HOBs.

config CDK2_SOFTWARE_HASH
	bool
	default y if CDK2_NATIVE_TCG2
	help
	  Admit bounded streaming SHA1/SHA256/SHA384/SHA512/SM3 hashing for
	  measured boot. Active TPM banks without a software implementation fail.

config CDK2_NATIVE_TCG2_REPLACEMENT
	bool "Replace retained TCG2 seed"
	default y if CDK2_LINEAR_BOOT
	depends on CDK2_NATIVE_TCG2
	help
	  Package the native TCG2 implementation in place of the retained seed.
	  Linear boot requires this replacement because the seed's linked TPM
	  device instance is incompatible with the coreboot handoff.

config CDK2_NATIVE_TPM2_ACPI_TABLE
	bool "Build native TPM2 ACPI table"
	default n
	depends on CDK2_NATIVE_TCG2 && CDK2_PROFILE_EXPERT_OVERRIDES
	depends on !CDK2_STRICT_DIRECT_RUNTIME
	help
	  Internal ownership marker for the native TPM2 ACPI producer.  coreboot
	  acceptance keeps this disabled because coreboot owns the TPM2 table.

config CDK2_NATIVE_CAPSULE_RUNTIME
	bool "Build native capsule runtime services" if !CDK2_COREBOOT_CAPSULE_PROFILE || CDK2_PROFILE_EXPERT_OVERRIDES
	default y if CDK2_COREBOOT_CAPSULE_PROFILE
	default y
	depends on CDK2_NATIVE_STAGE
	depends on !CDK2_CAPSULE_ACCEPT_EMBEDDED_DRIVERS
	help
	  Publish capsule query and update runtime services after variable write
	  services become available.

config CDK2_NATIVE_SYSTEM_FMP
	bool
	default y if CDK2_COREBOOT_CAPSULE_PROFILE
	depends on CDK2_NATIVE_STAGE && CDK2_NATIVE_CAPSULE_RUNTIME && CDK2_ESRT
	depends on !CDK2_NATIVE_QEMU_TEST_FMP
	help
	  Build the source-owned production FMP adapter. It authenticates the EFI
	  capsule against the profile's pinned public StarLabs trust set, validates
	  the MSS1 payload, binds the candidate image to coreboot identity, and
	  invokes only the typed protected coreboot broker. The same payload binary
	  discovers identity, geometry and transport at runtime and fails closed
	  unless coreboot publishes every required protected capability.

config CDK2_QEMU_ACCEPTANCE_PROFILE
	bool "Enable automated QEMU acceptance firmware"
	default n
	depends on CDK2_NATIVE_STAGE && CDK2_ESRT
	depends on CDK2_CPU_VENDOR_INTEL
	depends on CDK2_COREBOOT_CAPSULE_PROFILE
	select DRIVERS_EFI_CAPSULE_ON_DISK_SUPPORT
	select CDK2_NATIVE_QEMU_TEST_FMP
	help
	  Enable firmware fixtures used only by automated QEMU acceptance tests.
	  This profile must never be enabled for hardware or production images.

config CDK2_NATIVE_QEMU_TEST_FMP
	bool
	depends on CDK2_NATIVE_STAGE && CDK2_NATIVE_CAPSULE_RUNTIME && CDK2_ESRT
	help
	  Build the default-off QEMU-only firmware-management acceptance fixture.
	  Its public test trust anchor must never be enabled in production images.

config CDK2_QEMU_TEST_FMP_IMAGE_GUID
	string
	default "00112233-4455-6677-8899-aabbccddeeff"
	depends on CDK2_NATIVE_QEMU_TEST_FMP

config CDK2_DEBUG
	bool "Enable the CDK2 debug profile"
	default n
	depends on CDK2_CONSOLE
	select CDK2_BUILD_DEBUG
	select CDK2_SERIAL
	select CDK2_CBMEM_CONSOLE
	select CDK2_CBMEM_TIMESTAMPS
	help
	  Build a debug payload and route its diagnostics to serial, the coreboot
	  CBMEM console, and (when supported by coreboot) the persistent SPI
	  console. Also publish payload timestamps in CBMEM. This is the CDK2
	  equivalent of coreboot's EDK2_DEBUG profile; one option enables every
	  diagnostic sink needed to capture a hardware boot.

config CDK2_BUILD_DEBUG
	bool
	default n
	depends on CDK2_PAYLOAD

config CDK2_SMMSTORE
	bool "Use coreboot SMMSTORE variables"
	default y
	depends on CDK2_COREBOOT_OWNS_SMM
	help
	  Use the coreboot SMMSTORE implementation through coreboot's locked SMM
	  service. This does not transfer ownership of SMRAM to the payload, and
	  therefore does not select the native CDK2 SMM stack.

config CDK2_EC_ACPI_BATTERY_PROFILE
	int "EC ACPI battery profile"
	range 0 5
	default 0
	depends on CDK2_PAYLOAD
	help
	  Select the EC battery status profile consumed by the cdk2 ACPI battery
	  status driver: 0 probes, 1 selects Chrome EC, 2 selects Merlin, and 3
	  selects ThinkPad, 4 preserves the legacy ThinkPad selection, and 5
	  selects a genuine Smart Battery System word-command transport.
	  coreboot board Kconfig owns the value for integrated builds.

