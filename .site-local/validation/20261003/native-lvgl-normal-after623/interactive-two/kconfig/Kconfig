config CDK2_PROTECTED_VARIABLE_RUNTIME
	bool "Use coreboot's protected variable owner"
	default n
	depends on CDK2_NATIVE_STAGE && CDK2_COREBOOT_OWNS_SMM
	depends on PAYLOAD_MM_AUTHVAR_SERVICE_ROUTE_ATTESTED
	depends on !CDK2_SECURE_BOOT
	help
	  Publish the existing protected and volatile variable namespace through
	  the native runtime driver. coreboot owns the sole nonvolatile backend;
	  cdk2 owns only empty volatile RAM banks. A missing or invalid service
	  endpoint fails driver installation without falling back to FVB or FTW.
	  This selection does not grant resumed S3 authority. Boot requires the
	  source-closed native linear composition, an actual GENERAL-capable
	  protected endpoint and the real deny-capable Security2 authorizer.
	  Missing owner, policy or required driver capabilities fail initialization
	  before OS dispatch, without legacy FVB or unprotected RAM fallback.

config CDK2_NATIVE_VARIABLE_RUNTIME
	bool "Build native variable runtime driver" if !CDK2_COREBOOT_CAPSULE_PROFILE || CDK2_PROFILE_EXPERT_OVERRIDES
	default y if CDK2_COREBOOT_CAPSULE_PROFILE
	default y
	depends on CDK2_NATIVE_STAGE
	depends on CDK2_PROTECTED_VARIABLE_RUNTIME || (CDK2_NATIVE_FTW && CDK2_NATIVE_SMMSTORE_FVB)
	depends on !CDK2_SECURE_BOOT
	help
	  Publish UEFI variable runtime services through the selected protected
	  coreboot owner, or through FVB and FTW in the legacy composition.
	  Legacy Secure Boot builds retain their authenticated variable driver;
	  the protected native route consumes coreboot authentication and policy.

