	string "Capsule system firmware FMP GUID"
	default ""
	depends on CDK2_CAPSULE
	depends on !CDK2_COREBOOT_CAPSULE_PROFILE
	help
	  Compatibility GUID assigned to a system-firmware ESRT entry when no
	  coreboot-owned native SystemFmp provider supplies its identity at runtime.

config DRIVERS_EFI_CAPSULE_ON_DISK_SUPPORT
	bool "Support EFI capsules on disk"
	depends on CDK2_CAPSULE
	select CDK2_STORAGE
	select CDK2_NATIVE_DEVICE_PATH if !CDK2_STRICT_DIRECT_RUNTIME
	select CDK2_NATIVE_ENGLISH
	select CDK2_NATIVE_DISK_IO
	select CDK2_NATIVE_PARTITION
	select CDK2_NATIVE_PCI_HOST_BRIDGE
	select CDK2_NATIVE_FAT
	select CDK2_NATIVE_BDS if !CDK2_LINEAR_BOOT || CDK2_PROFILE_EXPERT_OVERRIDES
	help
	  This is coreboot's public capsule-on-disk policy, imported unchanged by
	  the payload boundary instead of mirrored by a CDK2-specific option. It
	  includes the generic disk, partition, and FAT stack but leaves NVMe, USB,
	  ATA, and SD transports to board policy.

config CDK2_NATIVE_CAPSULE_DISK_SCANNER
	bool
	default y
	depends on CDK2_NATIVE_STAGE
	depends on DRIVERS_EFI_CAPSULE_ON_DISK_SUPPORT || CDK2_COREBOOT_CAPSULE_PROFILE
	help
	  Build the native deterministic capsule-on-disk scanner. Storage and
	  filesystem protocol adapters are selected separately.

config CDK2_CAPSULE_ACCEPT_EMBEDDED_DRIVERS
	bool "Allow embedded drivers in update capsules"
	default n
	depends on CDK2_CAPSULE && !CDK2_LINEAR_BOOT
	depends on !CDK2_COREBOOT_CAPSULE_PROFILE || CDK2_PROFILE_EXPERT_OVERRIDES
	help
	  Permit FMP capsules to carry embedded DXE drivers.

config CDK2_CAPSULE_EMBED_FMP_DXE
	bool "Embed FmpDxe in generated capsules"
	default n
	depends on CDK2_CAPSULE && (!CDK2_COREBOOT_CAPSULE_PROFILE || CDK2_PROFILE_EXPERT_OVERRIDES)
	select CDK2_CAPSULE_ACCEPT_EMBEDDED_DRIVERS
	help
	  Embed the FmpDxe driver in generated update capsules instead of keeping
	  it in the payload FV.

