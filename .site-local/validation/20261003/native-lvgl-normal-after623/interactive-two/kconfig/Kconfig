	default 0x16
	depends on CDK2_NATIVE_EC_BATTERY

config CDK2_EC_BATTERY_SBS_WORD_READ_COMMAND
	hex "EC command that performs an SBS Read Word transaction"
	default 0
	depends on CDK2_NATIVE_EC_BATTERY
	help
	  Platform-specific EC command that accepts one Smart Battery command and
	  returns its little-endian 16-bit result.  Zero deliberately disables the
	  SBS profile: the standard ACPI EC 0x80 command is only a byte read and is
	  not falsely treated as an SBS transport.

