	depends on CDK2_BUILD_DEBUG && CDK2_CBMEM_CONSOLE
	default y if CDK2_BUILD_DEBUG && CDK2_CBMEM_CONSOLE
	help
	  Persist debug diagnostics through coreboot's versioned SMM SPI-console
	  service after first appending the same record to CBMEM.

config CDK2_DIAGNOSTIC
	bool
	default y if CDK2_BUILD_DEBUG || CDK2_CBMEM_CONSOLE
	help
	  Build the diagnostic transport whenever either the debug serial sink or
	  the release-safe coreboot CBMEM sink is enabled.

config CDK2_CBMEM_TIMESTAMPS
	bool "Publish payload timestamps through CBMEM"
	default n
	depends on CDK2_PAYLOAD
	help
	  Record cdk2 entry, HOB, DXE load, and handoff timestamps in the
	  coreboot CBMEM timestamp table.

