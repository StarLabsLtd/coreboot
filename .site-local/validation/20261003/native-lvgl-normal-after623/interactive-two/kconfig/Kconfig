config PAYLOAD_MM_AUTHVAR_SERVICE_ROUTE_ATTESTED
	bool
	default y

# SPDX-License-Identifier: GPL-2.0-only

menu "cdk2 payload"

config CDK2_PAYLOAD
	bool "Build the cdk2 coreboot payload"
	default y
	help
	  Select the payload composition used by the private cdk2 fork.
	  coreboot remains the owner of platform policy; this option only
	  describes the payload build consumed by coreboot. In particular,
	  coreboot owns MTRR programming; cdk2 may validate the effective cache
	  policy but must not replace it.

config PAYLOAD_DMA_HANDOFF
	bool "Consume coreboot DMA-protection handoff"
	default n
	depends on CDK2_PAYLOAD
	help
	  Import coreboot's resolved DMA-handoff policy without mirroring it in a
	  private payload option. When enabled, cdk2 validates and retains the
	  already-active protection handoff. It does not grant bus mastering.

config PAYLOAD_MM_AUTHVAR_SERVICE_ROUTE_ATTESTED
	bool
	default n
	help
	  Import coreboot's actual authenticated-variable service route selection.
	  This is not an authority grant from a payload-local option or table flag.

config CDK2_PCI
	bool "Include PCI support"
	default y
	depends on CDK2_PAYLOAD

config CDK2_STORAGE
	bool "Include storage support"
	default y
	depends on CDK2_PCI

config CDK2_CONSOLE
	bool "Include console support"
	default y
	depends on CDK2_PAYLOAD

config CDK2_GRAPHICS
	bool "Include graphics support"
	default y
	depends on CDK2_CONSOLE && CDK2_PCI

config CDK2_GOP_HIDPI
	bool "Enable high-DPI GOP scaling"
	default n
	depends on CDK2_GRAPHICS
	help
	  Expose a 2x scaled GOP mode for high-DPI framebuffers handed off by
	  coreboot.

config CDK2_GOP_HIDPI_H_THRESHOLD
	int "High-DPI GOP horizontal threshold"
	range 0 2147483647
	default 1920
	depends on CDK2_GOP_HIDPI

config CDK2_GOP_HIDPI_V_THRESHOLD
	int "High-DPI GOP vertical threshold"
	range 0 2147483647
	default 1080
	depends on CDK2_GOP_HIDPI

config CDK2_GOP_HIDPI_ASPECT_CAP
	bool "Cap wide high-DPI GOP viewports"
	default n
	depends on CDK2_GOP_HIDPI
	help
	  Center the scaled GOP viewport inside framebuffers wider than the
	  configured aspect ratio.

config CDK2_GOP_HIDPI_ASPECT_W
	int "High-DPI GOP aspect width"
	range 1 2147483647
	default 16
	depends on CDK2_GOP_HIDPI_ASPECT_CAP

config CDK2_GOP_HIDPI_ASPECT_H
	int "High-DPI GOP aspect height"
	range 1 2147483647
	default 9
	depends on CDK2_GOP_HIDPI_ASPECT_CAP

config CDK2_SETUP_UI
	bool "Include the firmware setup UI"
	default y
	depends on CDK2_CONSOLE
	help
	  Include the firmware boot and setup surface. The native LVGL setup
	  form reads and writes its typed settings directly through runtime
	  services; no HII form package or browser is involved.
	  Disable this only for payloads that provide their own setup surface.

config CDK2_LVGL_RENDERER
	bool "Use the LVGL graphical setup renderer"
	default n
	depends on CDK2_SETUP_UI && CDK2_GRAPHICS
	help
	  Render the typed native setup form and boot menu through LVGL.

config CDK2_NATIVE_LVGL_SETUP
	bool "Include the native LVGL setup form"
	default y
	depends on CDK2_LVGL_RENDERER
	depends on !CDK2_STRICT_DIRECT_RUNTIME || CDK2_NATIVE_BDS
	help
	  Include the native graphical settings model, renderer protocol and
	  transactional runtime-variable storage used by BDS.

config CDK2_CONNECT_ALL_DEVICES
	bool "Connect every device before boot"
	default n
	depends on CDK2_PAYLOAD
	help
	  Connect all boot-service devices before selecting a boot option. The
	  default selective policy connects the chosen internal path and falls
	  back to removable media discovery only when needed.

config CDK2_ESRT
	bool "Include ESRT support"
	default y
	depends on CDK2_PAYLOAD

config CDK2_COREBOOT_CAPSULE_PROFILE
	bool "Use the coreboot capsule-update profile"
	default n
	depends on CDK2_CONSOLE && CDK2_PCI
	select CDK2_COREBOOT_OWNS_SMM
	select CDK2_CAPSULE_SMM_BACKEND
	select CDK2_SMMSTORE
	select CDK2_ESRT
	select CDK2_GRAPHICS
	select CDK2_CAPSULE
	select CDK2_NATIVE_STAGE
	select CDK2_STORAGE
	select CDK2_NATIVE_ENGLISH
	select CDK2_NATIVE_DISK_IO
	select CDK2_NATIVE_PARTITION
	select CDK2_NATIVE_PCI_HOST_BRIDGE
	select CDK2_NATIVE_FAT
	select CDK2_NATIVE_SMMSTORE_FVB if !CDK2_PROTECTED_VARIABLE_RUNTIME
	select CDK2_NATIVE_FTW if !CDK2_PROTECTED_VARIABLE_RUNTIME
	help
	  Internal profile selected by coreboot's public CDK2 capsule-update
	  policy. It derives the complete supported SMMSTORE, ESRT, variable,
	  capsule-runtime, and capsule-on-disk pairing.

config CDK2_COREBOOT_OWNS_SMM
	bool
	default y
	help
	  coreboot owns and locks SMRAM and provides the SMM services consumed by
	  this payload. Native payload SMM modules must not be built or dispatched.

config CDK2_STRICT_DIRECT_RUNTIME
	bool
	default y if CDK2_LINEAR_BOOT && CDK2_COREBOOT_CAPSULE_PROFILE && \
		!CDK2_SECURE_BOOT && CDK2_COREBOOT_OWNS_SMM && \
		!CDK2_PROFILE_EXPERT_OVERRIDES
	help
	  Derived identity for the supported source-closed payload composition.
	  Other profiles are available for isolated component tests only; they
	  cannot produce a payload image or select a firmware-volume fallback.

config CDK2_LINEAR_BOOT
	bool
	default y
	depends on CDK2_NATIVE_STAGE && CDK2_NATIVE_DXE_CORE && CDK2_PCI && CDK2_STORAGE && CDK2_GRAPHICS
	select CDK2_CBMEM_TIMESTAMPS
	select CDK2_NATIVE_ACPI_TABLE
	select CDK2_NATIVE_DISK_IO
	select CDK2_NATIVE_PARTITION
	select CDK2_NATIVE_ENGLISH
	select CDK2_NATIVE_FAT
	select CDK2_NATIVE_CAPSULE_RUNTIME
	select CDK2_NATIVE_SECURITY_STUB if !CDK2_SECURE_BOOT
	help
	  Run payload initialization as one explicit phase sequence beginning at
	  the validated coreboot handoff. The native prefix draws the splash before
	  HOB or DXE construction and passes a fail-closed continuation record to
	  DxeCore. Later phases must resume that record without skips or reordering.
	  Phase boundaries are recorded in coreboot's CBMEM timestamp table.
	  Interactive input is disabled unless CDK2_LINEAR_SETUP_HOTKEY explicitly
	  selects the bounded, synchronous native setup surface.
	  This is the only supported payload startup. Disabling a prerequisite
	  leaves component tests available but rejects payload construction; it
	  does not select the retired generic DXE/BDS startup.

config CDK2_LINEAR_BDS_FAILOVER
	bool "Use standard BootOrder with removable-media fallback"
	default n
	depends on CDK2_LINEAR_BOOT && CDK2_NATIVE_BDS
	help
	  Hand the initialized platform to the native boot manager, which consumes
	  BootNext and BootOrder before trying the standard removable-media path.
	  This matches normal UEFI boot policy while preserving linear hardware
	  initialization and keeping EFI/BOOT/BOOTX64.EFI as a recovery fallback.

config CDK2_LINEAR_SETUP_HOTKEY
	bool "Enter native setup from the linear boot path"
	default n
	depends on CDK2_LINEAR_BDS_FAILOVER && CDK2_SETUP_UI
	depends on CDK2_NATIVE_LVGL_SETUP
	help
	  Poll synchronously for F2 during the bounded boot-menu timeout, enter the
	  native typed LVGL form, then return to the linear OS handoff. No generic
	  BDS boot pass or asynchronous dispatcher is entered.

config CDK2_PROFILE_EXPERT_OVERRIDES
	bool "Allow expert overrides of the coreboot CDK2 profile"
	default n
	depends on CDK2_COREBOOT_CAPSULE_PROFILE
	help
	  Expose payload-internal migration controls for development. Production
	  coreboot pairings should leave this disabled.

config CDK2_NATIVE_STAGE
	bool "Build the native cdk2 stage"
	default y
	depends on CDK2_PAYLOAD
	help
	  Build the freestanding C/linker stage used by the direct coreboot
	  handoff. The native stage owns HOB construction and the coreboot entry
	  flow.

config CDK2_NATIVE_SECURITY_STUB
	bool "Build native Security2 policy routing services"
	default n
	depends on CDK2_NATIVE_STAGE && !CDK2_SECURE_BOOT
	help
	  Publish Security and Security2 architectural protocols and route bounded
	  image-policy callbacks. Strict linear non-Secure-Boot profiles select this
	  source-owned implementation; Secure Boot retains its verification owner.

config CDK2_AUTHVAR_PRESENCE_LIFECYCLE_CLOSE_COMPOSITION
	bool
	default y if CDK2_STRICT_DIRECT_RUNTIME && PAYLOAD_DMA_HANDOFF
	depends on CDK2_NATIVE_STAGE && CDK2_LINEAR_BOOT
	depends on CDK2_STRICT_DIRECT_RUNTIME && CDK2_COREBOOT_OWNS_SMM
	depends on CDK2_NATIVE_SECURITY_STUB && PAYLOAD_DMA_HANDOFF
	help
	  Always link the portable authenticated-variable presence consumer into a
	  strict direct payload when coreboot's PAYLOAD_DMA_HANDOFF policy is
	  enabled. A stable coreboot table with neither endpoint leaves the feature
	  unavailable. A partial, duplicate or malformed pair fails the boot closed.
	  A valid pair binds its native clients to the first Security2-authenticated
	  boot-policy image.

config CDK2_NULL_MEMORY_TEST
	bool "Build the native null memory-test driver"
	default y
	depends on CDK2_PAYLOAD && (!CDK2_LINEAR_BOOT || CDK2_NATIVE_BDS)
	help
	  Install the Generic Memory Test Protocol and promote initialized coreboot
	  memory without running a destructive firmware memory test in BDS
	  compatibility profiles. Strict linear boot does not invoke this protocol.
	  Disabling it omits the optional protocol; BDS accepts its absence.

