+
+for mutation in request-bit request-attributes request-consume; do
+	case "$mutation" in
+	request-bit)
+		needle='return (*indications & 4ULL) != 0U ? EFI_SUCCESS : EFI_NOT_FOUND;'
+		replacement='return EFI_SUCCESS;'
+		expected='unrequested or malformed disk request has no filesystem or writer side effects' ;;
+	request-attributes)
+		needle='if (size != sizeof(*indications) || attributes != 7U)'
+		replacement='if (size != sizeof(*indications))'
+		expected='actual disk request missing or malformed disposition' ;;
+	request-consume)
+		needle='indications &= ~4ULL;'
+		replacement='indications |= 4ULL;'
+		expected='loaded disk request consumes only bit4 through real variable callback' ;;
+	esac
+	original_line=$(awk -v needle="$needle" '
+		index($0, needle) { matches++; selected = NR }
+		END { if (matches != 1) exit 1; print selected }
+	' "$root/src/modules/dxe_core/entry.c")
+	awk -v needle="$needle" -v replacement="$replacement" '
+		index($0, needle) {
+			matches++;
+			position = index($0, needle);
+			$0 = substr($0, 1, position - 1) replacement substr($0, position + length(needle));
+		}
+		{ print }
+		END { if (matches != 1) exit 1 }
+	' "$root/src/modules/dxe_core/entry.c" > "$temporary/$mutation.c"
+	awk -v selected="$original_line" -v needle="$replacement" -v replacement="$needle" '
+		NR == selected {
+			matches++;
+			position = index($0, needle);
+			if (position == 0) exit 1;
+			$0 = substr($0, 1, position - 1) replacement substr($0, position + length(needle));
+		}
+		{ print }
+		END { if (matches != 1) exit 1 }
+	' "$temporary/$mutation.c" > "$temporary/$mutation-reversed.c"
+	cmp "$root/src/modules/dxe_core/entry.c" "$temporary/$mutation-reversed.c"
+	compile_test "$temporary/$mutation.c" "$temporary/mutant"
+	status=0
+	"$temporary/mutant" > "$temporary/mutant.log" 2>&1 || status=$?
+	test "$status" -eq 1
+	grep -F "FAIL: $expected" "$temporary/mutant.log" >/dev/null
+	if grep -Eq 'AddressSanitizer|LeakSanitizer|UndefinedBehaviorSanitizer|runtime error:' "$temporary/mutant.log"; then
+		exit 1
+	fi
+	echo "DXE $mutation exact-source mutation: PASS"
