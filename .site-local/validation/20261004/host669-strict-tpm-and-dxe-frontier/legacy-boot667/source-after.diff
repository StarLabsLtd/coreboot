+static uint32_t read_le32(const uint8_t *bytes)
+{
+	return (uint32_t)bytes[0] | (uint32_t)bytes[1] << 8 |
+		(uint32_t)bytes[2] << 16 | (uint32_t)bytes[3] << 24;
+}
+
+static int variable_record_matches(const struct cdk2_tcg2_logs *logs,
+	const struct mock *mock, TPM_PCRINDEX pcr, uint32_t event_type,
+	const uint8_t *payload, uint32_t payload_size)
+{
+	const uint8_t *record = logs->main.buffer + logs->main.last_entry_offset;
+	uint32_t expected_size = 16U + payload_size;
+	uint32_t offset = 12U;
+	uint32_t index;
+
+	for (index = 0; index < ARRAY_SIZE(variable_kats); index++)
+		expected_size += 2U + variable_kats[index].size;
+	if (logs->main.used - logs->main.last_entry_offset != expected_size ||
+	    read_le32(record) != pcr || read_le32(record + 4) != event_type ||
+	    read_le32(record + 8) != ARRAY_SIZE(variable_kats))
+		return 0;
+	for (index = 0; index < ARRAY_SIZE(variable_kats); index++) {
+		if (record[offset] != (uint8_t)variable_kats[index].algorithm ||
+		    record[offset + 1] != (uint8_t)(variable_kats[index].algorithm >> 8) ||
+		    memcmp(record + offset + 2, mock->last_digests[index].bytes,
+			variable_kats[index].size) != 0)
+			return 0;
+		offset += 2U + variable_kats[index].size;
+	}
+	return read_le32(record + offset) == payload_size &&
+		memcmp(record + offset + 4, payload, payload_size) == 0;
+}
