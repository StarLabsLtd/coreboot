diff --git a/src/boot/coreboot_test.c b/src/boot/coreboot_test.c
index ad39ccd157..5602ef5a0b 100644
--- a/src/boot/coreboot_test.c
+++ b/src/boot/coreboot_test.c
@@ -3005,6 +3005,146 @@ static int test_capsule_delivery_policy_import(void)
 	return failures;
 }
 
+static int test_serial_unique_authority(void)
+{
+	uint8_t storage[TEST_TABLE_SIZE] __aligned(8);
+	uint8_t hobs[TEST_TABLE_SIZE] __aligned(8);
+	uint8_t saved_hobs[TEST_TABLE_SIZE];
+#if CONFIG_CDK2_SERIAL
+	uint8_t console_storage[sizeof(struct cdk2_cbmem_console) + 128U] __aligned(8);
+	struct cdk2_cbmem_console *console = (void *)console_storage;
+	struct cdk2_diag_config diagnostic;
+	struct cdk2_diag_config before, after;
+#endif
+	struct cdk2_coreboot_handoff handoff;
+	EFI_HOB_HANDOFF_INFO_TABLE *hob;
+	struct cb_serial serial[2];
+	EFI_STATUS status;
+	int failures = 0;
+
+	for (unsigned int scenario = 0U; scenario < 7U; scenario++) {
+		struct cb_header *header = (void *)storage;
+		size_t bytes;
+		uint32_t count;
+		EFI_STATUS expected = EFI_SUCCESS;
+
+		if (scenario > 1U)
+			expected = EFI_COMPROMISED_DATA;
+
+		build_memory_table(storage, sizeof(storage));
+		bytes = header->table_bytes;
+		count = header->table_entries;
+		serial[0] = (struct cb_serial) {
+			.tag = CB_TAG_SERIAL, .size = CDK2_COREBOOT_SERIAL_MIN_SIZE,
+			.type = CB_SERIAL_TYPE_IO_MAPPED, .baseaddr = 0x3f8U,
+			.baud = 115200U, .regwidth = 1U,
+		};
+		serial[1] = serial[0];
+		if (scenario == 3U)
+			serial[1].baseaddr = 0x2f8U;
+		if (scenario == 4U)
+			serial[0].baseaddr = 0x2f8U;
+		if (scenario == 5U)
+			serial[1].size = sizeof(struct cb_record);
+		if (scenario == 6U)
+			serial[0].size = sizeof(struct cb_record);
+		for (unsigned int index = 0U; index < (scenario > 1U ? 2U : scenario);
+		     index++) {
+			memcpy(storage + sizeof(*header) + bytes, &serial[index],
+				serial[index].size);
+			bytes += serial[index].size;
+			count++;
+		}
+		finalize_table(storage, sizeof(storage), bytes, count);
+		status = cdk2_coreboot_parse_table(storage, sizeof(*header) + bytes,
+			&handoff);
+		failures += expect(status == EFI_SUCCESS,
+			"unique UART authority fixture parse failed");
+		if (EFI_ERROR(status))
+			continue;
+		handoff.memory_ranges[handoff.memory_range_count++] =
+			(struct cdk2_coreboot_memory_range) {
+				.base = (UINTN)hobs, .size = sizeof(hobs), .type = CB_MEM_RAM,
+			};
+		memset(hobs, 0, sizeof(hobs));
+		status = cdk2_coreboot_build_hobs(&handoff, hobs, hobs + sizeof(hobs),
+			hobs, hobs + sizeof(hobs), FALSE, (void **)&hob);
+		failures += expect(status == EFI_SUCCESS,
+			"unique UART authority base HOB construction failed");
+		if (EFI_ERROR(status))
+			continue;
+		memcpy(saved_hobs, hobs, sizeof(hobs));
+		status = cdk2_coreboot_test_append_serial_hobs(hob, &handoff);
+		failures += expect(status == expected,
+			"serial HOB producer did not enforce unique UART authority");
+		if (scenario != 1U)
+			failures += expect(memcmp(saved_hobs, hobs, sizeof(hobs)) == 0,
+				"absent or ambiguous UART published a serial device HOB");
+		memcpy(hobs, saved_hobs, sizeof(hobs));
+#if !CONFIG_CDK2_SERIAL
+		const EFI_HOB_GUID_TYPE *diagnostic_hob = (void *)(UINTN)hob->efi_end_of_hob_list;
+
+		expected = EFI_SUCCESS;
+#endif
+		status = cdk2_coreboot_test_append_diagnostic_hob(hob, &handoff);
+		failures += expect(status == expected,
+			"diagnostic HOB producer did not enforce unique UART authority");
+#if !CONFIG_CDK2_SERIAL
+		if (status == EFI_SUCCESS) {
+			const struct cdk2_diag_handoff *info = (const void *)(diagnostic_hob + 1);
+
+			failures += expect(diagnostic_hob->header.hob_type ==
+				EFI_HOB_TYPE_GUID_EXTENSION && diagnostic_hob->header.hob_length ==
+				sizeof(*diagnostic_hob) + sizeof(*info) &&
+				memcmp(&diagnostic_hob->name, &cdk2_diag_handoff_guid,
+					sizeof(diagnostic_hob->name)) == 0 &&
+				info->serial_type == 0U && info->register_base == 0U &&
+				info->register_width == 0U && info->register_stride == 0U &&
+				info->baud_rate == 0U && info->input_hertz == 0U,
+				"disabled diagnostic console exported a UART tuple");
+		}
+#else
+		if (scenario <= 1U)
+			continue;
+		failures += expect(memcmp(saved_hobs, hobs, sizeof(hobs)) == 0,
+			"ambiguous UART published a diagnostic HOB");
+		memset(console_storage, 0, sizeof(console_storage));
+		console->size = 128U;
+		diagnostic = (struct cdk2_diag_config) {
+			.cbmem_console = console, .cbmem_console_bytes = sizeof(console_storage),
+		};
+		cdk2_diag_configure(&diagnostic);
+		cdk2_diag_test_snapshot_config(&before);
+		status = cdk2_coreboot_test_validate_handoff((UINTN)storage);
+		cdk2_diag_test_snapshot_config(&after);
+		failures += expect(status == EFI_COMPROMISED_DATA,
+			"early handoff did not refuse ambiguous UART before DMA admission");
+		failures += expect(after.putc == before.putc &&
+			after.putc_context == before.putc_context &&
+			after.putc_provenance == before.putc_provenance &&
+			after.cbmem_console == before.cbmem_console &&
+			after.cbmem_console_bytes == before.cbmem_console_bytes &&
+			after.timestamps == before.timestamps &&
+			after.timestamp_bytes == before.timestamp_bytes &&
+			after.clock == before.clock && after.clock_context == before.clock_context &&
+			after.clock_hz == before.clock_hz &&
+			after.spi_console_buffer == before.spi_console_buffer &&
+			after.spi_console_buffer_bytes == before.spi_console_buffer_bytes &&
+			after.spi_console_max_chunk == before.spi_console_max_chunk &&
+			after.spi_console_boot_limit == before.spi_console_boot_limit &&
+			after.spi_console_apm_cmd == before.spi_console_apm_cmd &&
+			after.spi_console_remaining == before.spi_console_remaining &&
+			after.owner == before.owner && after.owner_context == before.owner_context &&
+			after.emission_owner == before.emission_owner,
+			"ambiguous UART replaced the admitted diagnostic configuration");
+		failures += expect(console->cursor == 0U,
+			"ambiguous UART emitted before authority admission");
+		cdk2_diag_runtime_transition();
+#endif
+	}
+	return failures;
+}
+
 int main(void)
 {
 	UINT8 storage[TEST_TABLE_SIZE];
@@ -3122,6 +3262,7 @@ int main(void)
 	int failures;
 
 	failures = test_boot_splash_short_bmp();
+	failures += test_serial_unique_authority();
 	failures += test_capsule_delivery_policy_import();
 #if defined(CDK2_COREBOOT_SPLASH_LENGTH_TEST_ONLY)
 	if (!failures)
