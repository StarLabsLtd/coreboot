+static size_t focus_outline_pixels(const uint32_t *pixels, const lv_area_t *area)
+{
+	size_t count = 0U;
+
+	/* Count the contrasting outline outside the control, not its caption/check. */
+	for (int y = area->y1 - 4; y <= area->y2 + 4; y++)
+		for (int x = area->x1 - 4; x <= area->x2 + 4; x++) {
+			if (x < 0 || y < 0 || x >= (int)TEST_FRAMEBUFFER_WIDTH ||
+			    y >= (int)TEST_FRAMEBUFFER_HEIGHT ||
+			    (x >= area->x1 && x <= area->x2 &&
+			     y >= area->y1 && y <= area->y2))
+				continue;
+			count += (pixels[y * TEST_FRAMEBUFFER_WIDTH + x] & 0xffffffU)
+				== 0x10141cU;
+		}
+	return count;
+}
+
+static void verify_initial_focus(lv_obj_t *control)
+{
+	lv_area_t focused_area, unfocused_area;
+	size_t focused_pixels, unfocused_pixels;
+
+	assert(lv_group_get_focused(session_group) == control);
+	assert(lv_obj_has_state(control, LV_STATE_FOCUSED));
+	lv_obj_get_coords(control, &focused_area);
+	focused_pixels = focus_outline_pixels(framebuffer, &focused_area);
+	assert(focused_pixels != 0U);
+	/* Compare with an actual LVGL defocus redraw of the same control pane. */
+	assert(lv_obj_send_event(control, LV_EVENT_DEFOCUSED, session_pointer) ==
+		LV_RESULT_OK);
+	lv_refr_now(session_display);
+	lv_obj_get_coords(control, &unfocused_area);
+	assert(!lv_obj_has_state(control, LV_STATE_FOCUSED));
+	unfocused_pixels = focus_outline_pixels(framebuffer, &unfocused_area);
+	assert(focused_pixels > unfocused_pixels);
+	lv_group_focus_obj(control);
+	lv_refr_now(session_display);
+	assert(lv_obj_has_state(control, LV_STATE_FOCUSED));
+	lv_obj_get_coords(control, &focused_area);
+	assert(focus_outline_pixels(framebuffer, &focused_area) > unfocused_pixels);
+}
+
+static void verify_focus_move(uint16_t scan, lv_obj_t *from, lv_obj_t *to)
+{
+	lv_area_t from_before, to_before, from_after, to_after;
+
+	assert(lv_group_get_focused(session_group) == from);
+	assert(lv_obj_has_state(from, LV_STATE_FOCUSED));
+	lv_obj_get_coords(from, &from_before);
+	lv_obj_get_coords(to, &to_before);
+	memcpy(focus_framebuffer, framebuffer, sizeof(framebuffer));
+	requested_scan = scan;
+	key_sent = FALSE;
+	active_menu->complete = FALSE;
+	poll_key(active_menu, session_group);
+	requested_scan = 0U;
+	lv_refr_now(session_display);
+	lv_obj_get_coords(from, &from_after);
+	lv_obj_get_coords(to, &to_after);
+	assert(!active_menu->complete && lv_group_get_focused(session_group) == to);
+	assert(!lv_obj_has_state(from, LV_STATE_FOCUSED));
+	assert(lv_obj_has_state(to, LV_STATE_FOCUSED));
+	assert(lv_obj_get_style_outline_width(to, LV_PART_MAIN) == 2);
+	assert(lv_obj_get_style_outline_opa(to, LV_PART_MAIN) == LV_OPA_COVER);
+	assert(focus_outline_pixels(focus_framebuffer, &from_before) >
+		focus_outline_pixels(framebuffer, &from_after));
+	assert(focus_outline_pixels(framebuffer, &to_after) >
+		focus_outline_pixels(focus_framebuffer, &to_before));
+}
+
+static void verify_keyboard_focus(const struct cdk2_lvgl_form *original)
+{
+	static const CHAR16 next_help[] = L"Next help";
+	struct cdk2_lvgl_statement statements[3] = {
+		original->statements[0], original->statements[0], original->statements[0],
+	};
+	struct cdk2_lvgl_form form = *original;
+	UINT16 question;
+	INTN adjustment;
+	lv_obj_t *checkbox, *numeric, *done, *disabled;
+
+	statements[1].kind = CDK2_LVGL_NUMERIC;
+	statements[1].question_id = 43U;
+	statements[1].help = next_help;
+	statements[2].disabled = TRUE;
+	form.statements = statements;
+	form.statement_count = ARRAY_SIZE(statements);
+	key_sent = FALSE;
+	assert(ui_protocol.show_form(&ui_protocol, &form, &question, &adjustment) ==
+		EFI_SUCCESS && question == 42U);
+	assert(active_menu->focus_count == 3U && session_pointer != NULL);
+	assert(lv_indev_get_type(session_pointer) == LV_INDEV_TYPE_POINTER);
+	checkbox = active_menu->focus_objects[0];
+	numeric = active_menu->focus_objects[1];
+	done = active_menu->focus_objects[2];
+	disabled = lv_obj_get_child(lv_obj_get_parent(checkbox), 2);
+	assert(lv_obj_has_state(disabled, LV_STATE_DISABLED));
+	assert(lv_group_get_focused(session_group) == checkbox);
+	assert(lv_obj_has_state(checkbox, LV_STATE_FOCUSED));
+	assert(lv_obj_has_state(checkbox, LV_STATE_CHECKED));
+	assert(!lv_obj_has_state(checkbox, LV_STATE_FOCUS_KEY));
+	verify_initial_focus(checkbox);
+	verify_focus_move(2U, checkbox, numeric);
+	assert(!strcmp(lv_label_get_text(active_menu->help_label), "Next help"));
+	verify_focus_move(2U, numeric, done); /* Disabled control is skipped. */
+	assert(!lv_obj_has_state(disabled, LV_STATE_FOCUSED));
+	assert(!strcmp(lv_label_get_text(active_menu->help_label), ""));
+	verify_focus_move(1U, done, numeric);
+	verify_focus_move(1U, numeric, checkbox);
+	assert(lv_obj_has_state(checkbox, LV_STATE_CHECKED));
+	assert(!strcmp(lv_label_get_text(active_menu->help_label), "Help"));
+	/* Manual focus still has pointer event provenance, not synthetic key state. */
+	lv_group_focus_obj(done);
+	lv_refr_now(session_display);
+	assert(!lv_obj_has_state(checkbox, LV_STATE_FOCUSED));
+	assert(!lv_obj_has_state(done, LV_STATE_FOCUS_KEY));
+	verify_initial_focus(done);
+	/* Rebuild creates new controls and restores the initial focus indicator. */
+	key_sent = FALSE;
+	assert(ui_protocol.show_form(&ui_protocol, original, &question, &adjustment) ==
+		EFI_SUCCESS && question == 42U);
+	assert(lv_group_get_focused(session_group) == active_menu->focus_objects[0]);
+	verify_initial_focus(active_menu->focus_objects[0]);
+}
