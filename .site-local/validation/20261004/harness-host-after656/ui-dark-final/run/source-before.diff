+static void configure_focus_indicator(lv_obj_t *control)
+{
+	/*
+	 * Native keyboard navigation uses group focus events, not a keypad indev.
+	 * Style the actual focused control without changing input or checked state;
+	 * LVGL's defocus event removes that state on navigation and pointer focus.
+	 */
+	lv_style_selector_t selector = LV_PART_MAIN | LV_STATE_FOCUSED;
+
+	lv_obj_set_style_outline_color(control, lv_color_hex(0x10141c), selector);
+	lv_obj_set_style_outline_opa(control, LV_OPA_COVER, selector);
+	lv_obj_set_style_outline_width(control, 2, selector);
+	lv_obj_set_style_outline_pad(control, 2, selector);
+}
