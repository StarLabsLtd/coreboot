diff --git a/tests/checkpatch_source_ownership_test.sh b/tests/checkpatch_source_ownership_test.sh
new file mode 100755
index 0000000000..2b300f1632
--- /dev/null
+++ b/tests/checkpatch_source_ownership_test.sh
@@ -0,0 +1,72 @@
+#!/bin/sh
+# SPDX-License-Identifier: GPL-2.0-only
+set -eu
+root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
+temporary=$(mktemp -d)
+trap 'rm -rf "$temporary"' EXIT HUP INT TERM
+mkdir -p "$temporary/util/lint" "$temporary/src/lib/tcg_hash/vendor/vboot"
+for path in lint-007-checkpatch helper_functions.sh cdk2-checkpatch-filter.c \
+	checkpatch.pl cdk2-typedefs.checkpatch spelling.txt const_structs.checkpatch; do
+	cp "$root/util/lint/$path" "$temporary/util/lint/$path"
+done
+cp "$root/.checkpatch.conf" "$temporary/.checkpatch.conf"
+cp "$root/src/lib/tcg_hash/PROVENANCE" "$temporary/src/lib/tcg_hash/PROVENANCE"
+for name in 2sha1 2sha256 2sha512; do
+	cp "$root/src/lib/tcg_hash/vendor/vboot/$name.c" \
+		"$temporary/src/lib/tcg_hash/vendor/vboot/$name.c"
+done
+paths='src/lib/tcg_hash/vendor/vboot/2sha1.c src/lib/tcg_hash/vendor/vboot/2sha256.c src/lib/tcg_hash/vendor/vboot/2sha512.c'
+check_imports()
+{
+	(cd "$temporary"; sh util/lint/lint-007-checkpatch "$paths")
+}
+check_imports > "$temporary/positive.log" 2>&1
+test ! -s "$temporary/positive.log"
+printf X >> "$temporary/src/lib/tcg_hash/vendor/vboot/2sha1.c"
+if check_imports > "$temporary/changed.log" 2>&1; then
+	echo 'changed upstream import was excluded' >&2
+	exit 1
+fi
+cp "$root/src/lib/tcg_hash/vendor/vboot/2sha1.c" \
+	"$temporary/src/lib/tcg_hash/vendor/vboot/2sha1.c"
+rm "$temporary/src/lib/tcg_hash/vendor/vboot/2sha256.c"
+if check_imports > "$temporary/missing.log" 2>&1; then
+	echo 'missing upstream import was excluded' >&2
+	exit 1
+fi
+ln -s "$root/src/lib/tcg_hash/vendor/vboot/2sha256.c" \
+	"$temporary/src/lib/tcg_hash/vendor/vboot/2sha256.c"
+if check_imports > "$temporary/symlink.log" 2>&1; then
+	echo 'symlink upstream import was excluded' >&2
+	exit 1
+fi
+rm "$temporary/src/lib/tcg_hash/vendor/vboot/2sha256.c"
+cp "$root/src/lib/tcg_hash/vendor/vboot/2sha256.c" \
+	"$temporary/src/lib/tcg_hash/vendor/vboot/2sha256.c"
+grep '^vboot_2sha1_sha256=' "$root/src/lib/tcg_hash/PROVENANCE" \
+	>> "$temporary/src/lib/tcg_hash/PROVENANCE"
+if check_imports > "$temporary/duplicate.log" 2>&1; then
+	echo 'ambiguous upstream provenance was accepted' >&2
+	exit 1
+fi
+cp "$root/src/lib/tcg_hash/PROVENANCE" "$temporary/src/lib/tcg_hash/PROVENANCE"
+sed 's/^vboot_2sha1_sha256=.*/vboot_2sha1_sha256=forged/' \
+	"$root/src/lib/tcg_hash/PROVENANCE" > "$temporary/src/lib/tcg_hash/PROVENANCE"
+if check_imports > "$temporary/forged.log" 2>&1; then
+	echo 'forged upstream provenance was accepted' >&2
+	exit 1
+fi
+cp "$root/src/lib/tcg_hash/PROVENANCE" "$temporary/src/lib/tcg_hash/PROVENANCE"
+# Near names and local compatibility headers remain ordinary owned source.
+for name in 2sha1-local.c 2sha_private.h; do
+	printf '%s\n' '/* SPDX-License-Identifier: GPL-2.0-only */' '' \
+		'struct owned {' ' int value[1];' '};' \
+		> "$temporary/src/lib/tcg_hash/vendor/vboot/$name"
+	if (cd "$temporary"; sh util/lint/lint-007-checkpatch \
+		"src/lib/tcg_hash/vendor/vboot/$name") > "$temporary/$name.log" 2>&1; then
+		echo 'owned or near-name source was excluded' >&2
+		exit 1
+	fi
+	grep -q 'FLEXIBLE_ARRAY' "$temporary/$name.log"
+done
+echo 'exact upstream ownership pins and owned-source refusals: PASS'
diff --git a/tests/checkpatch_uefi_information_test.c b/tests/checkpatch_uefi_information_test.c
new file mode 100644
index 0000000000..3219c16834
--- /dev/null
+++ b/tests/checkpatch_uefi_information_test.c
@@ -0,0 +1,126 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+#define _POSIX_C_SOURCE 200809L
+#include <assert.h>
+#define main cdk2_checkpatch_filter_main
+#include "../util/lint/cdk2-checkpatch-filter.c"
+#undef main
+
+static void write_source(const char *path, const char *text, size_t length)
+{
+	int descriptor = open(path, O_CREAT | O_TRUNC | O_WRONLY, 0600);
+
+	assert(descriptor >= 0);
+	assert(write(descriptor, text, length) == (ssize_t)length);
+	assert(close(descriptor) == 0);
+}
+
+int main(int argc, char **argv)
+{
+	static const char header[] =
+		"ERROR:FLEXIBLE_ARRAY: Use C99 flexible arrays - see https://docs.kernel.org/process/deprecated.html#zero-length-and-one-element-arrays";
+	static const char *const definitions[] = {
+		"struct efi_file_info {", "struct efi_fs_info {", "struct efi_label_info {",
+	};
+	static const char *const members[] = {
+		"\tCHAR16 file_name[1];", "\tCHAR16 label[1];", "\tCHAR16 label[1];",
+	};
+	char directory[] = "/tmp/cdk2-uefi-information.XXXXXX";
+	char path[PATH_MAX], original_path[PATH_MAX], record[1024], hostile[2048];
+	struct buffer source = {0};
+	size_t index;
+
+	assert(argc == 2);
+	assert(snprintf(original_path, sizeof(original_path),
+		"%s/src/modules/fat/protocol.c", argv[1]) < (int)sizeof(original_path));
+	assert(read_file(original_path, &source) && source.length != 0U);
+	assert(mkdtemp(directory) != NULL);
+	for (index = 0U; index < 3U; index++) {
+		static const char *const suffix[] = {"src", "src/modules", "src/modules/fat"};
+		assert(snprintf(path, sizeof(path), "%s/%s", directory, suffix[index]) <
+			(int)sizeof(path));
+		assert(mkdir(path, 0700) == 0);
+	}
+	assert(snprintf(path, sizeof(path), "%s/src/modules/fat/protocol.c", directory) <
+		(int)sizeof(path));
+	write_source(path, source.data, source.length);
+	for (index = 0U; index < ARRAY_SIZE(definitions); index++) {
+		const char *definition = strstr(source.data, definitions[index]);
+		const char *member;
+		const char *cursor;
+		size_t line = 1U;
+		char *changed;
+
+		assert(definition != NULL);
+		member = strstr(definition, members[index]);
+		assert(member != NULL);
+		for (cursor = source.data; cursor < member; cursor++)
+			if (*cursor == '\n')
+				line++;
+		assert(snprintf(record, sizeof(record),
+			"%s\n#17: FILE: src/modules/fat/protocol.c:%zu:\n+%s\n+};",
+			header, line + 1U, members[index]) < (int)sizeof(record));
+		assert(uefi_information_tail(directory, record, strlen(record)));
+		assert(snprintf(hostile, sizeof(hostile), "%s\nWARNING:OTHER: hostile", record) <
+			(int)sizeof(hostile));
+		assert(!uefi_information_tail(directory, hostile, strlen(hostile)));
+		strcpy(hostile, record);
+		changed = strstr(hostile, "[1]");
+		assert(changed != NULL);
+		changed[1] = '2';
+		assert(!uefi_information_tail(directory, hostile, strlen(hostile)));
+		strcpy(hostile, record);
+		changed = strstr(hostile, "CHAR16");
+		assert(changed != NULL);
+		memcpy(changed, "UINT16", 6U);
+		assert(!uefi_information_tail(directory, hostile, strlen(hostile)));
+		strcpy(hostile, record);
+		changed = strstr(hostile, "protocol.c");
+		assert(changed != NULL);
+		changed[0] = 'x';
+		assert(!uefi_information_tail(directory, hostile, strlen(hostile)));
+		strcpy(hostile, record);
+		hostile[strlen(hostile) - 1U] = ',';
+		assert(!uefi_information_tail(directory, hostile, strlen(hostile)));
+		assert(snprintf(hostile, sizeof(hostile),
+			"%s\n#17: FILE: src/modules/fat/protocol.c:%zu:\n+%s\n+};",
+			header, line, members[index]) < (int)sizeof(hostile));
+		assert(!uefi_information_tail(directory, hostile, strlen(hostile)));
+		changed = strdup(source.data);
+		assert(changed != NULL);
+		changed[(size_t)(definition - source.data) + strlen("struct efi_")] = 'x';
+		write_source(path, changed, source.length);
+		assert(!uefi_information_tail(directory, record, strlen(record)));
+		free(changed);
+		write_source(path, source.data, source.length);
+	}
+	/* An exact block inside a comment is not a wire declaration. */
+	{
+		static const char commented[] =
+			"/*\nstruct efi_label_info {\n\tCHAR16 label[1];\n};\n*/\n";
+		write_source(path, commented, sizeof(commented) - 1U);
+		assert(snprintf(record, sizeof(record),
+			"%s\n#17: FILE: src/modules/fat/protocol.c:4:\n+%s\n+};",
+			header, members[2]) < (int)sizeof(record));
+		assert(!uefi_information_tail(directory, record, strlen(record)));
+	}
+	write_source(path, "", 0U);
+	assert(!uefi_information_tail(directory, record, strlen(record)));
+	write_source(path, "\0", 1U);
+	assert(!uefi_information_tail(directory, record, strlen(record)));
+	assert(unlink(path) == 0);
+	assert(!uefi_information_tail(directory, record, strlen(record)));
+	assert(symlink(original_path, path) == 0);
+	assert(!uefi_information_tail(directory, record, strlen(record)));
+	assert(unlink(path) == 0);
+	for (index = 3U; index > 0U; index--) {
+		static const char *const suffix[] = {"src", "src/modules", "src/modules/fat"};
+		assert(snprintf(path, sizeof(path), "%s/%s", directory, suffix[index - 1U]) <
+			(int)sizeof(path));
+		assert(rmdir(path) == 0);
+	}
+	assert(rmdir(directory) == 0);
+	free(source.data);
+	puts("exact UEFI information tails and hostile records: PASS");
+	return 0;
+}
