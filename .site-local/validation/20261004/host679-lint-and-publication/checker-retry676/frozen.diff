+static bool uefi_information_tail(const char *root, const char *record, size_t length)
+{
+	static const char header[] =
+		"ERROR:FLEXIBLE_ARRAY: Use C99 flexible arrays - see https://docs.kernel.org/process/deprecated.html#zero-length-and-one-element-arrays\n";
+	static const struct {
+		const char *definition;
+		const char *member;
+	} tails[] = {
+		{ "struct efi_file_info {\n"
+		  "\tUINT64 size, file_size, physical_size;\n"
+		  "\tstruct efi_time create, access, modify;\n"
+		  "\tUINT64 attribute;\n\tCHAR16 file_name[1];\n};\n",
+		  "\tCHAR16 file_name[1];" },
+		{ "struct efi_fs_info {\n\tUINT64 size;\n\tBOOLEAN read_only;\n"
+		  "\tUINT8 pad[7];\n\tUINT64 volume_size, free_space;\n"
+		  "\tUINT32 block_size;\n\tCHAR16 label[1];\n};\n",
+		  "\tCHAR16 label[1];" },
+		{ "struct efi_label_info {\n\tCHAR16 label[1];\n};\n",
+		  "\tCHAR16 label[1];" },
+	};
+	struct buffer source = {0};
+	struct stat source_stat;
+	char path[PATH_MAX], expected[512];
+	size_t report_line, source_line, index;
+	int consumed = 0;
+	bool result = false;
+
+	if (length < sizeof(header) - 1U ||
+	    memcmp(record, header, sizeof(header) - 1U) != 0 ||
+	    sscanf(record + sizeof(header) - 1U,
+		"#%zu: FILE: src/modules/fat/protocol.c:%zu:%n",
+		&report_line, &source_line, &consumed) != 2 || consumed == 0)
+		return false;
+	if (snprintf(path, sizeof(path), "%s/src/modules/fat/protocol.c", root) >=
+	    (int)sizeof(path) || lstat(path, &source_stat) != 0 ||
+	    !S_ISREG(source_stat.st_mode) || !read_file(path, &source))
+		return false;
+	if (source.length == 0U || memchr(source.data, '\0', source.length) != NULL)
+		goto done;
+	for (index = 0U; index < ARRAY_SIZE(tails); index++) {
+		const char *definition = strstr(source.data, tails[index].definition);
+		const char *member;
+		const char *cursor;
+		enum { CODE, LINE_COMMENT, BLOCK_COMMENT, STRING, CHARACTER } context = CODE;
+		size_t line = 1U;
+		int written;
+
+		if (definition == NULL || (definition != source.data && definition[-1] != '\n') ||
+		    strstr(definition + 1U, tails[index].definition) != NULL)
+			continue;
+		for (cursor = source.data; cursor < definition; cursor++) {
+			if (context == LINE_COMMENT) {
+				if (*cursor == '\n' && (cursor == source.data || cursor[-1] != '\\'))
+					context = CODE;
+			} else if (context == BLOCK_COMMENT) {
+				if (*cursor == '*' && cursor[1] == '/')
+					context = CODE, cursor++;
+			} else if (context == STRING || context == CHARACTER) {
+				if (*cursor == '\\' && cursor + 1U < definition)
+					cursor++;
+				else if ((context == STRING && *cursor == '"') ||
+					 (context == CHARACTER && *cursor == '\''))
+					context = CODE;
+			} else if (*cursor == '/' && cursor[1] == '/') {
+				context = LINE_COMMENT;
+				cursor++;
+			} else if (*cursor == '/' && cursor[1] == '*') {
+				context = BLOCK_COMMENT;
+				cursor++;
+			} else if (*cursor == '"') {
+				context = STRING;
+			} else if (*cursor == '\'') {
+				context = CHARACTER;
+			}
+		}
+		if (context != CODE)
+			continue;
+		member = strstr(definition, tails[index].member);
+		for (cursor = source.data; cursor < member; cursor++)
+			if (*cursor == '\n')
+				line++;
+		/* Checkpatch reports the closing line of this two-line context. */
+		if (line + 1U != source_line)
+			continue;
+		written = snprintf(expected, sizeof(expected),
+			"%s#%zu: FILE: src/modules/fat/protocol.c:%zu:\n+%s\n+};",
+			header, report_line, source_line, tails[index].member);
+		if (written >= 0 && (size_t)written == length &&
+		    (size_t)written < sizeof(expected) && memcmp(expected, record, length) == 0) {
+			result = true;
+			break;
+		}
+	}
+done:
+	free(source.data);
+	return result;
+}
