diff --git a/tests/software_hash_test.c b/tests/software_hash_test.c
index 205c45a9cc..f707b09fb6 100644
--- a/tests/software_hash_test.c
+++ b/tests/software_hash_test.c
@@ -1,5 +1,6 @@
 /* SPDX-License-Identifier: GPL-2.0-only */
 #include <cdk2/software_hash.h>
+#include <2sha_private.h>
 #include <stdio.h>
 #include <stdint.h>
 #include <stdlib.h>
@@ -55,6 +56,32 @@ int main(void)
 	struct cdk2_software_hash one, split, overflow;
 	struct cdk2_tcg2_span spans[3];
 	uint64_t prior;
+	/* Exercise the owned shim with unaligned input and unsigned high bytes. */
+	for (size_t offset = 0; offset < 4; offset++) {
+		uint8_t bytes[7] = {0};
+		uint32_t output[2] = {0}, *target = output;
+		uint32_t expected = 0;
+
+		for (size_t index = 0; index < 4; index++) {
+			bytes[offset + index] = (uint8_t)(0x80U + index * 0x25U);
+			expected = expected * 256U + bytes[offset + index];
+		}
+		if (offset < 4)
+			PACK32(bytes + offset, target++);
+		else
+			CHECK(0);
+		CHECK(output[0] == expected && output[1] == 0 && target == output + 1);
+		for (unsigned int value = 0; value < 256; value++) {
+			for (size_t index = 0; index < 4; index++) {
+				bytes[offset + index] = (uint8_t)value;
+				PACK32(bytes + offset, output);
+				expected = 0;
+				for (size_t byte = 0; byte < 4; byte++)
+					expected = expected * 256U + bytes[offset + byte];
+				CHECK(output[0] == expected);
+			}
+		}
+	}
 	CHECK(cdk2_software_hash_init(NULL, TPM_ALG_SHA256) == EFI_INVALID_PARAMETER);
 	CHECK(vector(TPM_ALG_SHA1, "", "da39a3ee5e6b4b0d3255bfef95601890afd80709"));
 	CHECK(vector(TPM_ALG_SHA1, "abc", "a9993e364706816aba3e25717850c26c9cd0d89d"));
