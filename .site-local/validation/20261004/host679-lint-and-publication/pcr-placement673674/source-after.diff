diff --git a/tests/tcg2_driver_boot_variable_test.c b/tests/tcg2_driver_boot_variable_test.c
new file mode 100644
index 0000000000..e486c5db42
--- /dev/null
+++ b/tests/tcg2_driver_boot_variable_test.c
@@ -0,0 +1,325 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* Exercise the real driver's private callbacks, not a copied PCR policy. */
+#ifndef CDK2_TCG2_DRIVER_SOURCE
+#define CDK2_TCG2_DRIVER_SOURCE "../src/modules/tcg2/driver.c"
+#endif
+#include CDK2_TCG2_DRIVER_SOURCE
+
+struct variable_fixture {
+	const CHAR16 *name;
+	const EFI_GUID *guid;
+	const void *data;
+	size_t size;
+	bool missing, fail_read;
+};
+
+struct variable_record {
+	CHAR16 name[16];
+	EFI_GUID guid;
+	uint8_t data[16];
+	size_t name_size, data_size;
+	uint32_t pcr, type;
+};
+
+static const CHAR16 option_one[] = u"Boot0001";
+static const CHAR16 option_two[] = u"Boot0002";
+static const CHAR16 option_ten[] = u"Boot000A";
+static uint16_t order_data[] = { 2, 1 };
+static uint16_t current_data = 1, next_data = 10;
+static const uint8_t option_data[] = { 1, 2, 3, 4 };
+static const uint8_t secure_data[] = { 1 };
+static struct variable_fixture variables[11];
+static struct variable_record records[32];
+static size_t record_count, allocation_count, free_count, active_allocations;
+static size_t fail_allocation = SIZE_MAX;
+static uint32_t separator_count, attempts, returning_attempts;
+static EFI_STATUS measurement_status;
+static struct boot_services_view mock_boot;
+static struct runtime_services_view mock_runtime;
+static struct system_table_view mock_system;
+
+static bool same_name(const CHAR16 *left, const CHAR16 *right)
+{
+	while (*left != 0 && *left == *right) {
+		left++;
+		right++;
+	}
+	return *left == *right;
+}
+
+static EFI_STATUS CDK2_MS_ABI get_variable(const CHAR16 *name,
+	const EFI_GUID *guid, UINT32 *attributes, UINTN *size, void *data)
+{
+	(void)attributes;
+	for (size_t index = 0; index < ARRAY_SIZE(variables); index++) {
+		struct variable_fixture *variable = &variables[index];
+
+		if (!same_name(name, variable->name))
+			continue;
+		assert(memcmp(guid, variable->guid, sizeof(*guid)) == 0);
+		if (variable->missing)
+			return EFI_NOT_FOUND;
+		if (data == NULL || *size < variable->size) {
+			*size = variable->size;
+			return EFI_BUFFER_TOO_SMALL;
+		}
+		if (variable->fail_read)
+			return EFI_DEVICE_ERROR;
+		memcpy(data, variable->data, variable->size);
+		*size = variable->size;
+		return EFI_SUCCESS;
+	}
+	return EFI_NOT_FOUND;
+}
+
+static EFI_STATUS CDK2_MS_ABI allocate_pool(EFI_MEMORY_TYPE type,
+	UINTN size, void **data)
+{
+	assert(type == efi_boot_services_data && size <= sizeof(records[0].data));
+	if (allocation_count++ == fail_allocation)
+		return EFI_OUT_OF_RESOURCES;
+	*data = malloc(size);
+	assert(*data != NULL);
+	active_allocations++;
+	return EFI_SUCCESS;
+}
+
+static EFI_STATUS CDK2_MS_ABI free_pool(void *data)
+{
+	assert(data != NULL && active_allocations != 0);
+	free(data);
+	active_allocations--;
+	free_count++;
+	return EFI_SUCCESS;
+}
+
+/* Only the external measurement boundaries are mocked; the driver's variable
+ * reads, allocations, Boot#### construction and callback control flow are real. */
+EFI_STATUS __wrap_cdk2_tcg2_measure_boot_variable(struct cdk2_tcg2_service *owner,
+	TPM_PCRINDEX pcr, UINT32 type, const EFI_GUID *guid,
+	cdk2_const_char16 name, UINT32 name_bytes, const void *data, UINT32 data_size,
+	UINT32 *code)
+{
+	struct variable_record *record;
+
+	assert(owner == &service && record_count < ARRAY_SIZE(records));
+	record = &records[record_count++];
+	assert(name_bytes < sizeof(record->name) && data_size <= sizeof(record->data));
+	memcpy(record->name, name, name_bytes);
+	record->guid = *guid;
+	memcpy(record->data, data, data_size);
+	record->name_size = name_bytes;
+	record->data_size = data_size;
+	record->pcr = pcr;
+	record->type = type;
+	*code = 0;
+	return measurement_status;
+}
+
+EFI_STATUS __wrap_cdk2_tcg2_measure_separator(struct cdk2_tcg2_measurement *owner,
+	TPM_PCRINDEX pcr, UINT32 type, UINT32 value, UINT32 *code)
+{
+	assert(owner == &service.measurement && pcr == separator_count);
+	assert(type == 4 && value == 0 && active_allocations == 0);
+	separator_count++;
+	*code = 0;
+	return measurement_status;
+}
+
+EFI_STATUS __wrap_cdk2_tcg2_boot_attempt(struct cdk2_tcg2_service *owner,
+	BOOLEAN returning, UINT32 *code)
+{
+	assert(owner == &service && separator_count == 8);
+	if (returning)
+		returning_attempts++;
+	else
+		attempts++;
+	*code = 0;
+	return measurement_status;
+}
+
+EFI_STATUS __wrap_cdk2_tcg2_measure_spans(struct cdk2_tcg2_measurement *owner,
+	TPM_PCRINDEX pcr, UINT32 type, const struct cdk2_tcg2_span *spans,
+	UINT32 count, const void *event, UINT32 event_size, UINT32 *code)
+{
+	(void)owner; (void)pcr; (void)type; (void)spans; (void)count;
+	(void)event; (void)event_size; (void)code;
+	/* No SMBIOS table is supplied by this focused variable fixture. */
+	assert(0);
+	return EFI_DEVICE_ERROR;
+}
+
+static void reset_fixture(void)
+{
+	assert(active_allocations == 0);
+	variables[0] = (struct variable_fixture){ boot_order, &global_variable_guid,
+		order_data, sizeof(order_data), false, false };
+	variables[1] = (struct variable_fixture){ boot_current, &global_variable_guid,
+		&current_data, sizeof(current_data), false, false };
+	variables[2] = (struct variable_fixture){ boot_next, &global_variable_guid,
+		&next_data, sizeof(next_data), false, false };
+	variables[3] = (struct variable_fixture){ option_one, &global_variable_guid,
+		option_data, sizeof(option_data), false, false };
+	variables[4] = variables[3]; variables[4].name = option_two;
+	variables[5] = variables[3]; variables[5].name = option_ten;
+	variables[6] = (struct variable_fixture){ secure_boot, &global_variable_guid,
+		secure_data, sizeof(secure_data), false, false };
+	variables[7] = variables[6]; variables[7].name = pk;
+	variables[8] = variables[6]; variables[8].name = kek;
+	variables[9] = variables[6]; variables[9].name = db;
+	variables[9].guid = &image_security_database_guid;
+	variables[10] = variables[9]; variables[10].name = dbx;
+	memset(records, 0, sizeof(records));
+	record_count = allocation_count = free_count = 0;
+	fail_allocation = SIZE_MAX;
+	separator_count = attempts = returning_attempts = 0;
+	measurement_status = EFI_SUCCESS;
+	variables_measured = publication_complete = variable_measurement_pending = FALSE;
+	separators_measured = boot_attempt_started = FALSE;
+	mock_boot.allocate_pool = allocate_pool;
+	mock_boot.free_pool = free_pool;
+	mock_runtime.get_variable = get_variable;
+	boot_services = &mock_boot;
+	runtime_services = &mock_runtime;
+	system_table = &mock_system;
+	current_data = 1;
+}
+
+static void expect_record(size_t index, const CHAR16 *name, uint32_t pcr,
+	uint32_t type, const EFI_GUID *guid, const void *data, size_t size)
+{
+	const struct variable_record *record = &records[index];
+	size_t name_length = 0;
+
+	while (name[name_length] != 0)
+		name_length++;
+	assert(index < record_count && same_name(record->name, name));
+	assert(record->name_size == name_length * sizeof(CHAR16));
+	assert(record->pcr == pcr && record->type == type);
+	assert(memcmp(&record->guid, guid, sizeof(*guid)) == 0);
+	assert(record->data_size == size && memcmp(record->data, data, size) == 0);
+}
+
+static void expect_boot_record(size_t index, const CHAR16 *name,
+	const void *data, size_t size)
+{
+	expect_record(index, name, 1, EV_EFI_VARIABLE_BOOT,
+		&global_variable_guid, data, size);
+}
+
+static void boot_callbacks(void)
+{
+	reset_fixture();
+	ready_to_boot(NULL, NULL);
+	assert(record_count == 5 && separator_count == 8 && attempts == 1);
+	expect_boot_record(0, boot_order, order_data, sizeof(order_data));
+	expect_boot_record(1, boot_current, &current_data, sizeof(current_data));
+	expect_boot_record(2, boot_next, &next_data, sizeof(next_data));
+	expect_boot_record(3, option_two, option_data, sizeof(option_data));
+	expect_boot_record(4, option_one, option_data, sizeof(option_data));
+	assert(allocation_count == free_count && active_allocations == 0);
+	ready_to_boot(NULL, NULL);
+	assert(record_count == 5 && separator_count == 8 && attempts == 1);
+	assert(returning_attempts == 1);
+
+	reset_fixture();
+	current_data = 10;
+	ready_to_boot(NULL, NULL);
+	assert(record_count == 6);
+	expect_boot_record(5, option_ten, option_data, sizeof(option_data));
+	assert(active_allocations == 0);
+
+	reset_fixture();
+	variables[0].missing = true;
+	ready_to_boot(NULL, NULL);
+	assert(record_count == 3 && attempts == 1);
+	expect_boot_record(0, boot_current, &current_data, sizeof(current_data));
+	expect_boot_record(2, option_one, option_data, sizeof(option_data));
+
+	reset_fixture();
+	variables[0].size = sizeof(order_data) - 1;
+	ready_to_boot(NULL, NULL);
+	assert(record_count == 4 && allocation_count == free_count);
+	expect_boot_record(3, option_one, option_data, sizeof(option_data));
+
+	reset_fixture();
+	variables[0].fail_read = true;
+	ready_to_boot(NULL, NULL);
+	assert(record_count == 3 && allocation_count == free_count);
+	expect_boot_record(2, option_one, option_data, sizeof(option_data));
+
+	reset_fixture();
+	for (size_t index = 0; index < 6; index++)
+		variables[index].missing = true;
+	ready_to_boot(NULL, NULL);
+	assert(record_count == 0 && separator_count == 8 && attempts == 1);
+
+	reset_fixture();
+	variables[2].fail_read = true;
+	ready_to_boot(NULL, NULL);
+	assert(record_count == 4 && allocation_count == free_count);
+	expect_boot_record(2, option_two, option_data, sizeof(option_data));
+
+	reset_fixture();
+	fail_allocation = 0;
+	ready_to_boot(NULL, NULL);
+	assert(record_count == 4 && allocation_count == free_count + 1);
+	expect_boot_record(0, boot_current, &current_data, sizeof(current_data));
+
+	reset_fixture();
+	fail_allocation = 3;
+	ready_to_boot(NULL, NULL);
+	assert(record_count == 4 && allocation_count == free_count + 1);
+	expect_boot_record(3, option_one, option_data, sizeof(option_data));
+
+	reset_fixture();
+	measurement_status = EFI_DEVICE_ERROR;
+	ready_to_boot(NULL, NULL);
+	assert(record_count == 5 && separator_count == 8 && attempts == 1);
+	assert(active_allocations == 0);
+
+	reset_fixture();
+	variables[0].size = (uint64_t)UINT32_MAX + 1;
+	measure_variable(boot_order, sizeof(boot_order) - sizeof(*boot_order),
+		&global_variable_guid, 1, EV_EFI_VARIABLE_BOOT);
+	assert(record_count == 0 && allocation_count == 0);
+
+	/* The helper must preserve a caller-specified PCR; policy lives at callers. */
+	reset_fixture();
+	measure_variable(boot_next, sizeof(boot_next) - sizeof(*boot_next),
+		&global_variable_guid, 5, EV_EFI_VARIABLE_BOOT);
+	assert(record_count == 1 && allocation_count == free_count);
+	expect_record(0, boot_next, 5, EV_EFI_VARIABLE_BOOT,
+		&global_variable_guid, &next_data, sizeof(next_data));
+}
+
+static void secure_callbacks(void)
+{
+	reset_fixture();
+	variable_write_ready(NULL, NULL);
+	assert(record_count == 0 && variable_measurement_pending);
+	publication_complete = TRUE;
+	variable_write_ready(NULL, NULL);
+	assert(record_count == 5 && allocation_count == free_count);
+	for (size_t index = 0; index < 5; index++)
+		expect_record(index, variables[6 + index].name, 7,
+			EV_EFI_VARIABLE_DRIVER_CONFIG, variables[6 + index].guid,
+			secure_data, sizeof(secure_data));
+	variable_write_ready(NULL, NULL);
+	assert(record_count == 5 && active_allocations == 0);
+}
+
+int main(void)
+{
+	boot_callbacks();
+	secure_callbacks();
+	puts("TCG2 real-driver boot-variable PCR policy: PASS");
+	return 0;
