diff --git a/tests/native_boundary_style_lint_test.sh b/tests/native_boundary_style_lint_test.sh
index b8e6161cdc..d3cd7e14cf 100755
--- a/tests/native_boundary_style_lint_test.sh
+++ b/tests/native_boundary_style_lint_test.sh
@@ -492,6 +492,140 @@ for scenario in valid excluded hidden nested unresolved shell comma; do
 	test ! -e "$filter_root/forbidden"
 done
 
+# Exact compiler prerequisite filters do not require Make evaluation. Foreign
+# files are ignored by the owned inventory so these checks need the build edge.
+recipe_root=$temporary/recipe-filter
+mkdir -p "$recipe_root/util/lint" "$recipe_root/src" "$recipe_root/outside"
+cp "$root/util/lint/helper_functions.sh" \
+	"$root/util/lint/lint-stable-025-native-boundary" "$recipe_root/util/lint/"
+printf 'build Makefile\n' > "$recipe_root/manifest"
+printf 'int good;\n' > "$recipe_root/src/good.c"
+printf '#include <Library/BaseLib.h>\n' > "$recipe_root/outside/bad.c"
+printf 'outside/\nresult\n' > "$recipe_root/.gitignore"
+for scenario in direct helper actual_helper nested conditional_list conditional_alias \
+    prerequisite helper_argument helper_literal excluded unknown_helper \
+    helper_redefined helper_assigned helper_conditional helper_environment \
+    helper_constructed helper_function unknown_function forged_assignment \
+    forged_prerequisite forged_assignment_continued forged_prerequisite_continued \
+    conditional_cycle conditional_environment conditional_environment_alias \
+    conditional_unknown conditional_transitive conditional_outside \
+    cross_file_define cross_file_continuation dangling_define dangling_recipe; do
+	printf 'build Makefile\n' > "$recipe_root/manifest"
+	{
+		printf 'CC := cc\nBASE := src/good.c\nSOURCES := src/good.c\n'
+		case "$scenario" in
+		helper_conditional) printf 'ifeq ($(MODE),then)\n' ;;
+		esac
+		printf 'define host_test\n'
+		case "$scenario" in
+		actual_helper)
+			awk '
+			 $0 == "define cdk2_native_host_test" { selected = 1; next }
+			 selected && $0 == "endef" { exit }
+			 selected { print }
+			' "$root/src/boot/Makefile"
+			;;
+		helper_constructed) printf '\t$(CC) $(1) outside/$(2)\n' ;;
+		helper_function) printf '\t$(CC) $(1) $(word 1,$(2))\n' ;;
+		helper_literal) printf '\t$(CC) $(1) $(2) outside/bad.c\n' ;;
+		cross_file_define|dangling_define) ;;
+		*) printf '\t$(CC) $(1) $(2)\n' ;;
+		esac
+		case "$scenario" in
+		cross_file_define|dangling_define) ;;
+		*) printf 'endef\n' ;;
+		esac
+		case "$scenario" in
+		helper_redefined) printf 'define host_test\n\t$(CC) $(1) $(2)\nendef\n' ;;
+		helper_assigned) printf 'host_test = $(shell touch forbidden)\n' ;;
+		helper_conditional) printf 'endif\n' ;;
+		esac
+		case "$scenario" in
+		conditional_list|conditional_alias|conditional_cycle|conditional_environment|\
+		conditional_environment_alias|\
+		conditional_unknown|conditional_transitive|conditional_outside)
+			case "$scenario" in
+			conditional_alias) printf 'LIST := $(BASE)\n' ;;
+			conditional_cycle) printf 'LIST = $(ALIAS)\nALIAS = $(LIST)\n' ;;
+			conditional_unknown) printf 'LIST = $(UNKNOWN)/bad.c\n' ;;
+			conditional_environment_alias) printf 'ALIAS := src/good.c\nLIST = $(ALIAS)\n' ;;
+			conditional_transitive) printf 'ifeq ($(MODE),then)\nALIAS := outside/bad.c\nelse\nALIAS := src/good.o\nendif\nLIST = $(ALIAS)\n' ;;
+			conditional_outside) printf 'LIST := outside/bad.c\n' ;;
+			*) printf 'LIST := src/good.c\n' ;;
+			esac
+			printf 'ifeq ($(MODE),then)\nSOURCES += $(LIST)\nendif\n'
+			;;
+		forged_assignment) printf 'SOURCES := $(filter %%.c,$^)\n' ;;
+		forged_assignment_continued)
+			printf 'SOURCES := \\\n\t$(filter %%.c,$^)\n' ;;
+		esac
+		case "$scenario" in
+		prerequisite) printf 'all: outside/bad.c\n' ;;
+		forged_prerequisite) printf 'all: $(filter %%.c,$^)\n' ;;
+		forged_prerequisite_continued)
+			printf 'all: \\\n\t$(filter %%.c,$^)\n' ;;
+		*) printf 'all: $(SOURCES)\n' ;;
+		esac
+		case "$scenario" in
+		direct|prerequisite|forged_*|conditional_*)
+			printf '\t@$(CC) $(filter %%.c,$^) -o "$@"\n' ;;
+		nested|excluded)
+			printf '\t$(call host_test,-O2,\\\n'
+			if [ "$scenario" = excluded ]; then exclusion=outside/bad.c
+			else exclusion=src/good.c; fi
+			printf '\t  $(filter-out %s,$(filter %%.c,$^)))\n' "$exclusion"
+			;;
+		helper_argument) printf '\t$(call host_test,outside/bad.c,$(filter %%.c,$^))\n' ;;
+		unknown_helper) printf '\t$(call missing,-O2,$(filter %%.c,$^))\n' ;;
+		unknown_function) printf '\t@$(CC) $(word 1,$(filter %%.c,$^))\n' ;;
+		cross_file_continuation|dangling_recipe)
+			printf '\t$(call host_test,-O2,\\\n' ;;
+		*) printf '\t$(call host_test,-O2,$(filter %%.c,$^))\n' ;;
+		esac
+	} > "$recipe_root/Makefile"
+	case "$scenario" in
+	cross_file_define)
+		printf 'build fragment.mk\n' >> "$recipe_root/manifest"
+		printf '\t$(CC) $(1) $(2)\nendef\nall:\n\t$(call host_test,-O2,$(filter %%.c,$^))\n' > "$recipe_root/fragment.mk"
+		;;
+	cross_file_continuation)
+		printf 'build fragment.mk\n' >> "$recipe_root/manifest"
+		printf '\t$(filter %%.c,$^))\n' > "$recipe_root/fragment.mk"
+		;;
+	*) printf '\n' > "$recipe_root/fragment.mk" ;;
+	esac
+	git -C "$recipe_root" init -q
+	git -C "$recipe_root" add .
+	case "$scenario" in
+	helper_environment) control='host_test=$(shell touch forbidden)' ;;
+		conditional_environment) control='LIST=outside/bad.c' ;;
+	conditional_environment_alias) control='ALIAS=outside/bad.c' ;;
+	*) control= ;;
+	esac
+	(cd "$recipe_root" && if [ -n "$control" ]; then
+		env "$control" CDK2_NATIVE_INPUT_MANIFEST=manifest \
+			util/lint/lint-stable-025-native-boundary
+	else
+		CDK2_NATIVE_INPUT_MANIFEST=manifest \
+			util/lint/lint-stable-025-native-boundary
+	fi) > "$recipe_root/result"
+	case "$scenario" in
+	direct|helper|actual_helper|nested|conditional_list|conditional_alias)
+		if [ -s "$recipe_root/result" ]; then
+			cat "$recipe_root/result"
+			exit 1
+		fi ;;
+	prerequisite|helper_argument|helper_literal|excluded|conditional_outside)
+		grep -q 'EDK-style include path.*outside/bad.c' "$recipe_root/result" ;;
+	conditional_cycle|conditional_environment|conditional_environment_alias|\
+	conditional_unknown|conditional_transitive)
+		grep -q 'Invalid build source reference.*__CDK2_CONDITIONAL_UNSUPPORTED__' \
+			"$recipe_root/result" ;;
+	*) grep -q 'Invalid build source reference' "$recipe_root/result" ;;
+	esac
+	test ! -e "$recipe_root/forbidden"
+done
+
 hostile_root=$temporary/hostile-include
 mkdir -p "$hostile_root/util/lint" "$hostile_root/outside/Bad"
 cp "$root/util/lint/helper_functions.sh" "$hostile_root/util/lint/"
