+		guid_hob->header = (EFI_HOB_GENERIC_HEADER) {
+			.hob_type = EFI_HOB_TYPE_GUID_EXTENSION,
+			.hob_length = sizeof(*guid_hob) + payload_size,
+		};
+		guid_hob->name = board_guid;
+		if (payload_size >= sizeof(*record))
+			record->rtc = (struct cdk2_acpi_rtc_info) {
+				.header = { CDK2_ACPI_RTC_INFO_REVISION, 0, sizeof(record->rtc) },
+				.flags = CDK2_ACPI_RTC_STATUS_KNOWN | CDK2_ACPI_RTC_CENTURY_KNOWN,
+				.century_index = TEST_CENTURY,
+			};
+		if (first == NULL)
+			first = record;
+		cursor += guid_hob->header.hob_length;
+	}
+	EFI_HOB_GENERIC_HEADER *end = (void *)cursor;
+
+	*end = (EFI_HOB_GENERIC_HEADER) {
+		.hob_type = EFI_HOB_TYPE_END_OF_HOB_LIST, .hob_length = sizeof(*end),
+	};
+	*handoff = (EFI_HOB_HANDOFF_INFO_TABLE) {
+		.header = { .hob_type = EFI_HOB_TYPE_HANDOFF, .hob_length = sizeof(*handoff) },
+		.version = EFI_HOB_HANDOFF_TABLE_VERSION,
+		.efi_memory_bottom = (UINTN)hob_storage,
+		.efi_memory_top = (UINTN)hob_storage + sizeof(hob_storage),
+		.efi_free_memory_bottom = (UINTN)(end + 1),
+		.efi_free_memory_top = (UINTN)hob_storage + sizeof(hob_storage),
+		.efi_end_of_hob_list = (UINTN)end,
+	};
+	return first;
+}
 
