diff --git a/docs/rtc-platform-facts.md b/docs/rtc-platform-facts.md
new file mode 100644
index 0000000000..31a541c005
--- /dev/null
+++ b/docs/rtc-platform-facts.md
@@ -0,0 +1,31 @@
+# PC/AT RTC platform facts
+
+The existing ACPI board-info GUID HOB retains its original `ACPI_BOARD_INFO`
+prefix and appends a native revision 1 RTC tail. Legacy reset/metronome consumers
+still accept their unchanged minimum prefix. RTC requires a unique canonical HOB
+list and exact current payload/tail extents before diagnostic setup, events,
+divider I/O, runtime hooks or protocol publication. Missing/old unextended data
+is not permission to assume a century register; malformed or duplicate data is
+rejected. Unknown tail revisions and unknown modern RTC availability are refused.
+
+The coreboot adapter derives the tail from its already checksum-validated unique
+FADT. Century has its own advertised field extent: zero or an unavailable field
+permits no century write. A declared nonzero index must fit the supported first
+CMOS bank and must not alias standard clock/control/alarm registers 0x00-0x0d.
+There is no fixed 0x32 fallback. Revision 5-or-newer FADT with a complete
+`ia_pc_boot_arch` field makes bit 5 NO_CMOS authoritative and prevents RTC entry
+before any activity. Modern truncated availability remains unknown.
+
+Valid pre-v5 FADT retains the previously selected PC/AT route through an explicit
+legacy-compatibility flag. Bit 5 was reserved there and is not interpreted as a
+modern NO_CMOS declaration. This compatibility policy does not discover a new
+RTC device or add an ACPI control-method time implementation.
+
+RTC copies only the admitted century scalar into runtime-owned storage, not an
+ACPI/HOB pointer. GetTime retains the existing 1970-2069 pivot and does not read
+century; SetTime retains the same year horizon and only writes a declared index.
+Alarm, timezone, locking, CRC and failure rollback policies are unchanged. HOST
+models are not proof of physical CMOS ownership or an actual guest/platform run.
+
+The field meanings follow the [ACPI FADT specification](https://uefi.org/specs/ACPI/6.6/05_ACPI_Software_Programming_Model.html),
+sections 5.2.9 and 5.2.9.3. This slice does not claim complete RTC/platform parity.
diff --git a/include/cdk2/acpi_board_info.h b/include/cdk2/acpi_board_info.h
new file mode 100644
index 0000000000..60d5a2aa2e
--- /dev/null
+++ b/include/cdk2/acpi_board_info.h
@@ -0,0 +1,111 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+#ifndef CDK2_ACPI_BOARD_INFO_H
+#define CDK2_ACPI_BOARD_INFO_H
+
+#include <cdk2/hob.h>
+#include <cdk2/hob_payload.h>
+#include <guid/acpi_board_info.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#define CDK2_ACPI_BOARD_INFO_HOB_GUID \
+	{ 0x0ad3d31b, 0xb3d8, 0x4506, { 0xae, 0x71, 0x2e, 0xf1, 0x10, 0x06, 0xd9, 0x0f } }
+
+#define CDK2_ACPI_RTC_INFO_REVISION 1U
+#define CDK2_ACPI_RTC_LEGACY_PC_AT BIT0
+#define CDK2_ACPI_RTC_STATUS_KNOWN BIT1
+#define CDK2_ACPI_RTC_NO_CMOS BIT2
+#define CDK2_ACPI_RTC_CENTURY_KNOWN BIT3
+#define CDK2_ACPI_RTC_FLAGS_MASK 0x0fU
+
+/* Native append-only tail: the original board-info wire prefix is unchanged. */
+struct cdk2_acpi_rtc_info {
+	CDK2_HOB_PAYLOAD_HEADER header;
+	uint8_t flags;
+	uint8_t century_index;
+	uint8_t reserved[2];
+};
+
+struct cdk2_acpi_board_info_hob {
+	ACPI_BOARD_INFO board_info;
+	struct cdk2_acpi_rtc_info rtc;
+};
+
+_Static_assert(sizeof(struct cdk2_acpi_rtc_info) == 8, "RTC tail wire size");
+_Static_assert(offsetof(struct cdk2_acpi_board_info_hob, rtc) == sizeof(ACPI_BOARD_INFO),
+	"legacy ACPI board-info prefix");
+_Static_assert(sizeof(struct cdk2_acpi_board_info_hob) ==
+	sizeof(ACPI_BOARD_INFO) + sizeof(struct cdk2_acpi_rtc_info), "board-info tail extent");
+
+static inline bool cdk2_acpi_board_info_guid_equal(const EFI_GUID *left,
+	const EFI_GUID *right)
+{
+	for (size_t index = 0; index < sizeof(*left); index++)
+		if (((const uint8_t *)left)[index] != ((const uint8_t *)right)[index])
+			return false;
+	return true;
+}
+
+static inline EFI_STATUS cdk2_acpi_rtc_info_from_hobs(const void *hob_list,
+	uint8_t *century_index)
+{
+	const EFI_GUID board_guid = CDK2_ACPI_BOARD_INFO_HOB_GUID;
+	const EFI_HOB_HANDOFF_INFO_TABLE *handoff = hob_list;
+	const EFI_HOB_GENERIC_HEADER *hob;
+	const struct cdk2_acpi_board_info_hob *record = NULL;
+	const struct cdk2_acpi_rtc_info *rtc;
+	size_t size = 0;
+	uint8_t availability;
+	EFI_STATUS status;
+
+	if (century_index == NULL)
+		return EFI_INVALID_PARAMETER;
+	if (hob_list == NULL)
+		return EFI_NOT_FOUND;
+	status = cdk2_hob_list_validate(hob_list);
+	if (EFI_ERROR(status))
+		return status;
+	for (hob = hob_list; (UINTN)hob < handoff->efi_end_of_hob_list;
+	     hob = (const void *)((const uint8_t *)hob + hob->hob_length)) {
+		const EFI_HOB_GUID_TYPE *guid_hob = (const void *)hob;
+
+		if (hob->hob_type != EFI_HOB_TYPE_GUID_EXTENSION)
+			continue;
+		if (hob->hob_length < sizeof(*guid_hob))
+			return EFI_COMPROMISED_DATA;
+		if (!cdk2_acpi_board_info_guid_equal(&guid_hob->name, &board_guid))
+			continue;
+		if (record != NULL)
+			return EFI_COMPROMISED_DATA;
+		record = (const void *)(guid_hob + 1);
+		size = hob->hob_length - sizeof(*guid_hob);
+	}
+	if (record == NULL)
+		return EFI_NOT_FOUND;
+	if (size == sizeof(ACPI_BOARD_INFO))
+		return EFI_UNSUPPORTED;
+	if (size != sizeof(*record))
+		return EFI_COMPROMISED_DATA;
+	rtc = &record->rtc;
+	if (rtc->header.revision != CDK2_ACPI_RTC_INFO_REVISION)
+		return EFI_UNSUPPORTED;
+	if (rtc->header.reserved || rtc->header.length != sizeof(*rtc) ||
+	    rtc->reserved[0] || rtc->reserved[1] ||
+	    (rtc->flags & ~CDK2_ACPI_RTC_FLAGS_MASK) ||
+	    (!(rtc->flags & CDK2_ACPI_RTC_CENTURY_KNOWN) && rtc->century_index) ||
+	    (rtc->century_index && (rtc->century_index <= 0x0dU || rtc->century_index >= 0x80U)))
+		return EFI_COMPROMISED_DATA;
+	availability = rtc->flags & (CDK2_ACPI_RTC_LEGACY_PC_AT | CDK2_ACPI_RTC_STATUS_KNOWN);
+	if (availability == (CDK2_ACPI_RTC_LEGACY_PC_AT | CDK2_ACPI_RTC_STATUS_KNOWN) ||
+	    ((rtc->flags & CDK2_ACPI_RTC_NO_CMOS) &&
+	     availability != CDK2_ACPI_RTC_STATUS_KNOWN))
+		return EFI_COMPROMISED_DATA;
+	if (!availability || (rtc->flags & CDK2_ACPI_RTC_NO_CMOS))
+		return EFI_UNSUPPORTED;
+	*century_index = rtc->century_index;
+	return EFI_SUCCESS;
+}
+
+#endif
