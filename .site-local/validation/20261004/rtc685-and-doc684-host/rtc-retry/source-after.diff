 #include <cdk2/capsule_delivery_policy.h>
 #include <cdk2/diagnostic.h>
 #include <cdk2/dma_handoff.h>
@@ -2595,6 +2596,133 @@ static void build_test_acpi_tables(EFI_ACPI_3_0_ROOT_SYSTEM_DESCRIPTION_POINTER
 	test_update_rsdp_checksums(rsdp);
 }
 
+static int test_rtc_board_handoff(void)
+{
+	static const struct {
+		uint8_t revision, century;
+		uint16_t boot_arch;
+		size_t length;
+		EFI_STATUS expected;
+	} cases[] = {
+		{ 1, 0, BIT5, sizeof(EFI_ACPI_3_0_FIXED_ACPI_DESCRIPTION_TABLE), EFI_SUCCESS },
+		{ 3, 0x32, BIT5, sizeof(EFI_ACPI_3_0_FIXED_ACPI_DESCRIPTION_TABLE), EFI_SUCCESS },
+		{ 3, 0x37, 0, sizeof(EFI_ACPI_3_0_FIXED_ACPI_DESCRIPTION_TABLE), EFI_SUCCESS },
+		{ 3, 0x80, BIT5, offsetof(EFI_ACPI_3_0_FIXED_ACPI_DESCRIPTION_TABLE, century),
+			EFI_SUCCESS },
+		{ 5, 0, 0, sizeof(EFI_ACPI_3_0_FIXED_ACPI_DESCRIPTION_TABLE), EFI_SUCCESS },
+		{ 6, 0x32, 0, sizeof(EFI_ACPI_3_0_FIXED_ACPI_DESCRIPTION_TABLE), EFI_SUCCESS },
+		{ 6, 0x37, 0, sizeof(EFI_ACPI_3_0_FIXED_ACPI_DESCRIPTION_TABLE), EFI_SUCCESS },
+		{ 5, 0x32, BIT5, sizeof(EFI_ACPI_3_0_FIXED_ACPI_DESCRIPTION_TABLE), EFI_UNSUPPORTED },
+		{ 5, 0x32, BIT5, offsetof(EFI_ACPI_3_0_FIXED_ACPI_DESCRIPTION_TABLE, ia_pc_boot_arch) + 1,
+			EFI_UNSUPPORTED },
+		{ 6, 0x0d, 0, sizeof(EFI_ACPI_3_0_FIXED_ACPI_DESCRIPTION_TABLE), EFI_COMPROMISED_DATA },
+		{ 6, 0x80, 0, sizeof(EFI_ACPI_3_0_FIXED_ACPI_DESCRIPTION_TABLE), EFI_COMPROMISED_DATA },
+	};
+	EFI_ACPI_3_0_ROOT_SYSTEM_DESCRIPTION_POINTER rsdp;
+	struct test_acpi_root xsdt;
+	EFI_ACPI_3_0_FIXED_ACPI_DESCRIPTION_TABLE fadt, alternate;
+	struct test_mcfg_table mcfg;
+	uint8_t table[sizeof(struct cb_header) + sizeof(struct cb_acpi_rsdp)];
+	uint64_t hobs[1024];
+	struct cb_acpi_rsdp *record = (void *)(table + sizeof(struct cb_header));
+	struct cdk2_coreboot_handoff handoff;
+	EFI_HOB_HANDOFF_INFO_TABLE *hob_list;
+	EFI_STATUS status;
+	int failures = 0;
+
+	for (size_t index = 0; index < ARRAY_SIZE(cases) + 2; index++) {
+		uint8_t century = 0xee;
+		bool checksum_case = index == ARRAY_SIZE(cases);
+		bool duplicate_case = index == ARRAY_SIZE(cases) + 1;
+
+		build_test_acpi_tables(&rsdp, &xsdt, &fadt, &mcfg);
+		if (index < ARRAY_SIZE(cases)) {
+			fadt.header.revision = cases[index].revision;
+			fadt.header.length = cases[index].length;
+			fadt.century = cases[index].century;
+			fadt.ia_pc_boot_arch = cases[index].boot_arch;
+		}
+		test_update_acpi_table_checksum(&fadt.header);
+		if (checksum_case)
+			fadt.header.checksum ^= 1;
+		if (duplicate_case) {
+			alternate = fadt;
+			xsdt.entries[1] = (UINTN)&alternate;
+			test_update_acpi_table_checksum(&xsdt.header);
+		}
+		memset(table, 0, sizeof(table));
+		*record = (struct cb_acpi_rsdp) {
+			.tag = CB_TAG_ACPI_RSDP, .size = sizeof(*record),
+			.rsdp_pointer = { .lo = (uint32_t)(uintptr_t)&rsdp,
+				.hi = (uint32_t)((uint64_t)(uintptr_t)&rsdp >> 32) },
+		};
+		size_t table_size = finalize_table(table, sizeof(table), sizeof(*record), 1);
+
+		status = cdk2_coreboot_parse_table(table, table_size, &handoff);
+		if (!EFI_ERROR(status))
+			status = cdk2_coreboot_build_hobs(&handoff, hobs, (uint8_t *)hobs + sizeof(hobs),
+				hobs, (uint8_t *)hobs + sizeof(hobs), FALSE, (void **)&hob_list);
+		if (!EFI_ERROR(status))
+			status = cdk2_coreboot_test_append_acpi_hobs(hob_list, &handoff);
+		if (checksum_case || duplicate_case) {
+			failures += expect(status == EFI_COMPROMISED_DATA,
+				"invalid FADT produced an RTC platform contract");
+			continue;
+		}
+		failures += expect(status == EFI_SUCCESS,
+			"validated ACPI set failed real board-info HOB production");
+		if (EFI_ERROR(status))
+			continue;
