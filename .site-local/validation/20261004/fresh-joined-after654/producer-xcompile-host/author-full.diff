 class FreshAdmissionTest(unittest.TestCase):
+    def test_actual_five_invocations_require_owned_toolchain_preparation(self):
+        recipe = (repo / "util/qemu/bin/build-normal-fwui-fresh.sh").read_text()
+        preparation = '"${outer[@]}" "$stage/initial9/build/xcompile"'
+        self.assertEqual(recipe.count(preparation), 2)
+        actual_preparation = recipe.index(preparation, recipe.index('"${outer[@]}" olddefconfig >'))
+        self.assertLess(actual_preparation, recipe.index('" producer-tools "$stage"'))
+        self.assertLess(recipe.index('" producer-tools "$stage"'), recipe.index('"${outer[@]}" all >'))
+        for mutation in (None, "absent-preparation", "copied-old-xcompile", "all-before-capture", "environment"):
+            with self.subTest(mutation=mutation), tempfile.TemporaryDirectory() as name:
+                stage = Path(name)
+                firmware, producer = stage / "firmware", stage / "producer"
+                (stage / "initial9").mkdir()
+                clean = ["env", "-i", "PATH=" + fresh.BUILD_PATH, "TMPDIR=/home/sean",
+                         "LANG=C", "LC_ALL=C", "make", "-C"]
+                common = clean + [str(firmware), "-j2", "CDK2_BUILD_DIR=" + str(stage),
+                    "CDK2_CONFIG=" + str(stage / "resolved.config"), "COREBOOT_TREE=" + str(producer),
+                    "COREBOOT_CONFIG=" + str(stage / "producer-input.config"),
+                    "CDK2_BEARSSL_DIR=/home/sean/Documents/cdk2/3rdparty/bearssl",
+                    "CDK2_LVGL_ROOT=/home/sean/Documents/cdk2/3rdparty/lvgl", "CC=cc", "HOSTCC=cc"]
+                outer = clean + [str(producer), "-j2", "UPDATED_SUBMODULES=1",
+                    "obj=" + str(stage / "initial9/build"), "DOTCONFIG=" + str(stage / "initial9/full.config"),
+                    "VBOOT_SOURCE=" + str(fresh.VBOOT), "HOSTCC=gcc", "HOSTCXX=g++"]
+                commands = {"configure.argv.json": common + ["olddefconfig"],
+                    "core.argv.json": common + ["native-coreboot-image", "native-lvgl-renderer-test"],
+                    "initial9/configure.argv.json": outer + ["olddefconfig"],
+                    "initial9/toolchain.argv.json": outer + [str(stage / "initial9/build/xcompile")],
+                    "initial9/build.argv.json": outer + ["all"]}
+                if mutation == "copied-old-xcompile":
+                    commands["initial9/toolchain.argv.json"][-1] = str(stage / "old-worktree/xcompile")
+                elif mutation == "all-before-capture":
+                    commands["initial9/toolchain.argv.json"][-1] = "all"
+                elif mutation == "environment":
+                    commands["initial9/toolchain.argv.json"].insert(-1, "HOSTCC=foreign-cc")
+                for filename, argv in commands.items():
+                    if mutation != "absent-preparation" or filename != "initial9/toolchain.argv.json":
+                        (stage / filename).write_text(json.dumps(argv) + "\n")
+                if mutation is None:
+                    self.assertEqual(fresh.invocation_receipts(stage, firmware, producer),
+                                     [stage / filename for filename in commands])
+                else:
+                    with self.assertRaises((ValueError, FileNotFoundError)):
+                        fresh.invocation_receipts(stage, firmware, producer)
+
