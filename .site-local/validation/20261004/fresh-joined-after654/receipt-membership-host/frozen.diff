+    def test_receipt_duplicate_membership_is_linear_for_unique_rows(self):
+        # Structural HOST model: hashes are explicitly stubbed; this is not
+        # an artifact admission or a timing claim about the real build.
+        class CountedPath(type(Path())):
+            comparisons = 0
+            __hash__ = Path.__hash__
+
+            def __eq__(self, other):
+                CountedPath.comparisons += 1
+                return super().__eq__(other)
+
+        with tempfile.TemporaryDirectory() as temporary:
+            root = Path(temporary)
+            receipt = root / "before.sha256"
+            names = ["source-" + str(index) for index in range(2048)]
+            receipt.write_text("".join("0" * 64 + "  " + name + "\n" for name in names))
+            with patch.object(runner, "Path", CountedPath), \
+                    patch.object(runner, "sha", return_value="0" * 64) as hashing:
+                admitted = runner.verify_hash_receipt(receipt, root)
+            comparisons = CountedPath.comparisons
+            self.assertLessEqual(comparisons, len(names) * 4)
+            self.assertEqual([str(path) for path in admitted], [str(root / name) for name in names])
+            self.assertEqual(hashing.call_count, len(names))
+
