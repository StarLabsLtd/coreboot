#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only

set -eu
repo=/home/sean/Documents/.cdk2-worktrees/roadmap-checkpoint-20260930
work=$(mktemp -d "${TMPDIR:-/tmp}/cdk2-profile-cli.XXXXXX")
trap 'rm -rf -- "$work"' EXIT HUP INT TERM
sandbox="$work/root"
mkdir -p "$sandbox/util" "$sandbox/review-profile"
cp -R "$repo/util/review_profile" "$sandbox/util/"
cp -R "$repo/review-profile/coreboot" "$sandbox/review-profile/"
sources="$sandbox/review-profile/coreboot/sources.json"
jq -r '.imports[]|select(has("local_path"))|.local_path' "$sources" > "$work/imports"
while IFS= read -r path; do
	mkdir -p "$sandbox/$(dirname "$path")"
	cp "$repo/$path" "$sandbox/$path"
done < "$work/imports"
script="$sandbox/util/review_profile/coreboot-review-profile"
config="$work/config.json"; cache="$work/cache"; output="$work/output"
cat > "$config" <<'EOF'
{"boilerplate_patterns":["thanks[.! ]*"],"categories":[{"id":"hardware","patterns":["\\bbar\\b"],"title":"Hardware"}],"excerpt_characters":80,"gerrit_url":"https://review.example.invalid","minimum_category_support":1,"minimum_comment_characters":10,"minimum_observation_share":0,"minimum_reply_characters":30,"request_delay_seconds":0,"request_retries":2,"retry_base_seconds":0,"reviewers":[{"account_id":7,"id":"reviewer","name":"Reviewer"}],"snapshot_cutoff":"2026-08-25T00:00:00Z","target_comments":1}
EOF

mkdir "$work/bin"
cat > "$work/bin/curl" <<'EOF'
#!/bin/sh
headers= output=
while [ "$#" -gt 0 ]; do
	case $1 in -D) headers=$2;shift 2;;-o) output=$2;shift 2;;-w) shift 2;;*) shift;;esac
done
url=$(sed -n 's/^url = "\(.*\)"$/\1/p')
count=0; [ ! -f "$CLI_CURL_COUNT" ] || count=$(cat "$CLI_CURL_COUNT")
printf '%s\n' $((count+1)) > "$CLI_CURL_COUNT"
case $url in
*/comments)
	response='{"src/pci.c":[{"author":{"_account_id":7},"commit_id":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","id":"abcd_1234","line":9,"message":"Please validate this BAR carefully before using the resource.","patch_set":2,"unresolved":true,"updated":"2026-01-01T00:00:00Z"}]}' ;;
*/changes/*)
	response='[{"_number":1,"branch":"main","change_id":"I1111111111111111111111111111111111111111","id":"coreboot~1","owner":{"_account_id":8},"subject":"subject"}]' ;;
*) printf 'unexpected URL: %s\n' "$url" >&2; exit 2 ;;
esac
printf ")]}'\n%s\n" "$response" > "$output"
: > "$headers"
printf 200
EOF
chmod +x "$work/bin/curl"

cli()
{
	PATH="$work/bin:$PATH" CLI_CURL_COUNT="$work/curl-count" "$script" "$@" \
		--config "$config" --cache "$cache" --output "$output"
}

# Update cannot self-authorize a new source preimage or publish a partial set.
pin_before=$(sha256sum "$sources" | awk '{print $1}')
if cli update > "$work/update.out" 2> "$work/update.err"; then
	printf '%s\n' 'update authorized a changed source pin' >&2; exit 1
fi
grep 'fetched source preimages differ' "$work/update.err" >/dev/null
[ "$pin_before" = "$(sha256sum "$sources" | awk '{print $1}')" ]
[ ! -e "$output/manifest.json" ]

# Explicit acceptance creates a new output directory, commits the pin, and
# finishes by verifying the exact emitted snapshot.
rm -f "$work/curl-count"
if ! cli accept-source-pin > "$work/accept.out" 2> "$work/accept.err"; then
	cat "$work/accept.err" >&2; exit 1
fi
grep 'coreboot review profile verified' "$work/accept.out" >/dev/null
[ -f "$output/manifest.json" ]
[ "$(jq -r .evidence_count "$output/manifest.json")" -eq 1 ]
[ "$(jq -r .review_source_records_sha256 "$sources")" = \
	"$(sha256sum "$output/source-records.jsonl" | awk '{print $1}')" ]
cli verify > "$work/verify.out"
grep 'coreboot review profile verified' "$work/verify.out" >/dev/null

# A normal update consumes its cached first pass and performs only the forced
# live stability traversal; refresh forces both traversals live.
rm -f "$work/curl-count"; cli update >/dev/null
[ "$(cat "$work/curl-count")" -eq 2 ]
rm -f "$work/curl-count"; cli update --refresh >/dev/null
[ "$(cat "$work/curl-count")" -eq 4 ]

# Duplicate account IDs fail configuration validation before curl or output.
jq '.reviewers += [{"account_id":7,"id":"relabelled","name":"Relabelled"}]' \
	"$config" > "$work/colliding-config.json"
rm -f "$work/curl-count"
if PATH="$work/bin:$PATH" CLI_CURL_COUNT="$work/curl-count" "$script" update \
	--config "$work/colliding-config.json" --cache "$work/collision-cache" \
	--output "$work/collision-output" >/dev/null 2> "$work/collision.err"; then
	printf '%s\n' 'CLI accepted duplicate account IDs' >&2; exit 1
fi
grep 'configuration schema is invalid' "$work/collision.err" >/dev/null
[ ! -e "$work/curl-count" ] && [ ! -e "$work/collision-output" ]

# Manifest, evidence, checkpoint, source, and pinned-field mutations fail
# closed through the actual verifier.
for file in manifest.json evidence.jsonl checkpoint.jsonl source-records.jsonl; do
	cp "$output/$file" "$work/$file.good"
	if [ "$file" = manifest.json ]; then
		jq '.evidence_sha256=("0"*64)' "$output/$file" > "$work/$file.bad"
		mv "$work/$file.bad" "$output/$file"
	else
		printf '\n' >> "$output/$file"
	fi
	if cli verify >/dev/null 2>&1; then exit 1; fi
	mv "$work/$file.good" "$output/$file"
done
cp "$output/manifest.json" "$work/manifest.good"
for mutation in '.target += 1' '.format_revision=0' '.gerrit_url="https://evil.invalid"'; do
	jq "$mutation" "$work/manifest.good" > "$output/manifest.json"
	if cli verify >/dev/null 2>&1; then exit 1; fi
done
cp "$work/manifest.good" "$output/manifest.json"
cli verify >/dev/null

cp -R "$output" "$work/semantic-good"
restore_output()
{
	rm -rf "$output"
	cp -R "$work/semantic-good" "$output"
}
rehash_manifest()
{
	field=$1 file=$2
	digest=$(sha256sum "$output/$file" | awk '{print $1}')
	jq --arg field "$field" --arg digest "$digest" '.[$field]=$digest' \
		"$output/manifest.json" > "$work/manifest.rehashed"
	mv "$work/manifest.rehashed" "$output/manifest.json"
}

# Rehashed semantic mutations still fail: the verifier does not rely only on
# top-level file digests.
jq -cS 'if has("checkpoint") then .checkpoint.pagination={} else . end' \
	"$output/checkpoint.jsonl" > "$work/checkpoint.bad"
mv "$work/checkpoint.bad" "$output/checkpoint.jsonl"
rehash_manifest checkpoint_sha256 checkpoint.jsonl
if cli verify >/dev/null 2>&1; then exit 1; fi
restore_output

sed '1d' "$output/checkpoint.jsonl" > "$work/checkpoint.bad"
mv "$work/checkpoint.bad" "$output/checkpoint.jsonl"
rehash_manifest checkpoint_sha256 checkpoint.jsonl
if cli verify >/dev/null 2>&1; then exit 1; fi
restore_output

jq -cS 'if has("checkpoint") then
	.checkpoint.pagination[].pages[0].response_sha256=("0"*64) else . end' \
	"$output/checkpoint.jsonl" > "$work/checkpoint.bad"
mv "$work/checkpoint.bad" "$output/checkpoint.jsonl"
rehash_manifest checkpoint_sha256 checkpoint.jsonl
if cli verify >/dev/null 2>&1; then exit 1; fi
restore_output

printf '\nFabricated observation.\n' >> "$output/observations.md"
rehash_manifest observations_sha256 observations.md
if cli verify >/dev/null 2>&1; then exit 1; fi
restore_output

jq -cS '.excerpt="fabricated but rehashed"' "$output/evidence.jsonl" > "$work/evidence.bad"
mv "$work/evidence.bad" "$output/evidence.jsonl"
rehash_manifest evidence_sha256 evidence.jsonl
if cli verify >/dev/null 2>&1; then exit 1; fi
restore_output

# Coordinate every derived representation of a fabricated evidence body while
# deliberately retaining the original selected-source preimage and binding.
jq -cS '.excerpt="fabricated evidence body"|.tags=[]' \
	"$output/evidence.jsonl" > "$work/evidence.canonical"
awk '{ out=""; string=0; escape=0; for(i=1;i<=length($0);i++) {
	character=substr($0,i,1); out=out character;
	if(string) { if(escape) escape=0; else if(character=="\\") escape=1;
		else if(character=="\"") string=0 }
	else if(character=="\"") string=1;
	else if(character=="," || character==":") out=out " " } print out }' \
	< "$work/evidence.canonical" > "$output/evidence.jsonl"
fabricated=$(jq -c . "$output/evidence.jsonl")
jq -cS --argjson fabricated "$fabricated" '
	if has("selected_source") then .selected_source.published=$fabricated else . end' \
	"$output/checkpoint.jsonl" > "$work/checkpoint.fabricated"
mv "$work/checkpoint.fabricated" "$output/checkpoint.jsonl"
REPO="$sandbox" TEST_CONFIG="$config" /bin/sh -c '
	config=$TEST_CONFIG
	. "$REPO/util/review_profile/coreboot-review-profile-emit.sh"
	profile_build_observations "$1" "$2"' sh "$work/evidence.canonical" \
	"$output/observations.md"
jq '.category_counts={}' "$output/manifest.json" > "$work/manifest.fabricated"
mv "$work/manifest.fabricated" "$output/manifest.json"
rehash_manifest evidence_sha256 evidence.jsonl
rehash_manifest checkpoint_sha256 checkpoint.jsonl
rehash_manifest observations_sha256 observations.md
if cli verify > "$work/causal.out" 2> "$work/causal.err"; then exit 1; fi
grep 'causally bound to source preimages' "$work/causal.err" >/dev/null
restore_output

jq -cS '.source.comment.message_sha256=("0"*64)' \
	"$output/source-records.jsonl" > "$work/source.bad"
mv "$work/source.bad" "$output/source-records.jsonl"
rehash_manifest source_records_sha256 source-records.jsonl
if cli verify > "$work/source-tamper.out" 2> "$work/source-tamper.err"; then exit 1; fi
grep 'trusted snapshot' "$work/source-tamper.err" >/dev/null
restore_output

legacy='project:coreboot reviewer:7 before:2026-08-25'
legacy_route='/changes/?q=project%3Acoreboot%20reviewer%3A7%20before%3A2026-08-25&n=100&S=0&o=DETAILED_ACCOUNTS'
queries=$(jq -cnS --arg query "$legacy" '{"7":$query}')
query_sha=$(printf '%s' "$queries" | jq -cjS . | sha256sum | awk '{print $1}')
jq --argjson queries "$queries" --arg sha "$query_sha" \
	'.queries=$queries|.query_sha256=$sha' "$output/manifest.json" > "$work/manifest.legacy"
mv "$work/manifest.legacy" "$output/manifest.json"
jq -cS --arg query "$legacy" --arg route "$legacy_route" --arg sha "$query_sha" '
	if has("checkpoint") then
		.checkpoint.queries={"7":$query}|.checkpoint.query_sha256=$sha|
		.checkpoint.pagination={($query):(.checkpoint.pagination[] |
			.pages[0].route=$route)}
	elif ((.response.route? // "")|startswith("/changes/?")) then .response.route=$route
	else . end' "$output/checkpoint.jsonl" > "$work/checkpoint.legacy"
mv "$work/checkpoint.legacy" "$output/checkpoint.jsonl"
rehash_manifest checkpoint_sha256 checkpoint.jsonl
if cli verify >/dev/null 2>&1; then exit 1; fi
restore_output

profile_make()
{
	MAKEFLAGS= MFLAGS= MAKEOVERRIDES= make "$@"
}

profile_make -C "$work" -f "$repo/Makefile" -n review-profile review-profile-check \
	review-profile-update review-profile-test > "$work/make-paths"
grep "$repo/util/review_profile/coreboot-review-profile" "$work/make-paths" >/dev/null
grep "$repo/tests/review-profile-test" "$work/make-paths" >/dev/null
profile_make -C "$repo" -f "$repo/Makefile" -pn review-profile \
	> "$work/make-database" 2>/dev/null
grep '^\.DEFAULT_GOAL := all$' "$work/make-database" >/dev/null

# Diagnostic Make calls must not inherit the invoking production build or its
# touch mode. The fixture has no payload configuration in this relative path.
(
	export CDK2_CONFIG_READY=1
	export CDK2_BUILD_DIR=build/review-profile-missing-config
	export MAKEFLAGS='t -- CDK2_CONFIG_READY=1'
	MAKEFLAGS="$MAKEFLAGS CDK2_BUILD_DIR=build/review-profile-missing-config"
	export MFLAGS=-t
	export MAKEOVERRIDES='CDK2_CONFIG_READY=1 CDK2_BUILD_DIR=build/review-profile-missing-config'
	profile_make -C "$work" -f "$repo/Makefile" -n review-profile-test \
		> "$work/inherited-make-paths"
	grep "$repo/tests/review-profile-test" "$work/inherited-make-paths" >/dev/null
	[ ! -e "$work/build/review-profile-missing-config/.config" ]
)

printf '%s\n' 'review profile CLI tests passed'
